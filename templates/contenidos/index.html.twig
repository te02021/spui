{% extends '@SPUI/base.html.twig' %}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% block title %}Contenidos — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 spui-header-actions">
    <div>
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Contenidos</h1>
        <p class="text-muted mb-0">
            Imágenes, videos, textos y cronogramas.
            <span class="text-muted small">
                <strong>Borrador</strong> = no disponible &nbsp;·&nbsp;
                <strong>Publicado</strong> = listo para usar en playlists &nbsp;·&nbsp;
                <strong>Archivado</strong> = retirado
            </span>
        </p>
    </div>
    <button type="button" class="unraf-btn spui-btn-crear"
            data-spui-form="{{ path('spui_cms_contenidos_new') }}"
            data-spui-title="Nuevo contenido"
            data-spui-size="modal-lg">
        + Nuevo contenido
    </button>
</div>

<div id="spui-table-body">
<div class="unraf-card">
    <div class="unraf-table-responsive">
        <table class="unraf-table unraf-table-striped w-100 spui-tabla-cards">
            <thead>
                <tr>
                    <th class="p-3">Título</th>
                    <th class="p-3">Tipo</th>
                    <th class="p-3">Duración</th>
                    <th class="p-3">Estado</th>
                    <th class="p-3">Creado</th>
                    <th class="p-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for c in contenidos %}
                {# Resuelto una vez por fila: la cadena contenido → playlist →
                   programación → pantalla → reproductor es cara de recorrer. #}
                {% set motivo = spui_alcance.motivoParaEntidad(c, ids_offline|default({})) %}
                <tr>
                    <td class="p-3" data-label="Título">
                        <strong>{{ c.titulo }}</strong>
                        {% if c.contenidoTexto %}
                            <br><small class="text-muted">{{ c.contenidoTexto|slice(0,60) }}{% if c.contenidoTexto|length > 60 %}…{% endif %}</small>
                        {% endif %}
                    </td>
                    <td class="p-3" data-label="Tipo">
                        {% if c.tipo.value == 'imagen' %}
                            <span class="unraf-badge-info">Imagen</span>
                        {% elseif c.tipo.value == 'video' %}
                            <span class="unraf-badge-azul">Video</span>
                        {% elseif c.tipo.value == 'cronograma' %}
                            <span class="unraf-badge-turquesa">Cronograma</span>
                        {% elseif c.tipo.value == 'youtube' %}
                            <span class="unraf-badge-azul">Youtube</span>
                        {% elseif c.tipo.value == 'qr' %}
                            <span class="unraf-badge-info">QR</span>
                        {% else %}
                            <span class="unraf-badge-turquesa">{{ c.tipo.value }}</span>
                        {% endif %}
                    </td>
                    <td class="p-3" data-label="Duración">{{ c.duracionSegundos ? c.duracionSegundos ~ 's' : '∞ Permanente' }}</td>
                    <td class="p-3" data-label="Estado"><span class="spui-badge-{{ c.estado.value }}">{{ c.estado.value|capitalize }}</span></td>
                    <td class="p-3" data-label="Creado"><small>{{ c.creadoEn|date('d/m/Y') }}</small></td>
                    <td class="p-3" data-label="Acciones">
                        <div class="spui-acciones">

                            <button type="button" class="unraf-btn spui-btn-ver unraf-btn-sm"
                                    data-spui-form="{{ path('spui_cms_contenidos_ver', {id: c.id}) }}"
                                    data-spui-title="{{ c.titulo }}"
                                    title="Ver detalle">
                                <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt=""> Ver
                            </button>

                            <button type="button" class="unraf-btn spui-btn-editar unraf-btn-sm"
                                    data-spui-form="{{ path('spui_cms_contenidos_editar', {id: c.id}) }}"
                                    data-spui-title="Editar: {{ c.titulo }}"
                                    title="Editar">
                                <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt=""> Editar
                            </button>

                            {% if c.tipo.value == 'cronograma' %}
                                <a href="{{ path('spui_cms_cronograma_builder', {id: c.id}) }}"
                                   class="unraf-btn spui-btn-items unraf-btn-sm"
                                   title="Editor de ítems del cronograma">
                                    <img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" class="spui-action-icon" alt=""> Ítems
                                </a>
                            {% endif %}

                            {% if c.estado.value != 'publicado' %}
                                <button type="button" class="unraf-btn spui-btn-publicar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                        data-spui-action="{{ path('spui_cms_contenidos_publicar', {id: c.id}) }}"
                                        data-spui-title="Publicar contenido"
                                        data-spui-confirm-label="Publicar"
                                        data-spui-message="¿Publicar «{{ c.titulo }}»? Quedará disponible para playlists."
                                        data-spui-variant="publicar"
                                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Publicar"{% endif %}>
                                    <img src="{{ asset('unraf-ui/icons/check-circle.svg') }}" class="spui-action-icon" alt=""> Publicar
                                </button>
                            {% endif %}

                            {% if c.estado.value == 'publicado' %}
                                <button type="button" class="unraf-btn spui-btn-despublicar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                        data-spui-action="{{ path('spui_cms_contenidos_despublicar', {id: c.id}) }}"
                                        data-spui-title="Volver a borrador"
                                        data-spui-confirm-label="Volver a borrador"
                                        data-spui-message="¿Despublicar «{{ c.titulo }}»? Dejará de aparecer al armar playlists."
                                        data-spui-variant="despublicar"
                                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Volver a borrador"{% endif %}>
                                    <img src="{{ asset('unraf-ui/icons/arrow-u-left-up.svg') }}" class="spui-action-icon" alt=""> Despublicar
                                </button>
                            {% endif %}

                            {% if c.estado.value != 'archivado' %}
                                <button type="button" class="unraf-btn spui-btn-archivar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                        data-spui-action="{{ path('spui_cms_contenidos_archivar', {id: c.id}) }}"
                                        data-spui-title="Archivar contenido"
                                        data-spui-confirm-label="Archivar"
                                        data-spui-message="¿Archivar «{{ c.titulo }}»? Dejará de estar disponible en playlists."
                                        data-spui-variant="archivar"
                                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Archivar"{% endif %}>
                                    <img src="{{ asset('unraf-ui/icons/box-arrow-down.svg') }}" class="spui-action-icon" alt=""> Archivar
                                </button>
                            {% endif %}

                            <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-sm"
                                    data-spui-action="{{ path('spui_cms_contenidos_eliminar', {id: c.id}) }}"
                                    data-spui-title="Eliminar contenido"
                                    data-spui-message="¿Eliminar «{{ c.titulo }}»? Esta acción no se puede deshacer."
                                    data-spui-variant="eliminar"
                                    title="Eliminar">
                                <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
                            </button>

                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="p-4 text-center text-muted">No hay contenidos.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
</div>
{% endblock %}
