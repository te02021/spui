{# Edición de un contenido (rediseñado el 05/11/2026, mismo diseño que el alta).

   El tipo NO se puede cambiar (un cronograma no se convierte en video), pero sí se edita lo
   que ese tipo tiene cargado. El bloque por tipo lo resuelve el server, no
   content-type-fields.js: como el tipo es inmutable alcanza con emitir el que corresponde. #}
{% import '@SPUI/_macros/form.html.twig' as f %}
<form method="post" class="spui-form" action="{{ path('spui_cms_contenidos_editar', {id: contenido.id}) }}"
      data-spui-ajax="1" enctype="multipart/form-data" novalidate>

    <input type="hidden" name="_token" value="{{ csrf_token('spui_action') }}">

    {# Errores por campo (name → mensaje): cada uno va debajo de su input. #}
    {% set err = errores|default({}) %}

    <section class="spui-ver-seccion" aria-labelledby="spui-form-datos">
        <h5 class="spui-ver-titulo" id="spui-form-datos">Datos</h5>
        <div class="spui-ver-bloque">
            <div class="spui-form-fila spui-form-fila-principal">
                <div>
                    <label class="unraf-form-label" for="ed_titulo">Título</label>
                    <input type="text" id="ed_titulo" name="titulo" class="unraf-form-control{{ err.titulo is defined ? ' is-invalid' }}"
                           value="{{ contenido.titulo }}" maxlength="200" required>
                    {% if err.titulo is defined %}<p class="spui-campo-error">{{ err.titulo }}</p>{% endif %}
                </div>
                <div>
                    {# El tipo no se cambia después de crear: se muestra fijo. #}
                    <span class="unraf-form-label d-block">Tipo</span>
                    <div class="unraf-form-control spui-form-fijo">{{ contenido.tipo.etiqueta }}</div>
                </div>
                <div>
                    {% if contenido.esVideo or contenido.esCronograma %}
                        <span class="unraf-form-label d-block">Duración</span>
                        <div class="unraf-form-control spui-form-fijo">{{ contenido.etiquetaDuracion }}</div>
                        {% if contenido.esVideo %}
                            <small class="spui-form-ayuda">La del archivo: la playlist muestra el video completo. Si lo reemplazás, se vuelve a leer.</small>
                        {% else %}
                            <small class="spui-form-ayuda">Depende de cuántas actividades queden en el día.</small>
                        {% endif %}
                    {% else %}
                        <label class="unraf-form-label" for="ed_duracion">Duración (segundos)</label>
                        <input type="number" id="ed_duracion" name="duracion_segundos" class="unraf-form-control"
                               value="{{ contenido.duracionSegundos ?? '' }}" min="1" max="3600" placeholder="Permanente">
                        <small class="spui-form-ayuda">{{ include('@SPUI/contenidos/_ayuda_duracion.html.twig') }}</small>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {# ── Lo que carga cada tipo ── #}
    <section class="spui-ver-seccion" aria-labelledby="spui-form-contenido">
        <h5 class="spui-ver-titulo" id="spui-form-contenido">Contenido</h5>
        <div class="spui-ver-bloque">
            {% if contenido.tipo.value == 'texto' %}
                <label class="unraf-form-label" for="ed_texto">Texto a mostrar</label>
                <textarea id="ed_texto" name="contenido_texto" class="unraf-form-control{{ err.contenido_texto is defined ? ' is-invalid' }}" rows="3"
                          placeholder="Texto que se muestra en pantalla" required>{{ contenido.contenidoTexto }}</textarea>
                {% if err.contenido_texto is defined %}<p class="spui-campo-error">{{ err.contenido_texto }}</p>{% endif %}

            {% elseif contenido.tipo.value == 'qr' %}
                {% set qr = contenido.codigoQr %}
                <div class="spui-form-fila spui-form-fila-dato">
                    <div>
                        <label class="unraf-form-label" for="ed_qr_url">Enlace de destino</label>
                        <textarea id="ed_qr_url" name="qr_url_destino" rows="2" class="unraf-form-control spui-qr-destinos{{ err.qr_url_destino is defined ? ' is-invalid' }}"
                                  maxlength="1001" placeholder="https://…" spellcheck="false" autocomplete="off" required>{{ qr_url_destino is defined and qr_url_destino is not null ? qr_url_destino : (qr ? qr.destinosTexto : '') }}</textarea>
                        {% if err.qr_url_destino is defined %}<p class="spui-campo-error">{{ err.qr_url_destino }}</p>{% endif %}
                        <small class="spui-form-ayuda" data-spui-qr-app-ayuda>¿Es una app? Pegá los enlaces de Google Play y del App Store, uno por renglón: cada teléfono va a su tienda.</small>
                        <small class="spui-form-ayuda">Cambiarlo no invalida los códigos ya impresos ni el que está en pantalla.</small>
                    </div>
                    <div class="spui-fecha-field">
                        <label class="unraf-form-label" for="ed_qr_expira">Vence el (opcional)</label>
                        <input type="datetime-local" id="ed_qr_expira" name="qr_expira_en" class="unraf-form-control{{ err.qr_expira_en is defined ? ' is-invalid' }}"
                               value="{{ qr and qr.expiraEn ? qr.expiraEn|date('Y-m-d\\TH:i') : '' }}">
                        {% if err.qr_expira_en is defined %}<p class="spui-campo-error">{{ err.qr_expira_en }}</p>{% endif %}
                        <small class="spui-form-ayuda">Después de esa fecha el código deja de redirigir.</small>
                    </div>
                </div>
                {% if qr and contenido.rutaArchivo %}
                    {# data-spui-archivo-field engancha la regla que centra el ícono dentro del botón (style.css, .spui-archivo-row). #}
                    <div class="spui-form-separado" data-spui-archivo-field>
                        <span class="unraf-form-label d-block">Imagen del código</span>
                        <div class="spui-archivo-row">
                            <span class="spui-archivo-nombre">{{ contenido.rutaArchivo|split('/')|last }}</span>
                            <a href="#" class="unraf-btn spui-btn-back unraf-btn-icon" title="Vista previa"
                               data-spui-preview-url="{{ path('spui_cms_contenidos_archivo_preview', {id: contenido.id}) }}"
                               data-spui-preview-pantalla-url="{{ path('spui_cms_contenidos_pantalla', {id: contenido.id}) }}"
                               data-spui-preview-tipo="qr"
                               data-spui-preview-nombre="{{ contenido.rutaArchivo|split('/')|last }}">
                                <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt="Vista previa">
                            </a>
                        </div>
                        <small class="spui-form-ayuda">
                            Escaneado {{ qr.usosCount }} {{ qr.usosCount == 1 ? 'vez' : 'veces' }}.
                            {% if not qr.estaVigente %}<span class="text-danger">Vencido: quien lo escanee ve un aviso de no disponible.</span>{% endif %}
                        </small>
                    </div>
                {% endif %}

            {% elseif contenido.tipo.value in ['imagen', 'video'] %}
                {# data-spui-campo: los errores del archivo (del servidor y de validacion-vivo.js) van al final. #}
                {% set fmt = constant('SPUI\\Service\\MediaStorageService::FORMATOS')[contenido.tipo.value] %}
                <div data-spui-archivo-field data-spui-campo>
                    <span class="unraf-form-label d-block">Archivo</span>
                    {# Fila del archivo actual o del recién elegido sin guardar (contenido-archivo-field.js). #}
                    <div class="spui-archivo-row" data-spui-archivo-row{{ contenido.rutaArchivo ? '' : ' hidden' }}>
                        {% if contenido.tipo.value == 'imagen' %}
                            <img alt="" class="spui-media-preview" data-spui-archivo-thumb
                                 {% if contenido.rutaArchivo %}src="{{ path('spui_cms_contenidos_archivo_preview', {id: contenido.id}) }}"{% endif %}
                                 onerror="this.style.display='none'">
                        {% endif %}
                        <span class="spui-archivo-nombre" data-spui-archivo-nombre>{{ contenido.rutaArchivo ? contenido.rutaArchivo|split('/')|last : '' }}</span>
                        <a href="#" class="unraf-btn spui-btn-back unraf-btn-icon" title="Vista previa"
                           data-spui-archivo-preview-btn
                           data-spui-preview-nombre="{{ contenido.rutaArchivo ? contenido.rutaArchivo|split('/')|last : '' }}"
                           data-spui-preview-pantalla-url="{{ path('spui_cms_contenidos_pantalla', {id: contenido.id}) }}"
                           data-spui-preview-tipo="{{ contenido.tipo.value }}"
                           {% if contenido.rutaArchivo %}data-spui-preview-url="{{ path('spui_cms_contenidos_archivo_preview', {id: contenido.id}) }}"{% endif %}>
                            <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt="Vista previa">
                        </a>
                        <label class="unraf-btn spui-btn-back spui-file-trigger spui-form-archivo-btn"
                               title="{{ contenido.rutaArchivo ? 'Reemplazar archivo' : 'Elegir archivo' }}">
                            <img src="{{ asset('unraf-ui/icons/upload-simple.svg') }}" class="spui-action-icon" alt="">
                            {{ contenido.rutaArchivo ? 'Reemplazar' : 'Elegir archivo' }}
                            <input type="file" id="ed_archivo" name="archivo" data-spui-archivo-input
                                   accept="{{ fmt.accept }}"
                                   data-spui-formatos="{{ fmt.extensiones }}" data-spui-formatos-texto="{{ fmt.texto }}"
                                   {% if contenido.tipo.value == 'video' %}data-spui-video-max="{{ constant('SPUI\\Service\\VideoInspectorService::LADO_MAYOR_MAXIMO') }}x{{ constant('SPUI\\Service\\VideoInspectorService::LADO_MENOR_MAXIMO') }}"{% endif %}
                                   {% if max_bytes_archivo is defined %}data-spui-max-bytes="{{ max_bytes_archivo }}"{% endif %}>
                        </label>
                    </div>
                    <small class="spui-form-ayuda">{{ contenido.tipo.value == 'imagen' ? 'Imágenes' : 'Videos' }}: {{ fmt.texto }}. Sin elegir otro, se conserva el actual.</small>
                    {% if err.archivo is defined %}<p class="spui-campo-error">{{ err.archivo }}</p>{% endif %}
                </div>

            {% elseif contenido.tipo.value == 'cronograma' %}
                <div class="spui-form-accion">
                    <p class="spui-ver-texto">Las actividades se cargan en el listado de ítems. Lo que no hayas guardado acá se pierde al pasar a los ítems.</p>
                    {# data-spui-abrir: reemplaza este modal por el listado de ítems (modal.js). #}
                    <button type="button" class="unraf-btn spui-btn-items unraf-btn-sm"
                            data-spui-abrir="{{ path('spui_cms_cronograma_items', {id: contenido.id}) }}"
                            data-spui-title="Ítems de «{{ contenido.titulo }}»"
                            data-spui-size="modal-lg">
                        <img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" class="spui-action-icon" alt=""> Ver ítems
                    </button>
                </div>
            {% endif %}
        </div>
    </section>

    <div class="spui-form-grupo">
        {{ include('@SPUI/contenidos/_presentacion.html.twig', {pv: presentacion, err: err, edificios: edificios, tipo_fijo: contenido.tipo.value, vista_id: contenido.id}) }}
    </div>

    {{ f.pie('spui-btn-editar') }}
</form>
