{% extends '@SPUI/base.html.twig' %}
{% block title %}Nuevo contenido — SPUI{% endblock %}

{% block body %}
<div class="row justify-content-center">
<div class="col-lg-9">

<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nuevo contenido</h1>
    <a href="{{ path('spui_cms_contenidos_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="unraf-card p-4">
{{ form_start(form) }}

    <div class="mb-3">
        {{ form_label(form.titulo) }}
        {{ form_widget(form.titulo) }}
        {% for error in form.titulo.vars.errors %}
            <p class="text-danger small mt-1">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div class="mb-3">
        {{ form_label(form.tipo) }}
        {{ form_widget(form.tipo) }}
        {% for error in form.tipo.vars.errors %}
            <p class="text-danger small mt-1">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div class="mb-3">
        {{ form_label(form.duracionSegundos) }}
        {{ form_widget(form.duracionSegundos) }}
        <small class="text-muted d-block mt-1">Puede sobreescribirse por ítem en la playlist.</small>
    </div>

    {# Campo archivo — visible para imagen/video #}
    <div id="campoArchivo" class="mb-3" style="display:none">
        <label class="unraf-form-label">Archivo <span class="text-danger">*</span></label>
        <input type="file" name="archivo" id="archivoInput" class="form-control" accept="image/*,video/*">
        <small class="text-muted">Imágenes: JPG, PNG, GIF, WebP. Video: MP4, WebM.</small>
    </div>

    {# Campo texto — visible para texto/youtube/qr #}
    <div id="campoTexto" class="mb-3" style="display:none">
        <label class="unraf-form-label" id="labelTexto">Texto <span class="text-danger">*</span></label>
        <textarea name="contenido_texto" id="textareaTexto" class="unraf-form-control" rows="4" placeholder="Ingresá el texto a mostrar..."></textarea>
    </div>

    <div class="d-flex gap-2 justify-content-end mt-4">
        <a href="{{ path('spui_cms_contenidos_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
        <button type="submit" class="unraf-btn unraf-btn-institucion">Guardar contenido</button>
    </div>

{{ form_end(form) }}
</div>

</div>
</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
(function () {
    var tipoSelect   = document.getElementById('tipoSelect');
    var campoArchivo = document.getElementById('campoArchivo');
    var campoTexto   = document.getElementById('campoTexto');
    var labelTexto   = document.getElementById('labelTexto');
    var textarea     = document.getElementById('textareaTexto');
    var archivoInput = document.getElementById('archivoInput');

    if (!tipoSelect) return;

    function actualizarCampos() {
        var tipo      = tipoSelect.value;
        var esArchivo = tipo === 'imagen' || tipo === 'video';
        var esTexto   = tipo === 'texto' || tipo === 'youtube' || tipo === 'qr';

        if (campoArchivo) campoArchivo.style.display = esArchivo ? '' : 'none';
        if (campoTexto)   campoTexto.style.display   = esTexto  ? '' : 'none';
        if (archivoInput) archivoInput.required       = esArchivo;
        if (textarea)     textarea.required            = esTexto;

        if (labelTexto) {
            labelTexto.childNodes[0].textContent =
                tipo === 'youtube' ? 'URL de YouTube ' :
                tipo === 'qr'      ? 'URL para el QR ' : 'Texto a mostrar ';
        }
        if (textarea) {
            textarea.placeholder =
                tipo === 'youtube' ? 'https://www.youtube.com/watch?v=...' :
                tipo === 'qr'      ? 'https://...' :
                                     'Ingresá el texto a mostrar...';
        }
    }

    tipoSelect.addEventListener('change', actualizarCampos);
    actualizarCampos();
}());
</script>
{% endblock %}
