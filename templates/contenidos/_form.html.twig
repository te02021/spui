{# Alta de un contenido (rediseñado el 05/11/2026). La edición (_edit_form) comparte la
   parte de presentación, pero es otro archivo: sus campos viajan con otros nombres.
   content-type-fields.js muestra lo que corresponde a cada tipo. #}
{% import '@SPUI/_macros/form.html.twig' as f %}
{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data', 'class': 'spui-form'}}) }}

{# Archivo, texto y los datos del código QR no son campos del FormType, así que
   sus errores llegan en `errores` (name del campo → mensaje) y se muestran
   debajo de cada uno, no por form.vars.errors. #}
{% set err = errores|default({}) %}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba en blanco de errores y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-0">{{ e.message }}</div>
{% endfor %}

<section class="spui-ver-seccion" aria-labelledby="spui-form-datos">
    <h5 class="spui-ver-titulo" id="spui-form-datos">Datos</h5>
    <div class="spui-ver-bloque">
        {# El tipo se elige con botones; el <select> real sigue siendo el que viaja y el que mira el resto del script. #}
        <div data-spui-campo>
            <span class="unraf-form-label d-block" id="spui-form-tipo-lbl">Tipo</span>
            <div class="spui-opciones" role="radiogroup" aria-labelledby="spui-form-tipo-lbl">
                {% for op in form.tipo.vars.choices %}
                    <input type="radio" class="spui-opcion-input" name="spui_tipo_opcion" id="spui_tipo_{{ op.value }}"
                           value="{{ op.value }}" data-spui-tipo-opcion {{ form.tipo.vars.value == op.value ? 'checked' }}>
                    <label class="spui-opcion" for="spui_tipo_{{ op.value }}">{{ op.label }}</label>
                {% endfor %}
            </div>
            {{ form_widget(form.tipo, {'attr': {'class': 'spui-select-nativo', 'tabindex': '-1', 'aria-hidden': 'true', 'data-spui-tipo-contenido': '1'}}) }}
            {% for e in form.tipo.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
        </div>
        <div class="spui-form-separado spui-form-fila spui-form-fila-dato">
            <div>{{ f.campo(form.titulo) }}</div>
            <div>
                {# content-type-fields.js oculta el campo en un video o un cronograma, y muestra de dónde sale. #}
                <div id="campoDuracion">
                    {{ f.campo(form.duracionSegundos) }}
                    <small class="spui-form-ayuda">{{ include('@SPUI/contenidos/_ayuda_duracion.html.twig') }}</small>
                </div>
                <div id="notaDuracionVideo" hidden>
                    <span class="unraf-form-label d-block">Duración</span>
                    <div class="unraf-form-control spui-form-fijo">La del archivo</div>
                    <small class="spui-form-ayuda">La lee el CMS al guardar, y la playlist muestra el video completo.</small>
                </div>
                <div id="notaDuracionCronograma" hidden>
                    <span class="unraf-form-label d-block">Duración</span>
                    <div class="unraf-form-control spui-form-fijo">Según sus páginas</div>
                    <small class="spui-form-ayuda">Depende de cuántas actividades queden en el día.</small>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-contenido" data-spui-solo-tipos="texto imagen video qr cronograma" hidden>
    <h5 class="spui-ver-titulo" id="spui-form-contenido">Contenido</h5>
    <div class="spui-ver-bloque">
        {# data-spui-campo: los errores del archivo (del servidor y de validacion-vivo.js) van al final de este bloque. #}
        <div id="campoArchivo" hidden data-spui-campo>
            <span class="unraf-form-label d-block">Archivo</span>
            {# Formatos según el tipo: content-type-fields.js toma de data-spui-formatos-por-tipo el
               accept, las extensiones que valida validacion-vivo.js y el texto de ayuda. #}
            <label class="spui-archivo-zona" data-spui-archivo-zona>
                <input type="file" name="archivo" id="archivoInput" class="{{ err.archivo is defined ? 'is-invalid' }}"
                       data-spui-formatos-por-tipo="{{ constant('SPUI\\Service\\MediaStorageService::FORMATOS')|json_encode }}"
                       data-spui-video-max="{{ constant('SPUI\\Service\\VideoInspectorService::LADO_MAYOR_MAXIMO') }}x{{ constant('SPUI\\Service\\VideoInspectorService::LADO_MENOR_MAXIMO') }}"
                       {% if max_bytes_archivo is defined %}data-spui-max-bytes="{{ max_bytes_archivo }}"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/upload-simple.svg') }}" alt="">
                <strong data-spui-zona-nombre>Elegí un archivo</strong>
                <small id="archivoAyuda"></small>
            </label>
            {% if err.archivo is defined %}<p class="spui-campo-error">{{ err.archivo }}</p>{% endif %}
        </div>

        <div id="campoTexto" hidden>
            <label class="unraf-form-label" id="labelTexto" for="textareaTexto">Texto a mostrar</label>
            <textarea name="contenido_texto" id="textareaTexto" class="unraf-form-control{{ err.contenido_texto is defined ? ' is-invalid' }}" rows="3" placeholder="Ingresá el texto">{{ contenido_texto|default('') }}</textarea>
            {% if err.contenido_texto is defined %}<p class="spui-campo-error">{{ err.contenido_texto }}</p>{% endif %}
        </div>

        <div id="campoCronograma" class="spui-form-accion" hidden>
            <p class="spui-ver-texto">Al guardar se abre el listado de ítems, donde se cargan los horarios, las materias y los eventos.</p>
            {# Importar vive acá: sólo tiene sentido para un cronograma. Abre el asistente en esta misma ventana. #}
            <button type="button" class="unraf-btn spui-btn-back unraf-btn-sm"
                    data-spui-abrir="{{ path('spui_cms_contenidos_importar') }}"
                    data-spui-title="Importar cronograma" data-spui-size="modal-lg"
                    title="Cargar los horarios desde el Excel">
                <img src="{{ asset('unraf-ui/icons/file-arrow-up.svg') }}" class="spui-action-icon" alt=""> Importar desde Excel
            </button>
        </div>

        {# El código QR se carga acá mismo. La etiqueta del código la toma del título del contenido. #}
        <div id="campoQr" class="spui-form-fila spui-form-fila-dato" hidden>
            <div>
                <label class="unraf-form-label" for="qrUrlDestino">Enlace de destino</label>
                {{ include('@SPUI/contenidos/_qr_destinos.html.twig', {id: 'qrUrlDestino', destinos: qr_destinos|default([]), err: err}) }}
                <small class="spui-form-ayuda">Se puede cambiar después sin reimprimir el código.</small>
            </div>
            <div class="spui-fecha-field">
                <label class="unraf-form-label" for="qrExpiraEn">Vence el (opcional)</label>
                <input type="datetime-local" name="qr_expira_en" id="qrExpiraEn" class="unraf-form-control{{ err.qr_expira_en is defined ? ' is-invalid' }}" value="{{ qr_expira_en|default('') }}">
                {% if err.qr_expira_en is defined %}<p class="spui-campo-error">{{ err.qr_expira_en }}</p>{% endif %}
                <small class="spui-form-ayuda">Después de esa fecha el código deja de redirigir.</small>
            </div>
        </div>
    </div>
</section>

{# Hasta elegir un tipo no hay nada que presentar. #}
<div class="spui-form-grupo" data-spui-solo-tipos="texto imagen video qr cronograma" hidden>
    {{ include('@SPUI/contenidos/_presentacion.html.twig', {pv: presentacion, err: err, edificios: edificios}) }}
</div>

{{ f.pie('spui-btn-crear') }}

{{ form_end(form) }}
