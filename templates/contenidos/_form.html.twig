{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

{# Archivo, texto y los datos del código QR no son campos del FormType, así que
   sus errores llegan en `errores` (name del campo → mensaje) y se muestran
   debajo de cada uno, no por form.vars.errors. #}
{% set err = errores|default({}) %}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba en blanco de errores y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

<div class="row g-2 mb-3">
    <div class="col">
        {{ form_label(form.titulo) }}
        {{ form_widget(form.titulo) }}
        {% for e in form.titulo.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm-auto" style="min-width:160px">
        {{ form_label(form.tipo) }}
        {{ form_widget(form.tipo) }}
        {% for e in form.tipo.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.duracionSegundos) }}
    <div class="spui-input-with-addon">
        {{ form_widget(form.duracionSegundos) }}
        <span class="spui-input-addon">seg <small class="text-muted">(vacío = permanente)</small></span>
    </div>
    {% for e in form.duracionSegundos.vars.errors %}
        <p class="spui-campo-error">{{ e.message }}</p>
    {% endfor %}
    <small class="text-muted d-block mt-1">Dura lo mismo en todas las playlists donde esté.</small>
</div>

{# data-spui-campo: los errores del archivo (del servidor y de validacion-vivo.js,
   que avisa apenas se elige uno demasiado pesado) van al final de este bloque. #}
<div id="campoArchivo" class="mb-3" style="display:none" data-spui-campo>
    <label class="unraf-form-label" for="archivoInput">Archivo <span class="text-danger">*</span></label>
    {# Formatos según el tipo elegido: content-type-fields.js toma de
       data-spui-formatos-por-tipo el accept, las extensiones que valida
       validacion-vivo.js y el texto de ayuda de abajo. #}
    <input type="file" name="archivo" id="archivoInput" class="form-control{{ err.archivo is defined ? ' is-invalid' }}"
           data-spui-formatos-por-tipo="{{ constant('SPUI\\Service\\MediaStorageService::FORMATOS')|json_encode }}"
           {% if max_bytes_archivo is defined %}data-spui-max-bytes="{{ max_bytes_archivo }}"{% endif %}>
    <small class="text-muted" id="archivoAyuda"></small>
    {% if err.archivo is defined %}<p class="spui-campo-error">{{ err.archivo }}</p>{% endif %}
</div>

<div id="campoTexto" class="mb-3" style="display:none">
    <label class="unraf-form-label" id="labelTexto">Texto <span class="text-danger">*</span></label>
    <textarea name="contenido_texto" id="textareaTexto" class="unraf-form-control{{ err.contenido_texto is defined ? ' is-invalid' }}" rows="4" placeholder="Ingresá el texto a mostrar…">{{ contenido_texto|default('') }}</textarea>
    {% if err.contenido_texto is defined %}<p class="spui-campo-error">{{ err.contenido_texto }}</p>{% endif %}
</div>

<div id="campoCronograma" class="mb-3" style="display:none">
    <div class="p-3" style="background:#f0f7ff;border:1px solid #b8d4ec;border-radius:.5rem">
        <strong style="color:var(--unraf-azul)">Cronograma de actividades</strong><br>
        <small class="text-muted">Al guardar se abre el listado de ítems, donde se cargan los horarios, materias y eventos.</small>
    </div>
</div>

{# El código QR se carga acá mismo: no hay que crearlo antes en ningún otro
   lado. La etiqueta del código la toma del título del contenido. #}
<div id="campoQr" style="display:none">
    <div class="mb-3">
        <label class="unraf-form-label" for="qrUrlDestino">URL destino <span class="text-danger">*</span></label>
        <input type="url" name="qr_url_destino" id="qrUrlDestino" class="unraf-form-control{{ err.qr_url_destino is defined ? ' is-invalid' }}"
               maxlength="500" placeholder="https://…" value="{{ qr_url_destino|default('') }}">
        {% if err.qr_url_destino is defined %}<p class="spui-campo-error">{{ err.qr_url_destino }}</p>{% endif %}
        <small class="text-muted d-block mt-1">
            A dónde llega quien escanea. La imagen del QR se genera sola, y se puede cambiar el
            destino después sin reimprimir nada.
        </small>
    </div>

    <div class="mb-3">
        <label class="unraf-form-label" for="qrExpiraEn">Expira el <small class="text-muted">(opcional)</small></label>
        <input type="datetime-local" name="qr_expira_en" id="qrExpiraEn" class="unraf-form-control{{ err.qr_expira_en is defined ? ' is-invalid' }}"
               style="max-width:16rem" value="{{ qr_expira_en|default('') }}">
        {% if err.qr_expira_en is defined %}<p class="spui-campo-error">{{ err.qr_expira_en }}</p>{% endif %}
        <small class="text-muted d-block mt-1">Pasada esa fecha el código deja de redirigir. Vacío = sin vencimiento.</small>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn spui-btn-crear">Guardar</button>
</div>

{{ form_end(form) }}
