{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

{# Archivo/texto/QR no son campos del FormType, así que sus errores llegan por
   acá y no por form.vars.errors. #}
{% if error|default(null) %}
    <div class="alert alert-danger mb-3">{{ error }}</div>
{% endif %}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba en blanco de errores y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

<div class="row g-2 mb-3">
    <div class="col">
        {{ form_label(form.titulo) }}
        {{ form_widget(form.titulo) }}
        {% for e in form.titulo.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm-auto" style="min-width:160px">
        {{ form_label(form.tipo) }}
        {{ form_widget(form.tipo) }}
        {% for e in form.tipo.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.duracionSegundos) }}
    <div class="spui-input-with-addon">
        {{ form_widget(form.duracionSegundos) }}
        {% for e in form.duracionSegundos.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
        <span class="spui-input-addon">seg <small class="text-muted">(vacío = permanente)</small></span>
    </div>
    <small class="text-muted d-block mt-1">Puede sobreescribirse por ítem en la playlist.</small>
</div>

<div id="campoArchivo" class="mb-3" style="display:none">
    <label class="unraf-form-label">Archivo <span class="text-danger">*</span></label>
    <input type="file" name="archivo" id="archivoInput" class="form-control" accept="image/*,video/*">
    <small class="text-muted">Imágenes: JPG, PNG, GIF, WebP. Video: MP4, WebM.</small>
</div>

<div id="campoTexto" class="mb-3" style="display:none">
    <label class="unraf-form-label" id="labelTexto">Texto <span class="text-danger">*</span></label>
    <textarea name="contenido_texto" id="textareaTexto" class="unraf-form-control" rows="4" placeholder="Ingresá el texto a mostrar…">{{ contenido_texto|default('') }}</textarea>
</div>

<div id="campoCronograma" class="mb-3" style="display:none">
    <div class="p-3" style="background:#f0f7ff;border:1px solid #b8d4ec;border-radius:.5rem">
        <strong style="color:var(--unraf-azul)">Cronograma de actividades</strong><br>
        <small class="text-muted">Después de guardar serás redirigido al editor de ítems donde podés agregar horarios, materias y eventos.</small>
    </div>
</div>

<div id="campoQr" class="mb-3" style="display:none">
    <label class="unraf-form-label" for="codigoQrSelect">Código QR <span class="text-danger">*</span></label>
    {% if codigos_qr|default([])|length > 0 %}
        <select name="codigo_qr_id" id="codigoQrSelect" class="unraf-form-select">
            <option value="">— seleccionar —</option>
            {% for c in codigos_qr %}
                <option value="{{ c.id }}"{% if codigo_qr_id|default(null) == c.id %} selected{% endif %}>{{ c.etiqueta }} — {{ c.urlDestino|slice(0, 60) }}{% if c.urlDestino|length > 60 %}…{% endif %}</option>
            {% endfor %}
        </select>
        <small class="text-muted d-block mt-1">
            La imagen del QR se genera automáticamente. Los escaneos se cuentan y podés cambiar
            el destino después sin volver a publicar el contenido.
        </small>
    {% else %}
        <div class="alert alert-info mb-0">
            No hay códigos QR creados todavía.<br>
            <small>Creá uno desde <strong>Códigos QR</strong> y volvé acá para mostrarlo en pantalla.</small>
        </div>
    {% endif %}
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn spui-btn-crear">Guardar</button>
</div>

{{ form_end(form) }}
