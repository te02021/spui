{% extends '@SPUI/base.html.twig' %}
{% block title %}Nueva ubicación — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nueva ubicación</h1>
    <a href="{{ path('spui_cms_ubicaciones_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="row justify-content-center">
<div class="col-lg-8">
    <div class="unraf-card p-4">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.edificio) }}
            {{ form_widget(form.edificio) }}
            {% for error in form.edificio.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.sector) }}
            {{ form_widget(form.sector) }}
            <small class="text-muted d-block mt-1">Opcional. Ej: Hall de Entrada, Pasillo Planta Baja, Recepción. Si abarca todo el edificio, dejá en blanco.</small>
        </div>

        <div class="mb-3">
            {{ form_label(form.descripcion) }}
            {{ form_widget(form.descripcion) }}
        </div>

        <div class="mb-4 form-check">
            {{ form_widget(form.activo, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.activo, null, {'label_attr': {'class': 'form-check-label'}}) }}
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('spui_cms_ubicaciones_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
            <button type="submit" class="unraf-btn unraf-btn-institucion">Guardar ubicación</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
{% endblock %}
