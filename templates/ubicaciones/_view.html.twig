{% import '@SPUI/_macros/ver.html.twig' as ver %}
{# Detalle de una ubicación o sector. El título es el del modal. #}
<div class="spui-ver">
    <section class="spui-ver-seccion" aria-labelledby="spui-ver-detalles">
        <h5 class="spui-ver-titulo" id="spui-ver-detalles">Detalles</h5>
        <dl class="spui-ver-datos spui-ver-bloque">
            <div><dt>Edificio</dt><dd>{{ ubicacion.edificio.nombre }}</dd></div>
            {% if ubicacion.sector %}<div><dt>Sector</dt><dd>{{ ubicacion.sector }}</dd></div>{% endif %}
            <div><dt>Estado</dt><dd><span class="{{ ubicacion.activo ? 'spui-badge-conectado' : 'spui-badge-sin_registrar' }}">{{ ubicacion.activo ? 'Activa' : 'Inactiva' }}</span></dd></div>
            <div><dt>Pantallas</dt><dd>{{ ubicacion.pantallas|length }}</dd></div>
        </dl>
    </section>

    {% if ubicacion.descripcion %}
        <section class="spui-ver-seccion" aria-labelledby="spui-ver-descripcion">
            <h5 class="spui-ver-titulo" id="spui-ver-descripcion">Descripción</h5>
            <div class="spui-ver-bloque"><p class="spui-ver-texto">{{ ubicacion.descripcion }}</p></div>
        </section>
    {% endif %}

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-pantallas">
        <h5 class="spui-ver-titulo" id="spui-ver-pantallas">Pantallas · {{ ubicacion.pantallas|length }}</h5>
        {% if ubicacion.pantallas|length > 0 %}
            <div class="spui-ver-bloque">
                <ul class="spui-ver-usos">
                    {% for p in ubicacion.pantallas %}
                        <li><span>{{ p.nombre }}</span><small>{{ p.estado.etiqueta }}</small></li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            {{ ver.vacio('Sin pantallas asignadas.') }}
        {% endif %}
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-reglas">
        <h5 class="spui-ver-titulo" id="spui-ver-reglas">Reglas de programación · {{ ubicacion.programaciones|length }}</h5>
        {{ ver.reglas(ubicacion.programaciones, 'Sin reglas que apliquen a todo el sector.') }}
    </section>
</div>
