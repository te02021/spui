{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

{% set swId = form.activo.vars.id %}

<div class="row g-3 mb-3">
    <div class="col">
        {{ form_label(form.etiqueta) }}
        {{ form_widget(form.etiqueta) }}
        <small class="text-muted d-block mt-1">{{ form.etiqueta.vars.help }}</small>
        {% for e in form.etiqueta.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm-auto d-flex flex-column align-items-center" style="min-width:110px">
        <label class="unraf-form-label mb-2 text-center" for="{{ swId }}">Estado</label>
        <div class="d-flex align-items-center gap-2">
            <div class="form-switch m-0">
                {{ form_widget(form.activo, {'attr': {'class': 'form-check-input spui-switch-input', 'role': 'switch', 'data-spui-switch': '1', 'data-switch-on': 'Activo', 'data-switch-off': 'Inactivo'}}) }}
            </div>
            <span class="spui-switch-status off" id="{{ swId }}_lbl">Inactivo</span>
        </div>
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.urlDestino) }}
    {{ form_widget(form.urlDestino) }}
    <small class="text-muted d-block mt-1">{{ form.urlDestino.vars.help }}</small>
    {% for e in form.urlDestino.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

<div class="mb-4">
    {{ form_label(form.expiraEn) }}
    {{ form_widget(form.expiraEn) }}
    <small class="text-muted d-block mt-1">{{ form.expiraEn.vars.help }}</small>
    {% for e in form.expiraEn.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

{% if qr is defined and qr.id %}
    <div class="d-flex align-items-center gap-3 p-3 mb-4 rounded" style="background:#f8f9fa">
        <img src="{{ path('spui_qr_imagen', {id: qr.id}) }}" alt="QR" width="88" height="88" style="background:#fff;border-radius:.25rem">
        <div class="small text-muted">
            Este QR ya fue escaneado <strong>{{ qr.usosCount }}</strong> vez/veces.<br>
            Cambiar la URL destino <strong>no invalida</strong> los QR ya impresos o en pantalla.
        </div>
    </div>
{% endif %}

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn {{ qr is defined and qr.id ? 'spui-btn-editar' : 'spui-btn-crear' }}">
        Guardar
    </button>
</div>

{{ form_end(form) }}
