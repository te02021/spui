{% extends '@SPUI/base.html.twig' %}
{% block title %}Nueva alerta de emergencia — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nueva alerta</h1>
    <a href="{{ path('spui_cms_alertas_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="row justify-content-center">
<div class="col-lg-9">
    <div class="unraf-card p-4">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.titulo) }}
            {{ form_widget(form.titulo) }}
            {% for error in form.titulo.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.mensaje) }}
            {{ form_widget(form.mensaje) }}
            {% for error in form.mensaje.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.prioridad) }}
            {{ form_widget(form.prioridad) }}
            <small class="text-muted d-block mt-1">Mayor número = mayor prioridad en pantallas.</small>
        </div>

        <div class="mb-3">
            {{ form_label(form.expiraEn) }}
            {{ form_widget(form.expiraEn) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.contenido) }}
            {{ form_widget(form.contenido) }}
            <small class="text-muted d-block mt-1">Si se selecciona, los reproductores mostrarán esta imagen/video junto al mensaje.</small>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('spui_cms_alertas_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
            <button type="submit" class="unraf-btn unraf-btn-danger">Crear alerta</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
{% endblock %}
