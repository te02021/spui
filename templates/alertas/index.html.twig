{% extends '@SPUI/base.html.twig' %}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% import '@SPUI/_macros/texto.html.twig' as texto %}
{% block title %}Alertas — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 spui-header-actions">
    <div>
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Alertas</h1>
        <p class="text-muted mb-0">Al activarse, interrumpen la programación de las pantallas destinatarias.</p>
    </div>
    <button type="button" class="unraf-btn spui-btn-crear flex-shrink-0"
            data-spui-form="{{ path('spui_cms_alertas_nueva_form') }}"
            data-spui-title="Nueva alerta">
        + Nueva alerta
    </button>
</div>

{# Tarjetas en vez de tabla (29/10/2026): con ocho columnas el mensaje y el
   adjunto quedaban en tres renglones y los botones en dos filas.
   El estado depende del reloj (una alerta con vencimiento caduca sola), por
   eso todo el listado está en la zona que refresca auto-refresh.js. #}
{{ include('@SPUI/_partials/barra_lista.html.twig', {filtros: filtros, que: 'alertas', placeholder: 'Buscar por título o mensaje'}) }}
<div id="spui-table-body" data-spui-refresh data-spui-busqueda-zona>
<div class="spui-lista">
{% for alerta in alertas %}
    {% set motivo = spui_alcance.motivoParaEntidad(alerta, ids_offline|default({})) %}
    {% set estado = alerta.activa ? 'grave' : (alerta.haExpirado ? 'apagado' : 'neutro') %}
    <div class="unraf-card spui-item is-{{ estado }}">
        <div class="spui-item-cuerpo">
            <div class="spui-item-cab">
                <span class="spui-etiqueta is-{{ estado }}">
                    {%- if alerta.activa %}<span class="spui-etiqueta-latido"></span>En curso{% elseif alerta.haExpirado %}Expirada{% else %}Inactiva{% endif -%}
                </span>
                <span class="spui-item-titulo">{{ alerta.titulo }}</span>
            </div>
            <p class="spui-item-detalle" title="{{ alerta.mensaje }}">{{ alerta.mensaje }}</p>
            <div class="spui-chips">
                <span class="spui-chip" title="Entre varias alertas activas, la pantalla muestra la de mayor prioridad">
                    <img src="{{ asset('unraf-ui/icons/sort-descending.svg') }}" alt=""> Prioridad {{ alerta.prioridad }}
                </span>
                <span class="spui-chip"{% if not alerta.esGlobal %} title="{% for p in alerta.pantallas %}{{ p.nombre }}{% if not loop.last %}, {% endif %}{% endfor %}"{% endif %}>
                    <img src="{{ asset('unraf-ui/icons/monitor.svg') }}" alt="">
                    {{ alerta.esGlobal ? 'Todas las pantallas' : texto.plural(alerta.pantallas|length, 'pantalla', 'pantallas') }}
                </span>
                <span class="spui-chip">
                    <img src="{{ asset('unraf-ui/icons/clock.svg') }}" alt="">
                    {%- if alerta.expiraEn %} {{ alerta.haExpirado ? 'Venció' : 'Vence' }} el {{ alerta.expiraEn|date('d/m/Y H:i') }}{% else %} Sin vencimiento{% endif -%}
                </span>
                {% if alerta.activa and alerta.activadaEn %}
                    <span class="spui-chip">
                        <img src="{{ asset('unraf-ui/icons/lightning.svg') }}" alt=""> Activa desde el {{ alerta.activadaEn|date('d/m H:i') }}
                    </span>
                {% endif %}
                {% if alerta.contenido %}
                    <span class="spui-chip">
                        <img src="{{ asset('unraf-ui/icons/paperclip.svg') }}" alt=""> {{ alerta.contenido.titulo }}
                    </span>
                {% endif %}
                {% if alerta.sonidoArchivo %}
                    <span class="spui-chip">
                        <img src="{{ asset('unraf-ui/icons/speaker-high.svg') }}" alt=""> Sonido propio
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="spui-acciones spui-item-acciones">
            <button type="button" class="unraf-btn spui-btn-ver unraf-btn-sm"
                    data-spui-form="{{ path('spui_cms_alertas_ver', {id: alerta.id}) }}"
                    data-spui-title="Alerta: {{ alerta.titulo }}"
                    title="Ver detalle">
                <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt=""> Ver
            </button>

            {% if not alerta.activa and not alerta.haExpirado %}
                <button type="button" class="unraf-btn spui-btn-activar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                        data-spui-action="{{ path('spui_cms_alertas_activar', {id: alerta.id}) }}"
                        data-spui-title="Activar alerta"
                        data-spui-message="¿Activar «{{ alerta.titulo }}»? Se publicará {% if alerta.esGlobal %}a TODAS las pantallas{% else %}a {{ texto.plural(alerta.pantallas|length, 'pantalla', 'pantallas') }}{% endif %} inmediatamente."
                        data-spui-variant="activar"
                        data-spui-confirm-label="Activar"
                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Activar"{% endif %}>
                    <img src="{{ asset('unraf-ui/icons/lightning.svg') }}" class="spui-action-icon" alt=""> Activar
                </button>
            {% endif %}

            {% if alerta.activa %}
                <button type="button" class="unraf-btn spui-btn-desactivar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                        data-spui-action="{{ path('spui_cms_alertas_desactivar', {id: alerta.id}) }}"
                        data-spui-title="Desactivar alerta"
                        data-spui-message="¿Desactivar «{{ alerta.titulo }}»? Los reproductores dejarán de mostrarla."
                        data-spui-variant="desactivar"
                        data-spui-confirm-label="Desactivar"
                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Desactivar"{% endif %}>
                    <img src="{{ asset('unraf-ui/icons/hand-palm.svg') }}" class="spui-action-icon" alt=""> Desactivar
                </button>
            {% endif %}

            {# Editar sólo mientras la alerta siga siendo utilizable: una
               expirada ya no se puede reprogramar. Eliminar, en cambio,
               tiene que seguir disponible justamente para poder limpiarla. #}
            {% if not alerta.activa and not alerta.haExpirado %}
                <button type="button" class="unraf-btn spui-btn-editar unraf-btn-sm"
                        data-spui-form="{{ path('spui_cms_alertas_editar', {id: alerta.id}) }}"
                        data-spui-title="Editar: {{ alerta.titulo }}"
                        title="Editar">
                    <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt=""> Editar
                </button>
            {% endif %}

            {% if not alerta.activa %}
                <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-sm"
                        data-spui-action="{{ path('spui_cms_alertas_eliminar', {id: alerta.id}) }}"
                        data-spui-title="Eliminar alerta"
                        data-spui-message="¿Eliminar «{{ alerta.titulo }}»? Esta acción no se puede deshacer."
                        data-spui-variant="eliminar"
                        title="Eliminar">
                    <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
                </button>
            {% endif %}
        </div>
    </div>
{% else %}
    {% set filtrado = busqueda|default('') != '' or filtros|filter(g => g.actual != '' and g.opciones[0].cuenta is not null)|length > 0 %}
    <div class="unraf-card p-4 text-center text-muted">
        {% if filtrado %}No hay alertas que coincidan{% if busqueda|default('') %} con «{{ busqueda }}»{% endif %}. <a href="{{ path(app.request.attributes.get('_route')) }}">Ver todos</a>
        {% else %}<p class="mb-1">No hay alertas creadas.</p>
        <small>Creá una para poder interrumpir las pantallas ante una emergencia.</small>{% endif %}
    </div>
{% endfor %}
</div>
</div>
{% endblock %}
