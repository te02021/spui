{# Alta y edición de una alerta (rediseñado el 05/11/2026). A qué pantallas llega es una
   decisión explícita: en el alta no viene nada elegido, porque antes, sin marcar ninguna,
   la alerta salía a todo el campus (AlertaType). #}
{% import '@SPUI/_macros/form.html.twig' as f %}
{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'class': 'spui-form'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-0">{{ e.message }}</div>
{% endfor %}

<section class="spui-ver-seccion" aria-labelledby="spui-form-mensaje">
    <h5 class="spui-ver-titulo" id="spui-form-mensaje">Mensaje</h5>
    <div class="spui-ver-bloque">
        <div class="spui-form-fila spui-form-fila-principal">
            <div>{{ f.campo(form.titulo) }}</div>
            <div>
                {{ f.campo(form.prioridad) }}
                <small class="spui-form-ayuda">A mayor número, más prioridad.</small>
            </div>
            <div class="spui-fecha-field">{{ f.campo(form.expiraEn) }}</div>
        </div>
        <div class="spui-form-separado">{{ f.campo(form.mensaje) }}</div>
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-destino">
    <h5 class="spui-ver-titulo" id="spui-form-destino">¿A qué pantallas llega?</h5>
    <div class="spui-ver-bloque spui-form-alcance-apilado" data-spui-alcance>
        <div class="spui-opciones" role="radiogroup" aria-labelledby="spui-form-destino">
            {% for op in form.alcance %}
                <input type="radio" class="spui-opcion-input" name="{{ op.vars.full_name }}" id="{{ op.vars.id }}"
                       value="{{ op.vars.value }}" {{ op.vars.checked ? 'checked' }}>
                <label class="spui-opcion" for="{{ op.vars.id }}">{{ op.vars.label }}</label>
            {% endfor %}
            {% do form.alcance.setRendered() %}
        </div>
        {% for e in form.alcance.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
        <p class="spui-ver-texto" data-spui-si-alcance="todas" hidden>La alerta interrumpe <strong>todas las pantallas</strong> del sistema.</p>
        <div data-spui-si-alcance="elegir" hidden>
            {% if form.pantallas|length > 0 %}
                {# form_label y form_widget por separado: form_row sacaba el nombre dos veces. #}
                <div class="spui-alerta-destinos">
                    {% for pantalla in form.pantallas %}
                        <div class="spui-alerta-destino form-check">
                            {{ form_widget(pantalla) }}
                            {{ form_label(pantalla) }}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="spui-ver-texto">No hay pantallas cargadas todavía.</p>
            {% endif %}
            {% for e in form.pantallas.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
        </div>
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-adjuntos">
    <h5 class="spui-ver-titulo" id="spui-form-adjuntos">Adjuntos</h5>
    <div class="spui-ver-bloque spui-form-fila spui-form-fila-2">
        <div>
            {{ f.campo(form.contenido) }}
            <small class="spui-form-ayuda">Se muestra junto al mensaje.</small>
        </div>
        {# Campo sin mapear al form (igual que 'archivo' en el de Contenido): se lee directo de
           request.files en el controller, ver AlertaCmsController::aplicarSonido(). El JS
           (alerta-sonido-field.js) arma la preview y maneja el botón de quitar. #}
        {% set tieneSonido = alerta is defined and alerta.sonidoArchivo %}
        <div class="spui-sonido-field" data-spui-sonido-field data-spui-campo>
            <span class="unraf-form-label d-block">Sonido (opcional)</span>
            <label class="unraf-btn spui-btn-back spui-file-trigger spui-form-archivo-btn" title="Elegir archivo de sonido">
                <img src="{{ asset('unraf-ui/icons/upload-simple.svg') }}" class="spui-action-icon" alt="">
                Elegir sonido
                <input type="file" name="sonido_archivo" accept="audio/mpeg,audio/wav,.mp3,.wav" data-spui-sonido-input
                       data-spui-formatos="mp3,wav" data-spui-formatos-texto="MP3 o WAV"
                       {% if max_bytes_sonido is defined %}data-spui-max-bytes="{{ max_bytes_sonido }}"{% endif %}>
            </label>
            <div class="spui-sonido-row" data-spui-sonido-row {{ tieneSonido ? '' : 'hidden' }}>
                <audio controls preload="none" {% if tieneSonido %}src="{{ path('spui_cms_alertas_sonido_preview', {id: alerta.id}) }}"{% endif %}></audio>
                <span class="spui-sonido-nombre">{{ tieneSonido ? (alerta.sonidoNombreOriginal ?? 'sonido personalizado') : '' }}</span>
                <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-icon" data-spui-sonido-quitar title="Quitar sonido">
                    <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt="Quitar">
                </button>
            </div>
            <input type="hidden" name="sonido_quitar" value="0" data-spui-sonido-quitar-flag>
            <small class="spui-form-ayuda">MP3 o WAV, hasta 5 MB. Sin archivo, suena un tono de alerta.</small>
            {% if error_sonido is defined and error_sonido %}<p class="spui-campo-error">{{ error_sonido }}</p>{% endif %}
        </div>
    </div>
</section>

{{ f.pie(modo|default('alta') == 'edicion' ? 'spui-btn-editar' : 'spui-btn-crear') }}

{{ form_end(form) }}
