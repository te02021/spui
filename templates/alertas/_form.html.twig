{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

<div class="mb-3">
    {{ form_label(form.titulo) }}
    {{ form_widget(form.titulo) }}
    {% for e in form.titulo.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

<div class="mb-3">
    {{ form_label(form.mensaje) }}
    {{ form_widget(form.mensaje) }}
    {% for e in form.mensaje.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

<div class="row g-3 mb-3 justify-content-center">
    <div class="col-auto spui-hora-field">
        {{ form_label(form.prioridad) }}
        {{ form_widget(form.prioridad) }}
        {% for e in form.prioridad.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
        <small class="text-muted mt-1 d-block text-center">Mayor número = mayor prioridad.</small>
    </div>
    <div class="col-auto spui-hora-field">
        {{ form_label(form.expiraEn) }}
        {{ form_widget(form.expiraEn) }}
        {% for e in form.expiraEn.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="mb-4">
    {{ form_label(form.contenido) }}
    {{ form_widget(form.contenido) }}
    {% for e in form.contenido.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
    <small class="text-muted d-block mt-1">Si se selecciona, los reproductores mostrarán esta imagen/video junto al mensaje.</small>
</div>

{# Campo sin mapear al form (igual que 'archivo' en el de Contenido): se lee
   directo de request.files en el controller, ver AlertaCmsController::aplicarSonido().
   El JS (alerta-sonido-field.js) arma la preview del archivo recién elegido y
   maneja el botón de quitar — ver ese archivo para el detalle de por qué el
   flag 'sonido_quitar' queda prendido en vez de usarse un checkbox aparte. #}
{% set tieneSonido = alerta is defined and alerta.sonidoArchivo %}
<div class="mb-4 spui-sonido-field" data-spui-sonido-field>
    <div class="spui-sonido-field-header">
        <label class="unraf-form-label">Sonido de alerta (opcional)</label>
        <label class="unraf-btn spui-btn-back unraf-btn-icon spui-file-trigger" title="Elegir archivo de sonido">
            <img src="{{ asset('unraf-ui/icons/upload-simple.svg') }}" class="spui-action-icon" alt="Elegir archivo de sonido">
            <input type="file" name="sonido_archivo" accept="audio/mpeg,audio/wav,.mp3,.wav" data-spui-sonido-input>
        </label>
    </div>

    <div class="spui-sonido-row" data-spui-sonido-row {{ tieneSonido ? '' : 'hidden' }}>
        <audio controls preload="none" {% if tieneSonido %}src="{{ path('spui_cms_alertas_sonido_preview', {id: alerta.id}) }}"{% endif %}></audio>
        <span class="spui-sonido-nombre">{{ tieneSonido ? (alerta.sonidoNombreOriginal ?? 'sonido personalizado') : '' }}</span>
        <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-icon" data-spui-sonido-quitar title="Quitar sonido">
            <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt="Quitar">
        </button>
    </div>

    <input type="hidden" name="sonido_quitar" value="0" data-spui-sonido-quitar-flag>

    <small class="text-muted d-block mt-1">
        MP3 o WAV, hasta 5 MB. Si no se sube ninguno, el reproductor emite un tono generado automáticamente.
    </small>
</div>

<div class="mb-4">
    {{ form_label(form.pantallas) }}
    <small class="text-muted d-block mb-2">
        Si no elegís ninguna, la alerta llega a <strong>todas las pantallas</strong>.
    </small>
    {% if form.pantallas|length > 0 %}
        {# form_row() ya emite el checkbox y su etiqueta (tema bootstrap_5).
           Antes acá se agregaba un <span> con pantalla.vars.label además del
           widget, y el nombre de cada pantalla salía escrito dos veces. #}
        <div class="spui-alerta-destinos">
            {% for pantalla in form.pantallas %}
                <div class="spui-alerta-destino form-check">
                    {{ form_widget(pantalla) }}
                    {{ form_label(pantalla) }}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="spui-view-empty mb-0">No hay pantallas cargadas todavía.</p>
    {% endif %}
    {% for e in form.pantallas.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn {{ modo|default('alta') == 'edicion' ? 'spui-btn-editar' : 'spui-btn-crear' }}">Guardar</button>
</div>

{{ form_end(form) }}
