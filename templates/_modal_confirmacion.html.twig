<div id="modalConfirmacionSpui" class="unraf-modal-overlay">
    <div class="unraf-modal unraf-modal-sm">
        <div class="unraf-modal-header">
            <h3 class="unraf-modal-title" id="spuiModalTitulo">Confirmar acción</h3>
            <button type="button" class="unraf-modal-close" id="spuiModalCerrar">&times;</button>
        </div>
        <div class="unraf-modal-body">
            <p id="spuiModalMensaje">¿Estás seguro?</p>
            <p class="text-muted small">Esta acción no se puede deshacer.</p>
        </div>
        <div class="unraf-modal-footer">
            <button type="button" class="unraf-btn unraf-btn-light" id="spuiModalCancelar">Cancelar</button>
            <form id="spuiModalForm" method="post" style="display:inline">
                <button type="submit" class="unraf-btn unraf-btn-danger" id="spuiModalConfirmar">Confirmar</button>
            </form>
        </div>
    </div>
</div>
