{# Grilla semanal de energía, dentro del modal (nivel 1).

   Cada día abre su formulario en el nivel 2, igual que "Ver ítems" de una
   playlist: por eso las acciones usan los atributos con sufijo 2
   (data-spui-form2 / data-spui-action2), que son los que dibujan encima sin
   cerrar esta capa. Con los atributos sin el 2 se pisaría esta misma grilla.

   Toda la grilla es de una sola pantalla, así que el motivo de bloqueo se
   resuelve una vez y vale para las tres acciones. La grilla se puede mirar
   siempre: lo que se bloquea es modificar, no consultar. #}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% set motivo = spui_alcance.motivoParaEntidad(pantalla, ids_offline|default({})) %}

{# Zona donde el nivel 2 pinta sus confirmaciones (no puede abrir otro modal). #}
<div data-spui-confirm-host></div>

<p class="text-muted small mb-3">
    Encendido, apagado y brillo por día. Los días sin horario dejan la pantalla siempre encendida.
</p>

<div class="unraf-table-responsive">
    <table class="unraf-table unraf-table-striped w-100 spui-tabla-cards">
            <thead>
                <tr>
                    <th class="p-3">Día</th>
                    <th class="p-3">Encendido</th>
                    <th class="p-3">Apagado</th>
                    <th class="p-3">Brillo</th>
                    <th class="p-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for num, nombre in dias %}
                {% set regla = reglas[num] ?? null %}
                <tr>
                    <td class="p-3" data-label="Día"><strong>{{ nombre }}</strong></td>

                    {% if regla %}
                        <td class="p-3" data-label="Encendido">{{ regla.horaEncendido|date('H:i') }}</td>
                        <td class="p-3" data-label="Apagado">{{ regla.horaApagado|date('H:i') }}</td>
                        <td class="p-3" data-label="Brillo">
                            <span class="spui-badge-publicado">{{ regla.nivelBrillo }}%</span>
                        </td>
                    {% else %}
                        <td class="p-3 text-muted" colspan="3" data-label="Horario">
                            <em>Sin horario — siempre encendida</em>
                        </td>
                    {% endif %}

                    <td class="p-3" data-label="Acciones">
                        <div class="spui-acciones">
                            <button type="button"
                                    class="unraf-btn unraf-btn-sm {{ regla ? 'spui-btn-editar' : 'spui-btn-crear' }} {{ bloqueo.clase(motivo) }}"
                                    data-spui-form2="{{ path('spui_cms_energia_editar', {id: pantalla.id, dia: num}) }}"
                                    data-spui-subvista
                                    data-spui-title="{{ nombre }} — {{ pantalla.nombre }}"
                                    data-spui-size="modal-sm"
                                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="{{ regla ? 'Editar horario' : 'Configurar horario' }}"{% endif %}>
                                <img src="{{ asset(regla ? 'unraf-ui/icons/pencil.svg' : 'unraf-ui/icons/plus.svg') }}"
                                     class="spui-action-icon" alt="">
                                {{ regla ? 'Editar' : 'Configurar' }}
                            </button>

                            {% if regla %}
                                {% if num <= 5 %}
                                    <button type="button" class="unraf-btn spui-btn-copiar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                            data-spui-action2="{{ path('spui_cms_energia_copiar', {id: pantalla.id, dia: num}) }}"
                                            data-spui-title="Copiar a días hábiles"
                                            data-spui-confirm-label="Copiar"
                                            data-spui-message="¿Copiar el horario de {{ nombre }} al resto de los días hábiles (lunes a viernes)? Se sobreescribe lo que tengan cargado."
                                            data-spui-variant="copiar"
                                            {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Copiar a lunes-viernes"{% endif %}>
                                        <img src="{{ asset('unraf-ui/icons/copy.svg') }}" class="spui-action-icon" alt=""> Copiar a L-V
                                    </button>
                                {% endif %}
                                <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                        data-spui-action2="{{ path('spui_cms_energia_eliminar', {id: pantalla.id, dia: num}) }}"
                                        data-spui-title="Eliminar horario"
                                        data-spui-message="¿Eliminar el horario de {{ nombre }}? La pantalla queda siempre encendida ese día."
                                        data-spui-variant="eliminar"
                                        {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Eliminar"{% endif %}>
                                    <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
                                </button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
    </table>
</div>
