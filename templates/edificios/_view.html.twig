{% import '@SPUI/_macros/texto.html.twig' as texto %}
{% import '@SPUI/_macros/ver.html.twig' as ver %}
{# Detalle de un edificio. El título es el del modal. #}
{% set totalPantallas = 0 %}
{% for u in edificio.ubicaciones %}{% set totalPantallas = totalPantallas + u.pantallas|length %}{% endfor %}
<div class="spui-ver">
    <section class="spui-ver-seccion" aria-labelledby="spui-ver-detalles">
        <h5 class="spui-ver-titulo" id="spui-ver-detalles">Detalles</h5>
        <dl class="spui-ver-datos spui-ver-bloque">
            <div><dt>Estado</dt><dd><span class="{{ edificio.activo ? 'spui-badge-conectado' : 'spui-badge-sin_registrar' }}">{{ edificio.activo ? 'Activo' : 'Inactivo' }}</span></dd></div>
            <div><dt>Sectores</dt><dd>{{ edificio.ubicaciones|length }}</dd></div>
            <div><dt>Pantallas</dt><dd>{{ totalPantallas }}</dd></div>
        </dl>
    </section>

    {% if edificio.descripcion %}
        <section class="spui-ver-seccion" aria-labelledby="spui-ver-descripcion">
            <h5 class="spui-ver-titulo" id="spui-ver-descripcion">Descripción</h5>
            <div class="spui-ver-bloque"><p class="spui-ver-texto">{{ edificio.descripcion }}</p></div>
        </section>
    {% endif %}

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-sectores">
        <h5 class="spui-ver-titulo" id="spui-ver-sectores">Sectores · {{ edificio.ubicaciones|length }}</h5>
        {% if edificio.ubicaciones|length > 0 %}
            <div class="spui-ver-bloque">
                <ul class="spui-ver-usos">
                    {% for u in edificio.ubicaciones %}
                        <li><span>{{ u.sector ?: 'Sector sin nombre' }}</span><small>{{ texto.plural(u.pantallas|length, 'pantalla', 'pantallas') }}</small></li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            {{ ver.vacio('Sin sectores registrados.') }}
        {% endif %}
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-reglas">
        <h5 class="spui-ver-titulo" id="spui-ver-reglas">Reglas de programación · {{ edificio.programaciones|length }}</h5>
        {{ ver.reglas(edificio.programaciones, 'Sin reglas que apliquen a todo el edificio.') }}
    </section>
</div>
