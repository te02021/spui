{% import '@SPUI/_macros/form.html.twig' as f %}
{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'class': 'spui-form'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-0">{{ e.message }}</div>
{% endfor %}

<section class="spui-ver-seccion" aria-labelledby="spui-form-datos">
    <h5 class="spui-ver-titulo" id="spui-form-datos">Datos</h5>
    <div class="spui-ver-bloque">
        <div class="spui-form-fila spui-form-fila-dato">
            <div>{{ f.campo(form.nombre) }}</div>
            <div>{{ f.estado(form.activo, 'Activo', 'Inactivo') }}</div>
        </div>
        <div class="spui-form-separado">{{ f.campo(form.descripcion) }}</div>
    </div>
</section>

{{ f.pie(edificio is defined and edificio.id ? 'spui-btn-editar' : 'spui-btn-crear') }}

{{ form_end(form) }}
