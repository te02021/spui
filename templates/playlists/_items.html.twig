{# Ítems de una playlist, dentro del modal de segundo nivel.

   Dos listados en la misma vista: arriba los que están en la playlist (drag &
   drop + quitar) y abajo los disponibles para agregar.

   NADA se persiste al tocar los botones. Agregar, quitar y reordenar mutan sólo
   este DOM; el botón Guardar aparece cuando el estado difiere del persistido y
   desaparece cuando coincide. Lo maneja playlists/items.js — antes cada acción
   iba sola al servidor y la lista se guardaba sin que nadie lo confirmara.

   En ALTA (playlist === null) no hay nada persistido todavía: el Guardar
   confirma la selección en memoria y el modal principal la manda al crear.

   Modo readonly = true (desde "Ver playlist"): sólo el listado de arriba, sin
   controles. #}
{% set ro = readonly|default(false) %}
{% set esAlta = playlist is null %}
{% set lista = items|default([]) %}

{# Zona donde el nivel 2 pinta sus confirmaciones (no puede abrir otro modal). #}
<div data-spui-confirm-host></div>

<div data-spui-items-root
     {% if not esAlta %}data-guardar-url="{{ path('spui_cms_playlists_items_guardar', {id: playlist.id}) }}"{% endif %}
     data-alta="{{ esAlta ? '1' : '0' }}">

    {# ── Ítems en la playlist ────────────────────────────────────────────── #}
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <strong class="spui-view-section-title mb-0">En la playlist</strong>
        <span class="text-muted small">
            <span data-spui-items-total>{{ lista|length }}</span> ítem(s){% if not ro %} · Arrastrá para reordenar{% endif %}
        </span>
    </div>

    <div data-spui-items-vacio class="p-4 text-center text-muted"{% if lista|length %} hidden{% endif %}>
        La playlist está vacía.{% if not ro %} Agregá contenidos desde la lista de abajo.{% endif %}
    </div>

    <ul class="list-unstyled mb-0 spui-items-lista"
        data-spui-items-lista
        {% if not ro %}data-spui-sortable{% endif %}
        {% if not lista|length %}hidden{% endif %}>
    {% for item in lista %}
        {% set c = item.contenido %}
        <li class="sortable-item d-flex align-items-center gap-2 p-3 border-bottom"
            data-contenido-id="{{ c.id }}">
            {% if not ro %}
                <span class="item-drag-handle">
                    <img src="{{ asset('unraf-ui/icons/dots-six-vertical.svg') }}" class="unraf-icon-svg" alt="">
                </span>
            {% endif %}
            <span class="spui-badge-borrador" style="min-width:1.8rem;text-align:center" data-spui-item-orden>{{ loop.index }}</span>
            <div class="flex-grow-1">
                <strong>{{ c.titulo }}</strong>
                <small class="text-muted ms-2">{{ c.tipo.value }}</small>
            </div>
            <span class="duracion-badge text-muted small">
                {{ c.duracionSegundos ? c.duracionSegundos ~ 's' : 'Permanente' }}
            </span>
            {% if not ro %}
                <button type="button" class="unraf-btn-icon btn-delete"
                        data-spui-item-quitar
                        title="Quitar de la playlist">
                    <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="unraf-icon-svg" alt="Quitar">
                </button>
            {% endif %}
        </li>
    {% endfor %}
    </ul>

    {# ── Contenidos disponibles ──────────────────────────────────────────── #}
    {% if not ro %}
        <div class="spui-items-separador">
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                <strong class="spui-view-section-title mb-0">Agregar contenido</strong>
                {% if disponibles|default([])|length > 0 %}
                    <input type="search" class="unraf-form-control spui-filtro-input"
                           placeholder="Buscar…" aria-label="Buscar contenidos"
                           data-spui-filter-input
                           data-spui-filter-target="#spui-disponibles"
                           data-spui-filter-empty="#spui-disponibles-sin-resultados">
                {% endif %}
            </div>

            {% if disponibles|default([])|length == 0 %}
                <div class="p-4 text-center text-muted">
                    No hay contenidos publicados para agregar.<br>
                    <small>Creá uno desde <strong>Contenidos</strong> y volvé acá.</small>
                </div>
            {% else %}
                {# Se listan TODOS los publicados, incluidos los que ya están
                   arriba: como agregar y quitar ya no recargan desde el
                   servidor, cada fila se muestra u oculta según dónde esté el
                   contenido en este momento. #}
                <ul class="list-unstyled mb-0 spui-disponibles-lista" id="spui-disponibles" data-spui-disponibles>
                {% for c in disponibles %}
                    <li class="d-flex align-items-center gap-2 p-3 border-bottom"
                        data-contenido-id="{{ c.id }}"
                        data-titulo="{{ c.titulo }}"
                        data-tipo="{{ c.tipo.value }}"
                        data-duracion="{{ c.duracionSegundos ? c.duracionSegundos ~ 's' : 'Permanente' }}"
                        data-filter-text="{{ (c.titulo ~ ' ' ~ c.tipo.value)|lower }}">
                        <div class="flex-grow-1">
                            <strong>{{ c.titulo }}</strong>
                            <small class="text-muted ms-2">{{ c.tipo.value }}</small>
                        </div>
                        <span class="duracion-badge text-muted small">
                            {{ c.duracionSegundos ? c.duracionSegundos ~ 's' : 'Permanente' }}
                        </span>
                        <button type="button" class="unraf-btn spui-btn-crear unraf-btn-sm"
                                data-spui-item-agregar
                                title="Agregar a la playlist">
                            Agregar
                        </button>
                    </li>
                {% endfor %}
                </ul>
                <p class="p-3 text-center text-muted mb-0" id="spui-disponibles-sin-resultados" hidden>
                    Ningún contenido coincide con la búsqueda.
                </p>
            {% endif %}
        </div>

        {# Aparece sólo cuando hay diferencias con lo persistido. El spinner va
           en este botón y no sobre el modal: lo único que tarda es este POST. #}
        <div class="d-flex justify-content-end gap-2 pt-3 mt-3 border-top"
             data-spui-items-acciones hidden>
            <button type="button" class="unraf-btn spui-btn-editar" data-spui-items-guardar>
                Guardar {{ esAlta ? 'selección' : 'cambios' }}
            </button>
        </div>
    {% endif %}
</div>
