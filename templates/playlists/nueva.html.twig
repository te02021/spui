{% extends '@SPUI/base.html.twig' %}
{% block title %}Nueva playlist — SPUI{% endblock %}

{% block body %}
<div class="row justify-content-center">
<div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
        <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nueva playlist</h1>
        <a href="{{ path('spui_cms_playlists_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
    </div>

    <div class="unraf-card p-4">
        <form method="post" action="{{ path('spui_cms_playlists_nueva') }}">
            <div class="mb-3">
                <label class="unraf-form-label">Nombre <span class="text-danger">*</span></label>
                <input type="text" name="nombre" class="unraf-form-control" required maxlength="200" placeholder="Ej: Cartelería Hall Central">
            </div>
            <div class="mb-3">
                <label class="unraf-form-label">Descripción</label>
                <textarea name="descripcion" class="unraf-form-control" rows="3" placeholder="Descripción opcional..."></textarea>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <a href="{{ path('spui_cms_playlists_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
                <button type="submit" class="unraf-btn unraf-btn-institucion">Crear y editar items →</button>
            </div>
        </form>
    </div>
</div>
</div>
{% endblock %}
