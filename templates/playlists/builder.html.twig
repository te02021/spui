{% extends '@SPUI/base.html.twig' %}
{% block title %}{{ playlist.nombre }} — Playlist Builder — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap">
    <div class="d-flex align-items-center gap-2">
        <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">{{ playlist.nombre }}</h1>
        {% if not playlist.activo %}
            <span class="spui-badge-archivado">Inactiva</span>
        {% endif %}
    </div>
    <a href="{{ path('spui_cms_playlists_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Playlists</a>
</div>

<div class="row g-4">

    {# ── Items actuales (izquierda) ── #}
    <div class="col-lg-7">
        <div class="unraf-card">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <strong>Items de la playlist</strong>
                <span class="text-muted small">{{ playlist.items|length }} item(s) · Arrastrá para reordenar</span>
            </div>

            {% if playlist.items|length == 0 %}
                <div class="p-4 text-center text-muted">
                    La playlist está vacía. Agregá contenidos desde el panel de la derecha.
                </div>
            {% else %}
                <ul id="sortable-list" class="list-unstyled mb-0">
                {% for item in playlist.items %}
                    <li class="sortable-item d-flex align-items-center gap-2 p-3 border-bottom"
                        data-item-id="{{ item.id }}">
                        <span class="item-drag-handle">
                            <img src="{{ asset('unraf-ui/icons/dots-six-vertical.svg') }}" class="unraf-icon-svg" alt="">
                        </span>
                        <span class="spui-badge-borrador" style="min-width:1.8rem;text-align:center">{{ item.orden }}</span>
                        <div class="flex-grow-1">
                            <strong>{{ item.contenido.titulo }}</strong>
                            <small class="text-muted ms-2">{{ item.contenido.tipo.value }}</small>
                        </div>
                        <span class="duracion-badge">{{ item.duracionEfectiva }}s</span>
                        <button type="button" class="unraf-btn-icon btn-delete"
                                data-confirm-url="{{ path('spui_cms_playlists_items_quitar', {id: playlist.id, itemId: item.id}) }}"
                                data-confirm-title="Quitar item"
                                data-confirm-message="¿Quitar «{{ item.contenido.titulo }}» de esta playlist?"
                                data-confirm-variant="danger"
                                title="Quitar">
                            <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="unraf-icon-svg" alt="Quitar">
                        </button>
                    </li>
                {% endfor %}
                </ul>

                <div class="p-3 text-muted small border-top">
                    Duración total: <strong>{{ playlist.items|map(i => i.duracionEfectiva)|reduce((carry, v) => carry + v, 0) }}s</strong>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Contenidos disponibles (derecha) ── #}
    <div class="col-lg-5">
        <div class="unraf-card">
            <div class="p-3 border-bottom">
                <strong>Contenidos disponibles</strong>
                <br><small class="text-muted">Solo contenidos publicados no usados en esta playlist.</small>
            </div>

            {% if disponibles|length == 0 %}
                <div class="p-4 text-center text-muted">
                    No hay más contenidos publicados para agregar.
                </div>
            {% else %}
                <div style="max-height:460px;overflow-y:auto">
                {% for c in disponibles %}
                    <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                        <div class="flex-grow-1">
                            <div>{{ c.titulo }}</div>
                            <small class="text-muted">{{ c.tipo.value }} · {{ c.duracionSegundos }}s</small>
                        </div>
                        <form method="post" action="{{ path('spui_cms_playlists_items_agregar', {id: playlist.id}) }}">
                            <input type="hidden" name="contenido_id" value="{{ c.id }}">
                            <button type="submit" class="unraf-btn unraf-btn-institucion unraf-btn-sm">+ Agregar</button>
                        </form>
                    </div>
                {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
(function () {
    var listEl = document.getElementById('sortable-list');
    if (!listEl) return;

    Sortable.create(listEl, {
        handle: '.item-drag-handle',
        ghostClass: 'sortable-ghost',
        animation: 150,
        onEnd: function () {
            var items = listEl.querySelectorAll('.sortable-item');
            var orden = Array.from(items).map(function (el) { return parseInt(el.dataset.itemId); });

            fetch('{{ path('spui_cms_playlists_items_reorder', {id: playlist.id}) }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ orden: orden }),
            }).then(function (res) {
                if (!res.ok) {
                    if (typeof mostrarToast === 'function') {
                        mostrarToast('Error al guardar el orden.', 'error');
                    }
                    return;
                }
                items.forEach(function (el, i) {
                    var badge = el.querySelector('.spui-badge-borrador');
                    if (badge) badge.textContent = i + 1;
                });
            });
        },
    });
}());
</script>
{% endblock %}
