{# Ítems de un cronograma, dentro del modal (nivel 1).

   Mismo esquema que la grilla de energía: agregar, editar y eliminar se abren
   ENCIMA, en el nivel 2 (data-spui-form2 / data-spui-action2 con
   data-spui-subvista), cada ítem se guarda al guardarlo, y al terminar esa
   capa se cierra y este listado se refresca solo. Reemplaza a la página
   aparte del "editor de cronograma".

   Todos los ítems son del mismo contenido, así que el motivo de bloqueo (algún
   reproductor que lo muestra está desconectado) se resuelve una vez y vale
   para todas las acciones. El listado se puede mirar siempre. #}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% import '@SPUI/_macros/texto.html.twig' as texto %}
{% set motivo = spui_alcance.motivoParaEntidad(contenido, ids_offline|default({})) %}

{# Zona donde el nivel 2 pinta sus confirmaciones (no puede abrir otro modal). #}
<div data-spui-confirm-host></div>

<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
    <p class="text-muted small mb-0">
        {{ texto.plural(items|length, 'ítem', 'ítems') }}{{ items|length > 1 ? ', ordenados por hora de inicio' }}. La pantalla muestra sólo los del día.
    </p>
    <button type="button" class="unraf-btn spui-btn-crear unraf-btn-sm {{ bloqueo.clase(motivo) }}"
            data-spui-form2="{{ path('spui_cms_cronograma_item_agregar', {id: contenido.id}) }}"
            data-spui-subvista
            data-spui-title="Agregar ítem"
            {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Agregar un ítem al cronograma"{% endif %}>
        <img src="{{ asset('unraf-ui/icons/plus.svg') }}" class="spui-action-icon" alt=""> Agregar ítem
    </button>
</div>

{% if items|length == 0 %}
    <div class="p-4 text-center text-muted">
        El cronograma está vacío. Agregá el primer ítem con el botón de arriba.
    </div>
{% else %}
    {% set diasNombres = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'] %}
    {# Buscador y filtros (02/11/2026): se resuelven en el navegador, sobre las
       filas que ya están acá (core/cronograma-items.js), así responden al
       instante; con un Excel importado son cientos. Se recuerdan al volver
       de agregar o editar un ítem. #}
    <div class="spui-barra-lista spui-items-filtros" data-spui-items-filtros data-contenido="{{ contenido.id }}">
        <div class="spui-buscador" role="search">
            <label class="visually-hidden" for="items-buscar-{{ contenido.id }}">Buscar por materia, aula o docente</label>
            <img src="{{ asset('unraf-ui/icons/magnifying-glass.svg') }}" class="spui-buscador-lupa" alt="">
            <input type="search" id="items-buscar-{{ contenido.id }}" class="spui-buscador-campo" data-spui-items-buscar
                   placeholder="Buscar por materia, aula o docente" maxlength="100" autocomplete="off" spellcheck="false">
            <button type="button" class="spui-buscador-limpiar" data-spui-items-limpiar aria-label="Limpiar búsqueda" hidden>×</button>
        </div>
        <nav class="spui-filtros" aria-label="Filtros de los ítems">
            {% for f in [{c: 'dia', e: 'Día', v: 'Todos'}, {c: 'fecha', e: 'Fecha', v: 'Todas'}, {c: 'hora', e: 'Hora', v: 'Todas'}] %}
                <span class="spui-desp">
                    <button type="button" class="spui-selector" data-spui-desp data-spui-items-selector="{{ f.c }}"
                            aria-expanded="false" aria-controls="items-{{ f.c }}-{{ contenido.id }}">
                        <span class="spui-selector-etiqueta">{{ f.e }}</span>
                        <span class="spui-selector-valor" data-spui-items-valor>{{ f.v }}</span>
                        <img src="{{ asset('unraf-ui/icons/caret-down.svg') }}" class="spui-selector-flecha" alt="">
                    </button>
                    <div id="items-{{ f.c }}-{{ contenido.id }}" class="spui-desp-panel spui-selector-menu" role="region" aria-label="{{ f.e }}">
                        {% if f.c == 'fecha' %}
                            {# Lo que se da ese día: las clases de ese día de la semana y los eventos de esa fecha. #}
                            <div class="spui-items-fecha">
                                <label class="unraf-form-label mb-1" for="items-fecha-in-{{ contenido.id }}">Lo que se da el día</label>
                                <input type="date" id="items-fecha-in-{{ contenido.id }}" class="unraf-form-control" data-spui-items-fecha>
                                <button type="button" class="spui-selector-opcion" data-spui-items-op="fecha" data-valor="">
                                    <span class="spui-selector-check" aria-hidden="true">✓</span><span class="spui-selector-texto">Todas las fechas</span>
                                </button>
                            </div>
                        {% elseif f.c == 'hora' %}
                            {# Selector de hora y minuto (03/11/2026, pedido de Mateo): dos
                               columnas que se desplazan, de 1 en 1, y Aplicar. Muestra lo que
                               está en curso a esa hora exacta. Las columnas las llena
                               cronograma-items.js. #}
                            <div class="spui-reloj" data-spui-reloj>
                                <p class="spui-reloj-ayuda">Lo que está en curso a las</p>
                                <div class="spui-reloj-columnas">
                                    <div class="spui-reloj-col" data-spui-reloj-col="h" role="listbox" aria-label="Hora" tabindex="0"></div>
                                    <span class="spui-reloj-sep" aria-hidden="true">:</span>
                                    <div class="spui-reloj-col" data-spui-reloj-col="m" role="listbox" aria-label="Minutos" tabindex="0"></div>
                                </div>
                                <button type="button" class="spui-reloj-ahora" data-spui-reloj-ahora>Ahora</button>
                                <div class="spui-reloj-acciones">
                                    <button type="button" class="unraf-btn spui-btn-back unraf-btn-sm" data-spui-reloj-cancelar>Cancelar</button>
                                    <button type="button" class="unraf-btn spui-btn-crear unraf-btn-sm" data-spui-reloj-aplicar>Aplicar</button>
                                </div>
                                <button type="button" class="spui-selector-opcion" data-spui-items-op="hora" data-valor="">
                                    <span class="spui-selector-check" aria-hidden="true">✓</span><span class="spui-selector-texto">Todas las horas</span>
                                </button>
                            </div>
                        {% else %}
                            {# Las opciones las arma cronograma-items.js, con sus cantidades. #}
                            <ul class="spui-desp-lista" data-spui-items-opciones="{{ f.c }}"></ul>
                        {% endif %}
                    </div>
                </span>
            {% endfor %}
        </nav>
    </div>
    <p class="text-muted small mb-2" data-spui-items-cuenta aria-live="polite"></p>

    <div class="unraf-table-responsive">
        <table class="unraf-table unraf-table-striped w-100 spui-tabla-cards">
            <thead>
                <tr>
                    <th class="p-3">Hora</th>
                    <th class="p-3">Materia o actividad</th>
                    <th class="p-3">Aula</th>
                    <th class="p-3">Cuándo</th>
                    <th class="p-3">Estado</th>
                    <th class="p-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                {# Lo que necesitan los filtros (cronograma-items.js). #}
                <tr data-spui-item
                    data-dias="{{ item.diasSemana }}"
                    data-fecha="{{ item.tipo.tieneFecha and item.fecha ? item.fecha|date('Y-m-d') }}"
                    data-inicio="{{ item.horaInicio ? item.horaInicio|date('H:i') }}"
                    data-fin="{{ item.horaFin ? item.horaFin|date('H:i') }}"
                    data-buscar="{{ [item.nombre, item.aula, item.docente]|filter(x => x)|join(' ')|lower }}">
                    <td class="p-3 text-nowrap" data-label="Hora">
                        <strong>{{ item.horaInicio|date('H:i') }}</strong>
                        {% if item.horaFin %}<span class="text-muted"> – {{ item.horaFin|date('H:i') }}</span>{% else %}<span class="text-muted"> en adelante</span>{% endif %}
                    </td>
                    <td class="p-3" data-label="Materia o actividad">
                        <strong>{{ item.nombre }}</strong>
                        {% if item.tipo.value != 'clase' %}<span class="spui-item-tipo spui-item-tipo-{{ item.tipo.value }}">{{ item.tipo.etiqueta }}</span>{% endif %}
                        {% set meta = [item.carrera, item.anio]|filter(x => x) %}
                        {% if meta or item.docente %}
                            <small class="text-muted d-block">{{ meta|join(' · ') }}{{ meta and item.docente ? ' — ' }}{{ item.docente }}</small>
                        {% endif %}
                    </td>
                    <td class="p-3" data-label="Aula">{{ item.aula ?? '—' }}</td>
                    <td class="p-3" data-label="Cuándo">
                        {% if item.tipo.tieneFecha %}
                            <span class="spui-fecha-badge">{{ item.fecha ? item.fecha|date('d/m/Y') : 'Sin fecha' }}</span>
                        {% else %}
                            <div class="d-flex gap-1 flex-wrap">
                                {% for i in 0..6 %}
                                    {% if (item.diasSemana b-and (2 ** i)) != 0 %}
                                        <span class="spui-dia-badge spui-dia-activo">{{ diasNombres[i] }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </td>
                    <td class="p-3" data-label="Estado">
                        {% if item.activo %}
                            <span class="spui-badge-publicado">Activo</span>
                        {% else %}
                            <span class="spui-badge-archivado">Inactivo</span>
                        {% endif %}
                    </td>
                    <td class="p-3" data-label="Acciones">
                        <div class="spui-acciones">
                            <button type="button" class="unraf-btn spui-btn-editar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                    data-spui-form2="{{ path('spui_cms_cronograma_item_editar', {id: contenido.id, itemId: item.id}) }}"
                                    data-spui-subvista
                                    data-spui-title="Editar: {{ item.nombre }}"
                                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Editar"{% endif %}>
                                <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt=""> Editar
                            </button>
                            {# Atajo del switch "Estado" del formulario: mismo cambio. #}
                            <button type="button"
                                    class="unraf-btn unraf-btn-sm {{ item.activo ? 'spui-btn-desactivar' : 'spui-btn-activar' }} {{ bloqueo.clase(motivo) }}"
                                    data-spui-action2="{{ path('spui_cms_cronograma_item_toggle', {id: contenido.id, itemId: item.id}) }}"
                                    data-spui-title="{{ item.activo ? 'Desactivar' : 'Activar' }} ítem"
                                    data-spui-message="{{ item.activo ? '¿Desactivar «' ~ item.nombre ~ '»? Deja de mostrarse en la pantalla.' : '¿Activar «' ~ item.nombre ~ '»? Vuelve a mostrarse en la pantalla.' }}"
                                    data-spui-variant="{{ item.activo ? 'desactivar' : 'activar' }}"
                                    data-spui-confirm-label="{{ item.activo ? 'Desactivar' : 'Activar' }}"
                                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="{{ item.activo ? 'Desactivar' : 'Activar' }}"{% endif %}>
                                <img src="{{ item.activo ? asset('unraf-ui/icons/hand-palm.svg') : asset('unraf-ui/icons/lightning.svg') }}" class="spui-action-icon" alt="">
                                {{ item.activo ? 'Desactivar' : 'Activar' }}
                            </button>
                            <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                                    data-spui-action2="{{ path('spui_cms_cronograma_item_eliminar', {id: contenido.id, itemId: item.id}) }}"
                                    data-spui-title="Eliminar ítem"
                                    data-spui-message="¿Eliminar «{{ item.nombre }}»? Esta acción no se puede deshacer."
                                    data-spui-variant="eliminar"
                                    data-spui-confirm-label="Eliminar"
                                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Eliminar"{% endif %}>
                                <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
                            </button>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {# 25 por página, sobre lo que dejan los filtros (03/11/2026): la arma
       cronograma-items.js con los mismos estilos que la de los listados. #}
    <nav class="spui-paginacion" data-spui-items-paginas aria-label="Páginas de los ítems" hidden></nav>
    <div class="spui-items-vacio" data-spui-items-vacio hidden>
        <strong>Ningún ítem coincide</strong>
        <span>Probá con otra búsqueda u otro filtro.</span>
        <button type="button" class="unraf-btn spui-btn-back unraf-btn-sm" data-spui-items-quitar-filtros>Quitar filtros</button>
    </div>
{% endif %}
