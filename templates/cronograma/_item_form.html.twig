{# Alta y edición de un ítem del cronograma (rediseñado el 05/11/2026). Los datos son los
   del Excel de horarios. Una clase o actividad se repite los días marcados; un evento
   especial ocurre una vez, en su fecha: content-type-fields.js muestra días o fecha según
   el tipo (data-spui-si-tipo-item).

   Variables: action_url, v (valores), err (name → mensaje), boton (clase del Guardar). #}
{% import '@SPUI/_macros/form.html.twig' as f %}
<form method="post" action="{{ action_url }}" class="spui-form" data-spui-ajax="1" novalidate data-spui-item-cronograma>
    <input type="hidden" name="_token" value="{{ csrf_token('spui_action') }}">
    {% set v = v|default({}) %}
    {% set err = err|default({}) %}
    {% set tipo = v.tipo_item ?? 'clase' %}

    <section class="spui-ver-seccion" aria-labelledby="spui-form-actividad">
        <h5 class="spui-ver-titulo" id="spui-form-actividad">Actividad</h5>
        <div class="spui-ver-bloque">
            <div class="spui-form-fila spui-form-fila-item">
                <div>
                    <span class="unraf-form-label d-block" id="ci_tipo_lbl">Tipo</span>
                    <div class="spui-opciones" role="radiogroup" aria-labelledby="ci_tipo_lbl">
                        {% for op in enum('SPUI\\Enum\\TipoItemCronograma').cases() %}
                            <input type="radio" class="spui-opcion-input" name="tipo_item" id="ci_tipo_{{ op.value }}"
                                   value="{{ op.value }}" {{ tipo == op.value ? 'checked' }}>
                            <label class="spui-opcion" for="ci_tipo_{{ op.value }}">{{ op.etiqueta }}</label>
                        {% endfor %}
                    </div>
                </div>
                <div>{{ f.estado_html('ci_activo', 'activo', '1', v.activo ?? true, 'Activo', 'Inactivo') }}</div>
            </div>

            <div class="spui-form-separado spui-form-fila spui-form-fila-dato">
                <div>
                    <label class="unraf-form-label" for="ci_nombre">Materia o actividad</label>
                    <input type="text" id="ci_nombre" name="nombre" class="unraf-form-control{{ err.nombre is defined ? ' is-invalid' }}"
                           value="{{ v.nombre ?? '' }}" maxlength="200" placeholder="Ej: Análisis Matemático I" required>
                    {% if err.nombre is defined %}<p class="spui-campo-error">{{ err.nombre }}</p>{% endif %}
                </div>
                <div>
                    <label class="unraf-form-label" for="ci_aula">Aula o espacio (opcional)</label>
                    <input type="text" id="ci_aula" name="aula" class="unraf-form-control{{ err.aula is defined ? ' is-invalid' }}"
                           value="{{ v.aula ?? '' }}" maxlength="100" placeholder="Ej: 6 A / Lab. ECA">
                    {% if err.aula is defined %}<p class="spui-campo-error">{{ err.aula }}</p>{% endif %}
                </div>
            </div>

            <div class="spui-form-separado spui-form-fila spui-form-fila-docente">
                <div>
                    <label class="unraf-form-label" for="ci_carrera">Carrera (opcional)</label>
                    <input type="text" id="ci_carrera" name="carrera" class="unraf-form-control{{ err.carrera is defined ? ' is-invalid' }}"
                           value="{{ v.carrera ?? '' }}" maxlength="60" placeholder="Ej: AGI">
                    {% if err.carrera is defined %}<p class="spui-campo-error">{{ err.carrera }}</p>{% endif %}
                </div>
                <div>
                    <label class="unraf-form-label" for="ci_anio">Año (opcional)</label>
                    <input type="text" id="ci_anio" name="anio" class="unraf-form-control{{ err.anio is defined ? ' is-invalid' }}"
                           value="{{ v.anio ?? '' }}" maxlength="40" placeholder="Ej: 2.º">
                    {% if err.anio is defined %}<p class="spui-campo-error">{{ err.anio }}</p>{% endif %}
                </div>
                <div>
                    <label class="unraf-form-label" for="ci_docente">Docente o responsable (opcional)</label>
                    <input type="text" id="ci_docente" name="docente" class="unraf-form-control{{ err.docente is defined ? ' is-invalid' }}"
                           value="{{ v.docente ?? '' }}" maxlength="255" placeholder="Ej: Ariado, L. / Bianchini, C.">
                    {% if err.docente is defined %}<p class="spui-campo-error">{{ err.docente }}</p>{% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-form-cuando">
        <h5 class="spui-ver-titulo" id="spui-form-cuando">Cuándo</h5>
        <div class="spui-ver-bloque">
            <div class="spui-form-fila spui-form-fila-3">
                <div class="spui-fecha-field">
                    <label class="unraf-form-label" for="ci_hi">Hora de inicio</label>
                    <input type="time" id="ci_hi" name="hora_inicio" class="unraf-form-control{{ err.hora_inicio is defined ? ' is-invalid' }}"
                           value="{{ v.hora_inicio ?? '' }}" required>
                    {% if err.hora_inicio is defined %}<p class="spui-campo-error">{{ err.hora_inicio }}</p>{% endif %}
                </div>
                <div class="spui-fecha-field">
                    {# Sin required: en un evento puede quedar vacía (lo valida el servidor). #}
                    <label class="unraf-form-label" for="ci_hf">Hora de fin</label>
                    <input type="time" id="ci_hf" name="hora_fin" class="unraf-form-control{{ err.hora_fin is defined ? ' is-invalid' }}"
                           value="{{ v.hora_fin ?? '' }}"
                           data-spui-validar-posterior="#ci_hi"
                           data-spui-validar-mensaje="{{ constant('SPUI\\Controller\\Cms\\CronogramaCmsController::MSG_FIN_POSTERIOR') }}">
                    {% if err.hora_fin is defined %}<p class="spui-campo-error">{{ err.hora_fin }}</p>{% endif %}
                    <small class="spui-form-ayuda" data-spui-si-tipo-item="evento" {{ tipo != 'evento' ? 'hidden' }}>Opcional en un evento: se muestra "Desde las…".</small>
                </div>
                <div class="spui-fecha-field" data-spui-si-tipo-item="evento" {{ tipo != 'evento' ? 'hidden' }}>
                    <label class="unraf-form-label" for="ci_fecha">Fecha</label>
                    <input type="date" id="ci_fecha" name="fecha" class="unraf-form-control{{ err.fecha is defined ? ' is-invalid' }}" value="{{ v.fecha ?? '' }}">
                    {% if err.fecha is defined %}<p class="spui-campo-error">{{ err.fecha }}</p>{% endif %}
                </div>
            </div>

            <div class="spui-form-separado" data-spui-campo data-spui-si-tipo-item="clase actividad" {{ tipo == 'evento' ? 'hidden' }}>
                <span class="unraf-form-label d-block">Días de la semana</span>
                <div class="spui-form-dias{{ err.dias is defined ? ' is-invalid' }}"
                     data-spui-requiere-alguno="{{ constant('SPUI\\Form\\ProgramacionType::MSG_DIAS_REQUERIDOS') }}">
                    {% set diasActivos = v.dias ?? [0, 1, 2, 3, 4] %}
                    {% for label, bit in {'Lun': 0, 'Mar': 1, 'Mié': 2, 'Jue': 3, 'Vie': 4, 'Sáb': 5, 'Dom': 6} %}
                        <div>
                            <input type="checkbox" class="spui-opcion-input" name="dias[]" id="ci_dia_{{ bit }}" value="{{ bit }}" {{ bit in diasActivos ? 'checked' }}>
                            <label class="spui-form-dia" for="ci_dia_{{ bit }}">{{ label }}</label>
                        </div>
                    {% endfor %}
                </div>
                {% if err.dias is defined %}<p class="spui-campo-error">{{ err.dias }}</p>{% endif %}
            </div>
        </div>
    </section>

    {{ f.pie(boton|default('spui-btn-crear')) }}
</form>
