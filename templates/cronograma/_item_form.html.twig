{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

{% set swActivoId = form.activo.vars.id %}

<div class="row g-2 mb-3">
    <div class="col-12 col-sm">
        {{ form_label(form.nombre) }}
        {{ form_widget(form.nombre) }}
        {% for e in form.nombre.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm">
        {{ form_label(form.aula) }}
        {{ form_widget(form.aula) }}
        {% for e in form.aula.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 spui-hora-field">
        {{ form_label(form.horaInicio) }}
        {{ form_widget(form.horaInicio) }}
        {% for e in form.horaInicio.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-6 spui-hora-field">
        {{ form_label(form.horaFin) }}
        {{ form_widget(form.horaFin) }}
        {% for e in form.horaFin.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.diasSemana) }}
    <div class="spui-dias-switches mt-2">
        {% for child in form.diasSemana %}
            <div class="spui-dia-switch">
                {{ form_label(child, null, {'label_attr': {'class': 'spui-dia-label'}}) }}
                <div class="form-switch d-flex justify-content-center">
                    {{ form_widget(child, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div class="row g-3 mb-4 align-items-end">
    <div class="col">
        {{ form_label(form.orden) }}
        {{ form_widget(form.orden) }}
        {% for e in form.orden.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-auto d-flex flex-column pb-1">
        <label class="unraf-form-label mb-1">Estado</label>
        <div class="d-flex align-items-center gap-2">
            <div class="form-switch m-0">
                {{ form_widget(form.activo, {'attr': {'class': 'form-check-input spui-switch-input', 'role': 'switch', 'data-spui-switch': '1', 'data-switch-on': 'Activo', 'data-switch-off': 'Inactivo'}}) }}
            </div>
            <span class="spui-switch-status on" id="{{ swActivoId }}_lbl">Activo</span>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn spui-btn-editar">Guardar</button>
</div>

{{ form_end(form) }}
