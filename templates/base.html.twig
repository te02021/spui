<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# Leído una vez por modal.js para los POST de un solo botón (activar/eliminar/
       toggle/etc.) que no pasan por un Symfony Form — ver CsrfProtegidoTrait. #}
    <meta name="spui-csrf-token" content="{{ csrf_token('spui_action') }}">
    {# Sidebar plegado (30/10/2026): se aplica antes de pintar, para que no
       aparezca abierto un instante y se cierre. La elección la guarda sidebar.js. #}
    <script>try { if (localStorage.getItem('spui.sidebar.plegado') === '1') document.documentElement.classList.add('spui-sidebar-plegado'); } catch (e) {}</script>
    <title>{% block title %}SPUI — Pantallas Digitales{% endblock %} | UNRaf</title>
    <meta name="description" content="{% block descripcion %}SPUI, Sistema de Pantallas Informativas Universitarias de la UNRaf: administración de la cartelería digital del campus.{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🖥️</text></svg>">

    {% block stylesheets %}
        {{ importmap('spuiMap') }}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('unraf-ui/css/unraf-estilos.min.css') }}">
        <link rel="stylesheet" href="{{ asset('spui/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('spui/css/pantalla-tv.css') }}">
    {% endblock %}
</head>
<body>
<div class="unraf-dashboard">

    {# ── Header ── #}
    {# Encabezado (30/10/2026): la marca a la izquierda; a la derecha el menú
       del usuario (iniciales + nombre armado con el email, que es el único
       dato que trae el usuario de la Intranet). El menú es un desplegable
       (core/desplegable.js), como el resto del CMS, y su única salida es
       volver a la Intranet: el CMS no tiene cierre de sesión propio. #}
    {% set email = app.user ? app.user.userIdentifier : '' %}
    {% set partes = (email|split('@')|first)|replace({'_': '.', '-': '.'})|split('.')|filter(p => p != '') %}
    {% set nombre_usuario = partes|map(p => p|capitalize)|join(' ') %}
    {% set iniciales = (partes|slice(0, 2)|map(p => p|first|upper)|join('')) ?: '?' %}
    <header class="unraf-header spui-header">
        <div class="spui-header-izq">
            <button id="btnMenuToggle" class="unraf-menu-toggle" aria-label="Abrir el menú de secciones" aria-controls="spui-sidebar">
                <img src="{{ asset('unraf-ui/icons/list.svg') }}" alt="">
            </button>
            <a href="{{ path('spui_cms_dashboard') }}" class="spui-header-marca" aria-label="SPUI — ir al Dashboard">
                <img src="{{ asset('unraf-ui/icons/UNRaf-transparente.png') }}" alt="UNRaf" class="spui-header-logo">
                <span class="spui-header-divisor" aria-hidden="true"></span>
                <span class="spui-header-titulo">
                    <strong>SPUI</strong>
                    <small>Sistema de Pantallas Digitales</small>
                </span>
            </a>
        </div>
        <div class="spui-header-der">
            {% if app.user %}
                <span class="spui-desp spui-usuario">
                    <button type="button" class="spui-usuario-btn" data-spui-desp aria-expanded="false" aria-controls="spui-menu-usuario"
                            aria-label="Cuenta de {{ nombre_usuario ?: email }}">
                        <span class="spui-avatar" aria-hidden="true">{{ iniciales }}</span>
                        <span class="spui-usuario-nombre">{{ nombre_usuario ?: email }}</span>
                        <img src="{{ asset('unraf-ui/icons/caret-down.svg') }}" class="spui-usuario-flecha" alt="">
                    </button>
                    <div id="spui-menu-usuario" class="spui-desp-panel spui-usuario-menu" role="region" aria-label="Cuenta">
                        <div class="spui-usuario-cab">
                            <span class="spui-avatar spui-avatar-grande" aria-hidden="true">{{ iniciales }}</span>
                            <span class="min-w-0"><strong>{{ nombre_usuario ?: email }}</strong><small>{{ email }}</small></span>
                        </div>
                        <ul class="spui-desp-lista">
                            <li><a class="spui-selector-opcion" href="{{ path('sistemas') }}"><img src="{{ asset('unraf-ui/icons/arrow-left.svg') }}" alt="" class="spui-usuario-icono"> Volver a la Intranet</a></li>
                        </ul>
                    </div>
                </span>
            {% endif %}
        </div>
    </header>

    <div class="unraf-body-wrapper">

        {# ── Sidebar ── #}
        <aside id="spui-sidebar" class="unraf-sidebar d-flex flex-column" aria-label="Secciones del CMS">
            <div class="flex-grow-1">
                <p class="unraf-nav-separator">Principal</p>
                <a href="{{ path('spui_cms_dashboard') }}" class="unraf-nav-item {{ app.request.get('_route') == 'spui_cms_dashboard' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/chart-pie.svg') }}" class="unraf-icon-svg" alt=""> Dashboard
                </a>

                <p class="unraf-nav-separator">Infraestructura</p>
                <a href="{{ path('spui_cms_edificios_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_edificios' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/buildings.svg') }}" class="unraf-icon-svg" alt=""> Edificios
                </a>
                <a href="{{ path('spui_cms_ubicaciones_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_ubicaciones' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/map-pin.svg') }}" class="unraf-icon-svg" alt=""> Ubicaciones
                </a>
                <a href="{{ path('spui_cms_reproductores_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_reproductores' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/cpu.svg') }}" class="unraf-icon-svg" alt=""> Reproductores
                </a>
                <a href="{{ path('spui_cms_pantallas_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_pantallas' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/monitor.svg') }}" class="unraf-icon-svg" alt=""> Pantallas
                </a>

                <p class="unraf-nav-separator">Contenido</p>
                <a href="{{ path('spui_cms_contenidos_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_contenidos' or app.request.get('_route') starts with 'spui_cms_cronograma' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/image.svg') }}" class="unraf-icon-svg" alt=""> Contenidos
                </a>
                <a href="{{ path('spui_cms_playlists_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_playlists' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/playlist.svg') }}" class="unraf-icon-svg" alt=""> Playlists
                </a>
                <a href="{{ path('spui_cms_programacion_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_programacion' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" class="unraf-icon-svg" alt=""> Programación
                </a>

                <p class="unraf-nav-separator">Operaciones</p>
                <a href="{{ path('spui_cms_alertas_index') }}" class="unraf-nav-item {{ app.request.get('_route') starts with 'spui_cms_alertas' ? 'active' : '' }}">
                    <img src="{{ asset('unraf-ui/icons/warning.svg') }}" class="unraf-icon-svg" alt=""> Alertas
                </a>
            </div>
            <div class="d-md-none p-2 mt-4">
                <a href="{{ path('sistemas') }}" class="unraf-nav-item nav-item-intranet">
                    <img src="{{ asset('unraf-ui/icons/arrow-left.svg') }}" class="unraf-icon-svg" alt=""> Intranet
                </a>
            </div>
        </aside>

        {# Plegar/desplegar el sidebar (sólo escritorio; en celular sigue la
           hamburguesa del header). Fixed: abierto queda a la derecha de
           "Principal"; cerrado flota arriba a la izquierda, sin ocupar lugar. #}
        <button type="button" id="spui-sidebar-plegar" class="spui-sidebar-plegar"
                aria-controls="spui-sidebar" aria-expanded="true" aria-label="Ocultar menú" title="Ocultar menú">
            <img src="{{ asset('unraf-ui/icons/caret-double-left.svg') }}" alt="">
        </button>

        <div id="sidebarOverlay" class="unraf-sidebar-overlay"></div>

        {# ── Flash messages ── #}
        <div class="flash-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} fade show" role="alert">
                        <button type="button" class="flash-close-btn" aria-label="Cerrar">&times;</button>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="unraf-main-content d-flex flex-column min-vh-100">
            <main class="flex-grow-1 {% block main_class %}p-4{% endblock %}">
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
</div>

{# Pie (30/10/2026): marca, accesos a las secciones y la universidad; abajo,
   los créditos. Tres columnas en escritorio, apiladas en celular. #}
<footer class="unraf-footer spui-footer">
    <div class="spui-footer-cuerpo">
        <div class="spui-footer-marca">
            <a href="{{ path('spui_cms_dashboard') }}" class="spui-footer-logo" aria-label="SPUI — ir al Dashboard">
                <img src="{{ asset('unraf-ui/icons/UNRaf-transparente.png') }}" alt="" width="40" height="40">
                <span>
                    <strong>SPUI</strong>
                    <small>Sistema de Pantallas Informativas Universitarias</small>
                </span>
            </a>
            <p>Gestión de la cartelería digital del campus: contenidos, programación, alertas de emergencia y estado de cada pantalla, en tiempo real.</p>
        </div>

        <nav class="spui-footer-col" aria-labelledby="pie-secciones">
            <h2 id="pie-secciones">Secciones</h2>
            <ul>
                <li><a href="{{ path('spui_cms_dashboard') }}">Dashboard</a></li>
                <li><a href="{{ path('spui_cms_pantallas_index') }}">Pantallas</a></li>
                <li><a href="{{ path('spui_cms_contenidos_index') }}">Contenidos</a></li>
                <li><a href="{{ path('spui_cms_programacion_index') }}">Programación</a></li>
                <li><a href="{{ path('spui_cms_alertas_index') }}">Alertas</a></li>
            </ul>
        </nav>

        <div class="spui-footer-col">
            <h2>Universidad</h2>
            <ul>
                <li><a href="https://www.unraf.edu.ar" target="_blank" rel="noopener">Universidad Nacional de Rafaela <img src="{{ asset('unraf-ui/icons/arrow-square-out.svg') }}" alt="(se abre en otra pestaña)" class="spui-footer-externo"></a></li>
                <li><a href="{{ path('sistemas') }}">Volver a la Intranet</a></li>
                <li><span>Departamento de Desarrollo</span></li>
            </ul>
        </div>
    </div>
    <div class="spui-footer-base">
        <span>&copy; {{ "now"|date("Y") }} Universidad Nacional de Rafaela</span>
        <span>SPUI · Departamento de Desarrollo</span>
    </div>
</footer>

{# ── Modal ABM unificado ── #}
<div class="spui-abm-overlay" id="spuiAbmOverlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="spuiAbmTitle">
    <div class="spui-abm-modal" id="spuiAbmModal">
        <div class="spui-abm-modal-header">
            <h4 class="spui-abm-modal-title" id="spuiAbmTitle"></h4>
            <button type="button" class="spui-abm-modal-close" id="spuiAbmClose" aria-label="Cerrar">&times;</button>
        </div>
        <div class="spui-abm-modal-body" id="spuiAbmBody"></div>
    </div>
</div>

{# ── Modal ABM de segundo nivel ──
   Se abre ENCIMA del anterior sin cerrarlo (ej: "Ver ítems" desde el modal de
   edición de una playlist). Es un overlay gemelo con IDs propios, no una pila
   genérica: el sistema sólo necesita dos capas y el motor del nivel 1 queda sin
   tocar. Ver el bloque "segundo nivel" en spui/js/core/modal.js. #}
<div class="spui-abm-overlay spui-abm-overlay-2" id="spuiAbmOverlay2" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="spuiAbmTitle2">
    <div class="spui-abm-modal" id="spuiAbmModal2">
        <div class="spui-abm-modal-header">
            <h4 class="spui-abm-modal-title" id="spuiAbmTitle2"></h4>
            <button type="button" class="spui-abm-modal-close" id="spuiAbmClose2" aria-label="Cerrar">&times;</button>
        </div>
        <div class="spui-abm-modal-body" id="spuiAbmBody2"></div>
    </div>
</div>

{# ── JS núcleo (usado por todos los templates) ── #}
<script src="{{ asset('spui/js/core/badge-contraste.js') }}"></script>
<script src="{{ asset('spui/js/core/helpers.js') }}"></script>
<script src="{{ asset('spui/js/core/sidebar.js') }}"></script>
<script src="{{ asset('spui/js/core/switch-toggle.js') }}"></script>
<script src="{{ asset('spui/js/core/range-input.js') }}"></script>
<script src="{{ asset('spui/js/core/duracion-minutos.js') }}"></script>
<script src="{{ asset('spui/js/core/list-filter.js') }}"></script>
<script src="{{ asset('spui/js/core/content-type-fields.js') }}"></script>
<script src="{{ asset('spui/js/core/alerta-sonido-field.js') }}"></script>
<script src="{{ asset('spui/js/core/contenido-archivo-field.js') }}"></script>
{# Antes que validacion-vivo.js: al elegir otro video, tiene que borrar la marca
   de inválido del anterior antes de que validacion-vivo.js revise el campo. #}
<script src="{{ asset('spui/js/core/video-archivo.js') }}"></script>
<script src="{{ asset('spui/js/core/validacion-vivo.js') }}"></script>
{# Después de validacion-vivo.js: el archivo se envía sólo si pasó sus reglas. #}
<script src="{{ asset('spui/js/core/importar-cronograma.js') }}"></script>
{# AssetMapper versiona los .svg con un hash: media-viewer.js no puede
   armar esas URLs por su cuenta, así que se las pasamos acá. #}
<script>
    window.spui = window.spui || {};
    window.spui.iconos = {
        magnifyingGlassPlus: "{{ asset('unraf-ui/icons/magnifying-glass-plus.svg') }}",
        magnifyingGlassMinus: "{{ asset('unraf-ui/icons/magnifying-glass-minus.svg') }}",
        download: "{{ asset('unraf-ui/icons/download.svg') }}",
        x: "{{ asset('unraf-ui/icons/x.svg') }}"
    };
</script>
{# Vista previa del TV (pantalla/_tv.html.twig); el visor la usa en su pestaña "En pantalla". #}
<script src="{{ asset('spui/js/core/vista-tv.js') }}"></script>
<script src="{{ asset('spui/js/core/media-viewer.js') }}"></script>
<script src="{{ asset('spui/js/core/modal.js') }}"></script>

{# Refresco de datos que cambian solos. auto-refresh va DESPUÉS de modal.js
   porque usa window.spui.bindTableButtons para reasociar los botones del HTML
   que acaba de reemplazar. #}
<script src="{{ asset('spui/js/core/tiempo-relativo.js') }}"></script>
<script src="{{ asset('spui/js/core/auto-refresh.js') }}"></script>
<script src="{{ asset('spui/js/core/desplegable.js') }}"></script>
<script src="{{ asset('spui/js/core/lista-acciones.js') }}"></script>
<script src="{{ asset('spui/js/core/busqueda-lista.js') }}"></script>

{# SortableJS + la lista de ítems de playlist. Van acá y no en la página del
   listado porque la lista vive dentro de un modal, que se abre desde cualquier
   lado; antes se cargaban en la página builder, que ya no existe.
   items.js reemplazó a builder.js: aquel mandaba cada reordenamiento al
   servidor apenas se soltaba el ítem, y ahora nada se persiste hasta Guardar. #}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="{{ asset('spui/js/playlists/items.js') }}"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
