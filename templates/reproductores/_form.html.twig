{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

<div class="row g-3 mb-3">
    <div class="col-12 col-sm">
        {{ form_label(form.hostname) }}
        {{ form_widget(form.hostname) }}
        {% for e in form.hostname.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm">
        {{ form_label(form.versionFirmware) }}
        {{ form_widget(form.versionFirmware) }}
        {% for e in form.versionFirmware.vars.errors %}
            <p class="text-danger small mt-1">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

{% if reproductor is not defined or not reproductor.id %}
    <div class="alert alert-info mb-4" style="font-size:.875rem">
        <strong>Clave API:</strong> Se generará automáticamente. Aparecerá una sola vez al crear el reproductor — guardála en un lugar seguro.
    </div>
{% endif %}

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn {{ reproductor is defined and reproductor.id ? 'spui-btn-editar' : 'spui-btn-crear' }}">
        Guardar
    </button>
</div>

{{ form_end(form) }}
