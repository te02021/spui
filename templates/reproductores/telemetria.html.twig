{% extends '@SPUI/base.html.twig' %}
{% block title %}Telemetría — {{ reproductor.hostname }} — SPUI{% endblock %}

{#
  Telemetría de un reproductor (rehecha el 29/10/2026, pedido de Mateo).

  - Gráficos con ECharts (canvas), COPIADO en assets/spui/vendor/echarts y no
    por CDN: la red del campus puede no tener salida a internet. Se cambió de
    ApexCharts porque éste redibuja el SVG entero en cada movimiento y el
    arrastre y el zoom se sentían trabados. Temperatura, RAM y disco van en
    gráficos separados con escala fija (°C, %, GB): un eje doble haría que dos
    series se vean comparables sin serlo.
  - Histórico: trae los últimos 60 días; 24 h / 7 d / 30 d eligen la ventana
    de los tres. Arrastrar mueve la vista, la rueda del mouse hace zoom (suave,
    centrado en el puntero). Cada gráfico es independiente: lo que se hace en
    uno no mueve a los otros. Nunca más allá de ahora.
  - En vivo: mientras la página está abierta, la Pi publica temperatura y RAM
    cada 1 s por MQTT directo al navegador (no se guarda). El panel tiene su
    lugar reservado desde el principio, con un spinner, para que no empuje la
    página al llegar el primer dato. Sin broker alcanzable no aparece.
  - Exportar: botón del encabezado → modal estándar con formato (Excel, CSV,
    PDF) y rango de fechas, hasta export_dias días atrás.
#}

{% import '@SPUI/_macros/graficos.html.twig' as t %}

{% block body %}
{% set cfg_vivo = spui_mqtt_web.paraNavegador(app.request, topic_vivo) %}

<div id="spui-telemetria"
     data-url-datos="{{ path('spui_cms_reproductores_telemetria_datos', {id: reproductor.id}) }}"
     data-url-vivo="{{ path('spui_cms_reproductores_telemetria_vivo', {id: reproductor.id}) }}"
     data-umbral="{{ temp_umbral }}"
     data-vivo-seg="{{ vivo_seg }}"
     data-hostname="{{ reproductor.hostname }}"
     {# Con el reproductor desconectado, el modo en vivo no le pide nada: espera
        el aviso de que volvió (spui/cms/conexion/{id}, ConexionPublisherService). #}
     data-conectado="{{ reproductor.estadoCalculado(spui_umbral_conexion).value == 'conectado' ? '1' : '0' }}"
     data-mqtt-topic-conexion="{{ constant('SPUI\\Service\\ConexionPublisherService::TOPIC_BASE') ~ reproductor.id }}"
     {% if cfg_vivo %}
     data-mqtt-url="{{ cfg_vivo.url }}"
     data-mqtt-usuario="{{ cfg_vivo.usuario }}"
     data-mqtt-password="{{ cfg_vivo.password }}"
     data-mqtt-topic="{{ cfg_vivo.topic }}"
     {% endif %}>

<div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap spui-header-actions">
    <div>
        <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">
            {{ reproductor.hostname }}
        </h1>
        <p class="text-muted mb-0 small">
            Telemetría del reproductor
            {% for p in reproductor.pantallas %}· {{ p.nombre }}{% endfor %}
        </p>
    </div>
    <div class="d-flex gap-2 flex-shrink-0 align-items-center flex-wrap">
        {% if cfg_vivo %}
            <button type="button" class="spui-tel-vivo" data-tel-vivo-btn aria-pressed="true"
                    title="Temperatura y RAM actualizadas cada segundo">
                <span class="spui-tel-vivo-punto" aria-hidden="true"></span>
                <span data-tel-vivo-texto>Conectando…</span>
            </button>
        {% endif %}
        <button type="button" class="unraf-btn unraf-btn-light d-inline-flex align-items-center gap-1 spui-tel-exportar"
                data-spui-form="{{ path('spui_cms_reproductores_telemetria_exportar_form', {id: reproductor.id}) }}"
                data-spui-title="Exportar telemetría de {{ reproductor.hostname }}"
                title="Descargar el detalle por hora en Excel, CSV o PDF">
            <img src="{{ asset('unraf-ui/icons/export.svg') }}" class="spui-action-icon" alt=""> Exportar
        </button>
        <a href="{{ path('spui_cms_reproductores_index') }}" class="unraf-btn spui-btn-back">← Reproductores</a>
    </div>
</div>

{# ── Indicadores: lo último que se sabe (en vivo, si está activo) ── #}
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="unraf-card spui-tel-indicador h-100">
            <div class="spui-tel-indicador-titulo">Temperatura del procesador</div>
            <div data-tel-gauge="temp" class="spui-tel-gauge"></div>
            <div class="spui-tel-indicador-pie">
                <span>Promedio <strong data-tel-res="temp_prom">—</strong></span>
                <span>Máxima <strong data-tel-res="temp_max">—</strong></span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="unraf-card spui-tel-indicador h-100">
            <div class="spui-tel-indicador-titulo">Memoria RAM en uso</div>
            <div data-tel-gauge="ram" class="spui-tel-gauge"></div>
            <div class="spui-tel-indicador-pie">
                <span>Promedio <strong data-tel-res="ram_prom">—</strong></span>
                <span>Máxima <strong data-tel-res="ram_max">—</strong></span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="unraf-card spui-tel-indicador h-100">
            <div class="spui-tel-indicador-titulo">Disco en uso</div>
            <div data-tel-gauge="disco" class="spui-tel-gauge"></div>
            <div class="spui-tel-indicador-pie">
                <span><span data-tel-disco-etq>En uso</span> <strong data-tel-numero="disco">—</strong></span>
                <span>Total <strong data-tel-numero="disco_total">—</strong></span>
                <span data-tel-disco-max hidden>Máximo del período <strong>—</strong></span>
            </div>
        </div>
    </div>
</div>
<p class="text-muted small mb-4" data-tel-ultima>&nbsp;</p>

{# ── En vivo: lugar reservado desde el principio, con spinner hasta el primer dato ── #}
{% if cfg_vivo %}
<div class="unraf-card mb-4" data-tel-vivo-panel>
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <strong>En vivo · últimos minutos</strong>
        <small class="text-muted">Una lectura por segundo. No se guarda: es para mirar en el momento.</small>
    </div>
    <div class="spui-tel-vivo-cuerpo">
        <div class="row g-0">
            <div class="col-12 col-lg-6 p-2 p-md-3" data-tel-vivo-grafico>
                <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                    <strong class="small">Temperatura</strong>
                    {{ t.herramientas('vivo') }}
                </div>
                <div class="spui-tel-lienzo spui-tel-lienzo-vivo" data-tel-chart="vivo_temp"></div>
            </div>
            <div class="col-12 col-lg-6 p-2 p-md-3" data-tel-vivo-grafico>
                <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                    <strong class="small">RAM</strong>
                    {{ t.herramientas('vivo') }}
                </div>
                <div class="spui-tel-lienzo spui-tel-lienzo-vivo" data-tel-chart="vivo_ram"></div>
            </div>
        </div>
        <div class="spui-tel-espera" data-tel-vivo-espera>
            <div class="spinner-border" role="status" data-tel-vivo-spinner></div>
            <span data-tel-vivo-espera-texto>Esperando los datos del reproductor…</span>
        </div>
    </div>
</div>
{% endif %}

{# ── Histórico ── #}
<div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
    <div>
        <h2 class="h5 mb-0" style="color:var(--unraf-azul)">Histórico por hora</h2>
        <small class="text-muted">Arrastrá un gráfico para moverte en el tiempo y usá la rueda del mouse para acercar o alejar.</small>
    </div>
    <div class="d-flex gap-2 flex-wrap" role="group" aria-label="Período">
        {% for r in rangos %}
            <button type="button" data-tel-rango="{{ r }}"
                    class="unraf-btn unraf-btn-sm {{ rango == r ? 'unraf-btn-institucion' : 'unraf-btn-light' }}"
                    aria-pressed="{{ rango == r ? 'true' : 'false' }}">
                {{ r == '24h' ? 'Últimas 24 h' : (r == '7d' ? 'Últimos 7 días' : 'Últimos 30 días') }}
            </button>
        {% endfor %}
    </div>
</div>

<div class="unraf-card p-5 text-center text-muted mb-4" data-tel-vacio hidden>
    <p class="mb-1">Este reproductor no envió telemetría en los últimos 60 días.</p>
    <small>Cada reproductor manda sus datos una vez por minuto mientras está encendido y conectado.</small>
</div>

<div data-tel-graficos>
    <div class="unraf-card mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2">
            <strong>Temperatura del procesador (°C)</strong>
            {{ t.herramientas('historico') }}
        </div>
        <div class="p-2 p-md-3"><div class="spui-tel-lienzo spui-tel-lienzo-alto" data-tel-chart="temp"></div></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <div class="unraf-card h-100">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2">
                    <strong>Memoria RAM en uso (%)</strong>
                    {{ t.herramientas('historico') }}
                </div>
                <div class="p-2 p-md-3"><div class="spui-tel-lienzo" data-tel-chart="ram"></div></div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="unraf-card h-100">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2">
                    <strong>{{ reproductor.discoTotalMb ? 'Disco en uso (GB, máximo de cada hora)' : 'Espacio libre en disco (GB, mínimo de cada hora)' }}</strong>
                    {{ t.herramientas('historico') }}
                </div>
                <div class="p-2 p-md-3"><div class="spui-tel-lienzo" data-tel-chart="disco"></div></div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" data-tel-datos>{{ datos|json_encode|raw }}</script>
</div>{# /spui-telemetria #}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('spui/vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('spui/js/core/graficos-tiempo.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/mqtt@5.10.1/dist/mqtt.min.js"></script>
    <script src="{{ asset('spui/js/reproductores/telemetria.js') }}"></script>
{% endblock %}
