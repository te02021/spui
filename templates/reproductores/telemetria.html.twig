{% extends '@SPUI/base.html.twig' %}
{% block title %}Telemetría — {{ reproductor.hostname }} — SPUI{% endblock %}

{#
  Gráficos en SVG inline, sin librería.
  Motivo: la red del campus puede no tener salida a internet, y una dependencia
  por CDN dejaría la pantalla vacía justo cuando se la quiere mostrar.
  Temperatura y RAM van en gráficos separados a propósito: son escalas distintas
  (°C y %), y un eje doble haría que dos series se vean comparables sin serlo.
#}

{% macro grafico(serie, campo, campo2, color, color2, unidad, umbral) %}
    {% set valores = serie|map(p => p[campo]) %}
    {% if campo2 %}{% set valores = valores|merge(serie|map(p => p[campo2])) %}{% endif %}
    {% set vmin = min(valores) %}
    {% set vmax = max(valores) %}
    {% if umbral %}{% set vmax = max([vmax, umbral]) %}{% endif %}
    {# Margen del 10% arriba y abajo para que la línea no toque los bordes #}
    {% set span = (vmax - vmin) > 0 ? (vmax - vmin) : 1 %}
    {% set lo   = vmin - span * 0.1 %}
    {% set hi   = vmax + span * 0.1 %}
    {% set n    = serie|length %}

    <svg viewBox="0 0 800 220" preserveAspectRatio="none"
         style="width:100%;height:220px;display:block" role="img"
         aria-label="Serie temporal de {{ campo }}">
        {# Grilla horizontal recesiva #}
        {% for i in 0..4 %}
            {% set y = 15 + i * 45 %}
            <line x1="52" y1="{{ y }}" x2="792" y2="{{ y }}" stroke="#e9ecef" stroke-width="1"/>
            <text x="46" y="{{ y + 4 }}" text-anchor="end" font-size="11" fill="#6c757d">
                {{ (hi - (hi - lo) * i / 4)|number_format(0) }}
            </text>
        {% endfor %}

        {# Umbral de alerta, si aplica #}
        {% if umbral and umbral >= lo and umbral <= hi %}
            {% set yu = 15 + (hi - umbral) / (hi - lo) * 180 %}
            <line x1="52" y1="{{ yu }}" x2="792" y2="{{ yu }}"
                  stroke="#FF223D" stroke-width="2" stroke-dasharray="6 4" opacity=".75"/>
            <text x="788" y="{{ yu - 6 }}" text-anchor="end" font-size="11" fill="#FF223D" font-weight="600">
                umbral {{ umbral|number_format(0) }}{{ unidad }}
            </text>
        {% endif %}

        {% if n > 1 %}
            {% if campo2 %}
                <polyline fill="none" stroke="{{ color2 }}" stroke-width="2"
                          stroke-linejoin="round" stroke-linecap="round"
                          points="{% for p in serie %}{{ 52 + loop.index0 * 740 / (n - 1) }},{{ 15 + (hi - p[campo2]) / (hi - lo) * 180 }} {% endfor %}"/>
            {% endif %}
            <polyline fill="none" stroke="{{ color }}" stroke-width="2"
                      stroke-linejoin="round" stroke-linecap="round"
                      points="{% for p in serie %}{{ 52 + loop.index0 * 740 / (n - 1) }},{{ 15 + (hi - p[campo]) / (hi - lo) * 180 }} {% endfor %}"/>
        {% elseif n == 1 %}
            <circle cx="422" cy="{{ 15 + (hi - serie[0][campo]) / (hi - lo) * 180 }}" r="4" fill="{{ color }}"/>
        {% endif %}

        {# Extremos del eje temporal #}
        {% if n > 0 %}
            <text x="52" y="212" font-size="11" fill="#6c757d">{{ serie|first.periodo|slice(5, 11) }}</text>
            <text x="792" y="212" text-anchor="end" font-size="11" fill="#6c757d">{{ serie|last.periodo|slice(5, 11) }}</text>
        {% endif %}
    </svg>
{% endmacro %}

{% import _self as g %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap spui-header-actions">
    <div>
        <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">
            {{ reproductor.hostname }}
        </h1>
        <p class="text-muted mb-0 small">
            Telemetría del nodo
            {% for p in reproductor.pantallas %}· {{ p.nombre }}{% endfor %}
        </p>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <button type="button" data-spui-refresh-btn
                class="unraf-btn unraf-btn-light d-flex align-items-center gap-1"
                style="font-size:.8rem;padding:.3rem .6rem"
                title="Actualizar datos">
            <img src="{{ asset('unraf-ui/icons/arrows-clockwise.svg') }}" style="width:.85rem;height:.85rem;flex-shrink:0" alt=""> Actualizar
        </button>
        <a href="{{ path('spui_cms_reproductores_index') }}" class="unraf-btn spui-btn-back">← Reproductores</a>
    </div>
</div>

{# ── Rango ── #}
<div class="d-flex gap-2 mb-4 flex-wrap">
    {% for r in rangos %}
        <a href="{{ path('spui_cms_reproductores_telemetria', {id: reproductor.id, rango: r}) }}"
           class="unraf-btn unraf-btn-sm {{ rango == r ? 'unraf-btn-institucion' : 'unraf-btn-light' }}">
            {{ r == '24h' ? 'Últimas 24 h' : (r == '7d' ? 'Últimos 7 días' : 'Últimos 30 días') }}
        </a>
    {% endfor %}
</div>

{# El SVG se genera en el servidor, así que refrescarlo es traer el fragmento y
   reemplazarlo: no hay estado en JS que actualizar. La serie es horaria y
   cambia lento, pero la tarjeta de "última lectura" sí se mueve cada minuto. #}
<div id="telemetria-zona" data-spui-refresh>

{% if resumen is null %}
    <div class="unraf-card p-5 text-center text-muted">
        <p class="mb-1">Este nodo todavía no envió telemetría en este período.</p>
        <small>
            El cliente Python publica métricas por MQTT cada 60 s. Verificá que el nodo esté
            encendido y que el consumidor <code>spui:mqtt:subscribe</code> esté corriendo.
        </small>
    </div>
{% else %}

    {# ── Resumen ── #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="unraf-card p-3 h-100">
                <div class="text-muted small">Temp. promedio</div>
                <div class="fs-4 fw-bold" style="color:var(--unraf-azul)">{{ resumen.temp_prom }}°C</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card p-3 h-100">
                <div class="text-muted small">Temp. máxima</div>
                <div class="fs-4 fw-bold {{ resumen.temp_max >= temp_umbral ? 'text-danger' : '' }}">
                    {{ resumen.temp_max }}°C
                </div>
                {% if resumen.temp_max >= temp_umbral %}
                    <small class="text-danger">Superó el umbral</small>
                {% endif %}
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card p-3 h-100">
                <div class="text-muted small">RAM máxima</div>
                <div class="fs-4 fw-bold" style="color:var(--unraf-azul)">{{ resumen.ram_max }}%</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card p-3 h-100">
                <div class="text-muted small">Disco libre mínimo</div>
                <div class="fs-4 fw-bold {{ resumen.disco_min < 500 ? 'text-danger' : '' }}">
                    {{ (resumen.disco_min / 1024)|number_format(1) }} GB
                </div>
            </div>
        </div>
    </div>

    {# ── Temperatura ── #}
    <div class="unraf-card mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>Temperatura del procesador</strong>
            <div class="d-flex gap-3 small text-muted">
                <span><span style="display:inline-block;width:14px;height:2px;background:#3387EF;vertical-align:middle"></span> Promedio</span>
                <span><span style="display:inline-block;width:14px;height:2px;background:#C77F0A;vertical-align:middle"></span> Máxima</span>
            </div>
        </div>
        <div class="p-3">
            {{ g.grafico(serie, 'temp_prom', 'temp_max', '#3387EF', '#C77F0A', '°C', temp_umbral) }}
        </div>
    </div>

    {# ── RAM ── #}
    <div class="unraf-card mb-4">
        <div class="p-3 border-bottom">
            <strong>Uso de memoria RAM (promedio por hora, %)</strong>
        </div>
        <div class="p-3">
            {{ g.grafico(serie, 'ram_prom', null, '#3387EF', null, '%', null) }}
        </div>
    </div>

    {# ── Tabla: la misma información sin depender del color ni de la forma ── #}
    <div class="unraf-card">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <strong>Detalle por hora</strong>
            <small class="text-muted">{{ resumen.lecturas }} lectura(s) en el período</small>
        </div>
        <div class="unraf-table-responsive" style="max-height:22rem;overflow-y:auto">
            <table class="unraf-table unraf-table-striped w-100 spui-tabla-cards">
                <thead>
                    <tr>
                        <th class="p-2">Hora</th>
                        <th class="p-2">Temp. prom.</th>
                        <th class="p-2">Temp. máx.</th>
                        <th class="p-2">RAM prom.</th>
                        <th class="p-2">Disco mín.</th>
                        <th class="p-2">Lecturas</th>
                    </tr>
                </thead>
                <tbody>
                {% for p in serie|reverse %}
                    <tr>
                        <td class="p-2" data-label="Hora">{{ p.periodo }}</td>
                        <td class="p-2" data-label="Temp. prom.">{{ p.temp_prom }}°C</td>
                        <td class="p-2" data-label="Temp. máx.">
                            <span class="{{ p.temp_max >= temp_umbral ? 'text-danger fw-bold' : '' }}">{{ p.temp_max }}°C</span>
                        </td>
                        <td class="p-2" data-label="RAM prom.">{{ p.ram_prom }}%</td>
                        <td class="p-2" data-label="Disco mín.">{{ (p.disco_min / 1024)|number_format(1) }} GB</td>
                        <td class="p-2" data-label="Lecturas">{{ p.lecturas }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endif %}

</div>{# /telemetria-zona #}
{% endblock %}
