{% extends '@SPUI/base.html.twig' %}
{% block title %}Nuevo reproductor — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nuevo reproductor</h1>
    <a href="{{ path('spui_cms_reproductores_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="alert alert-info mb-4" role="alert">
    <strong>Al crear el reproductor</strong> se genera automáticamente una <strong>API key única</strong>.
    Se mostrará <strong>una sola vez</strong> — guardala de inmediato para configurar el Pi.
    Las pantallas se asignan desde la edición de cada pantalla.
</div>

<div class="row justify-content-center">
<div class="col-lg-8">
    <div class="unraf-card p-4">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.hostname) }}
            {{ form_widget(form.hostname) }}
            <small class="text-muted d-block mt-1">Nombre de host de la Raspberry Pi. Ej: spui-pi-01</small>
            {% for error in form.hostname.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-4">
            {{ form_label(form.versionFirmware) }}
            {{ form_widget(form.versionFirmware) }}
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('spui_cms_reproductores_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
            <button type="submit" class="unraf-btn unraf-btn-institucion">Registrar y ver clave</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
{% endblock %}
