{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-3">{{ e.message }}</div>
{% endfor %}

<div class="row g-2 mb-3">
    <div class="col-12 col-sm">
        {{ form_label(form.nombre) }}
        {{ form_widget(form.nombre) }}
        {% for e in form.nombre.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm">
        {{ form_label(form.ubicacion) }}
        {{ form_widget(form.ubicacion) }}
        {% for e in form.ubicacion.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-12 col-sm">
        {{ form_label(form.reproductor) }}
        {{ form_widget(form.reproductor) }}
        {% for e in form.reproductor.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
        <small class="text-muted d-block mt-1">Raspberry Pi que controla esta pantalla. Opcional.</small>
    </div>
</div>

<div class="row g-2 mb-3 align-items-start">
    <div class="col">
        {{ form_label(form.playlistFallback) }}
        {{ form_widget(form.playlistFallback) }}
        {% for e in form.playlistFallback.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    {# Estado con el switch estándar del CMS. Una pantalla inactiva muestra la
       pantalla de espera (SyncController) — no su programación ni su respaldo. #}
    {% set swEstadoId = form.activa.vars.id %}
    <div class="col-12 col-sm-auto d-flex flex-column align-items-center" style="min-width:110px">
        <label class="unraf-form-label mb-2 text-center" for="{{ swEstadoId }}">Estado</label>
        <div class="d-flex align-items-center gap-2">
            <div class="form-switch m-0">
                {{ form_widget(form.activa, {'attr': {'class': 'form-check-input spui-switch-input', 'role': 'switch', 'data-spui-switch': '1', 'data-switch-on': 'Activa', 'data-switch-off': 'Inactiva'}}) }}
            </div>
            <span class="spui-switch-status {{ form.activa.vars.checked ? 'on' : 'off' }}" id="{{ swEstadoId }}_lbl">{{ form.activa.vars.checked ? 'Activa' : 'Inactiva' }}</span>
        </div>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col">
        {{ form_label(form.macAddress) }}
        {{ form_widget(form.macAddress) }}
        {% for e in form.macAddress.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col">
        {{ form_label(form.ipAddress) }}
        {{ form_widget(form.ipAddress) }}
        {% for e in form.ipAddress.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="row g-2 mb-4 justify-content-center">
    <div class="col-auto">
        {{ form_label(form.resolucionAncho) }}
        {{ form_widget(form.resolucionAncho) }}
        {% for e in form.resolucionAncho.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
    <div class="col-auto">
        {{ form_label(form.resolucionAlto) }}
        {{ form_widget(form.resolucionAlto) }}
        {% for e in form.resolucionAlto.vars.errors %}
            <p class="spui-campo-error">{{ e.message }}</p>
        {% endfor %}
    </div>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn {{ pantalla is defined and pantalla.id ? 'spui-btn-editar' : 'spui-btn-crear' }}">
        Guardar
    </button>
</div>

{{ form_end(form) }}
