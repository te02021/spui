{% import '@SPUI/_macros/form.html.twig' as f %}
{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'class': 'spui-form'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-0">{{ e.message }}</div>
{% endfor %}

<section class="spui-ver-seccion" aria-labelledby="spui-form-datos">
    <h5 class="spui-ver-titulo" id="spui-form-datos">Datos</h5>
    {# Una pantalla inactiva muestra la pantalla de espera (SyncController), no su programación ni su respaldo. #}
    <div class="spui-ver-bloque spui-form-fila spui-form-fila-3">
        <div>{{ f.campo(form.nombre) }}</div>
        <div>{{ f.campo(form.ubicacion) }}</div>
        <div>{{ f.estado(form.activa, 'Activa', 'Inactiva') }}</div>
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-reproduccion">
    <h5 class="spui-ver-titulo" id="spui-form-reproduccion">Reproducción</h5>
    <div class="spui-ver-bloque spui-form-fila spui-form-fila-2">
        <div>
            {{ f.campo(form.reproductor) }}
            <small class="spui-form-ayuda">La Raspberry Pi que controla esta pantalla.</small>
        </div>
        <div>
            {{ f.campo(form.playlistFallback) }}
            <small class="spui-form-ayuda">Se muestra cuando no hay ninguna regla de programación vigente.</small>
        </div>
    </div>
</section>

{{ f.pie(pantalla is defined and pantalla.id ? 'spui-btn-editar' : 'spui-btn-crear') }}

{{ form_end(form) }}
