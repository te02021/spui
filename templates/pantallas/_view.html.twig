{% import '@SPUI/_macros/ver.html.twig' as ver %}
{# Detalle de una pantalla. El título es el del modal. #}
<div class="spui-ver">
    <section class="spui-ver-seccion" aria-labelledby="spui-ver-detalles">
        <h5 class="spui-ver-titulo" id="spui-ver-detalles">Detalles</h5>
        <dl class="spui-ver-datos spui-ver-bloque">
            <div><dt>Estado</dt><dd><span class="{{ pantalla.activa ? 'spui-badge-conectado' : 'spui-badge-sin_registrar' }}">{{ pantalla.estado.etiqueta }}</span></dd></div>
            <div class="spui-ver-dato-largo"><dt>Ubicación</dt><dd>{{ pantalla.ubicacion.edificio.nombre }}{% if pantalla.ubicacion.sector %} · {{ pantalla.ubicacion.sector }}{% endif %}</dd></div>
            <div class="spui-ver-dato-largo"><dt>Reproductor</dt><dd>{{ pantalla.reproductor ? pantalla.reproductor.hostname : 'Sin asignar' }}</dd></div>
            {% if pantalla.playlistFallback %}<div class="spui-ver-dato-largo"><dt>Playlist de respaldo</dt><dd>{{ pantalla.playlistFallback.nombre }}</dd></div>{% endif %}
            <div class="spui-ver-dato-largo"><dt>Alta</dt><dd>{{ pantalla.creadoEn|date('d/m/Y H:i') }}</dd></div>
            <div class="spui-ver-dato-largo"><dt>Última modificación</dt><dd>{{ pantalla.actualizadoEn|date('d/m/Y H:i') }}</dd></div>
        </dl>
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-reglas">
        <h5 class="spui-ver-titulo" id="spui-ver-reglas">Reglas de programación · {{ pantalla.programaciones|length }}</h5>
        {{ ver.reglas(pantalla.programaciones, 'Sin reglas propias: usa las de su ubicación, su edificio o las globales.') }}
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-energia">
        <h5 class="spui-ver-titulo" id="spui-ver-energia">Horarios de encendido · {{ pantalla.programacionesEnergeticas|length }}</h5>
        {% if pantalla.programacionesEnergeticas|length > 0 %}
            <div class="spui-ver-bloque">
                <ul class="spui-ver-usos">
                    {% for energia in pantalla.programacionesEnergeticas %}
                        <li>
                            <span>{{ ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'][energia.diaSemana - 1] ?? 'Día ' ~ energia.diaSemana }}</span>
                            <small>{{ energia.horaEncendido ? energia.horaEncendido|date('H:i') : '—' }} a {{ energia.horaApagado ? energia.horaApagado|date('H:i') : '—' }}</small>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            {{ ver.vacio('Sin horarios configurados: la pantalla queda siempre encendida.') }}
        {% endif %}
    </section>
</div>
