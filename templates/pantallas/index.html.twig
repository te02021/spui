{% extends '@SPUI/base.html.twig' %}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% block title %}Pantallas — SPUI{% endblock %}
{% block descripcion %}Pantallas digitales instaladas en el campus de la UNRaf: ubicación, reproductor y playlist de respaldo.{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 spui-header-actions">
    <div>
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Pantallas</h1>
        <p class="text-muted mb-0">Pantallas físicas instaladas en cada ubicación.</p>
    </div>
    <button type="button" class="unraf-btn spui-btn-crear flex-shrink-0"
            data-spui-form="{{ path('spui_cms_pantallas_nueva') }}"
            data-spui-title="Nueva pantalla"
            data-spui-size="modal-lg">
        + Nueva pantalla
    </button>
</div>

{# Tarjetas (30/10/2026). Sin MAC, IP ni resolución: se sacaron del sistema
   (nadie los usaba: la Pi reproduce a pantalla completa en lo que detecta).
   La zona interna se vuelve a pedir cuando llega un aviso de conexión por
   MQTT (conexion-vivo.js), no por intervalo: destraba o traba los botones si
   un reproductor vuelve o se cae. #}
<div id="spui-table-body">
{{ include('@SPUI/_partials/filtros.html.twig', {grupos: filtros, que: 'pantallas'}) }}
<div class="spui-lista" id="spui-tabla-conexion" data-spui-refresh="push">
{% for p in pantallas %}
    {# null = el reproductor de esta pantalla responde. #}
    {% set motivo = spui_alcance.motivoParaEntidad(p, ids_offline|default({})) %}
    {% set conexion = p.reproductor ? p.reproductor.estadoCalculado(spui_umbral_conexion).value : null %}
    <article class="unraf-card spui-item {{ not p.activa ? 'is-apagado' : (conexion == 'conectado' ? 'is-ok' : 'is-aviso') }}">
        <div class="spui-item-cuerpo">
            <div class="spui-item-cab">
                <span class="spui-etiqueta {{ p.activa ? 'is-ok' : '' }}">{{ p.estado.etiqueta }}</span>
                <h2 class="spui-item-titulo">{{ p.nombre }}</h2>
            </div>
            <div class="spui-chips">
                <span class="spui-chip"><img src="{{ asset('unraf-ui/icons/map-pin.svg') }}" alt=""> {{ p.ubicacion.edificio.nombre }}{% if p.ubicacion.sector %} — {{ p.ubicacion.sector }}{% endif %}</span>
                {% if p.reproductor %}
                    <span class="spui-chip {{ conexion == 'conectado' ? 'is-ok' : (conexion == 'desconectado' ? 'is-grave' : '') }}"
                          title="Reproductor {{ p.reproductor.estadoCalculado(spui_umbral_conexion).etiqueta|lower }}">
                        <img src="{{ asset('unraf-ui/icons/cpu.svg') }}" alt=""> {{ p.reproductor.hostname }} · {{ p.reproductor.estadoCalculado(spui_umbral_conexion).etiqueta|lower }}
                    </span>
                {% else %}
                    <span class="spui-chip is-aviso"><img src="{{ asset('unraf-ui/icons/cpu.svg') }}" alt=""> Sin reproductor</span>
                {% endif %}
                <span class="spui-chip"><img src="{{ asset('unraf-ui/icons/playlist.svg') }}" alt=""> {{ p.playlistFallback ? 'Respaldo: ' ~ p.playlistFallback.nombre : 'Sin playlist de respaldo' }}</span>
            </div>
        </div>
        <div class="spui-acciones spui-item-acciones">
            <button type="button"
                    class="unraf-btn spui-btn-ver unraf-btn-sm"
                    data-spui-form="{{ path('spui_cms_pantallas_ver', {id: p.id}) }}"
                    data-spui-title="{{ p.nombre }}"
                    title="Ver detalle">
                <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt=""> Ver
            </button>
            <button type="button"
                    class="unraf-btn spui-btn-editar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                    data-spui-form="{{ path('spui_cms_pantallas_editar', {id: p.id}) }}"
                    data-spui-title="Editar: {{ p.nombre }}"
                    data-spui-size="modal-lg"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Editar"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt=""> Editar
            </button>
            <button type="button"
                    class="unraf-btn spui-btn-energia unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                    data-spui-form="{{ path('spui_cms_energia_grilla', {id: p.id}) }}"
                    data-spui-title="Energía — {{ p.nombre }}"
                    data-spui-size="modal-lg"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Horarios de encendido, apagado y brillo"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/plug.svg') }}" class="spui-action-icon" alt=""> Energía
            </button>
            <button type="button"
                    class="unraf-btn unraf-btn-sm {{ p.activa ? 'spui-btn-desactivar' : 'spui-btn-activar' }} {{ bloqueo.clase(motivo) }}"
                    data-spui-action="{{ path('spui_cms_pantallas_toggle_estado', {id: p.id}) }}"
                    data-spui-title="Cambiar estado"
                    data-spui-message="Cambiar estado de «{{ p.nombre }}»?"
                    data-spui-variant="{{ p.activa ? 'desactivar' : 'activar' }}"
                    data-spui-confirm-label="Cambiar estado"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="{{ p.activa ? 'Desactivar' : 'Activar' }}"{% endif %}>
                <img src="{{ p.activa ? asset('unraf-ui/icons/hand-palm.svg') : asset('unraf-ui/icons/lightning.svg') }}"
                     class="spui-action-icon" alt="">
                {{ p.activa ? 'Desactivar' : 'Activar' }}
            </button>
            <button type="button"
                    class="unraf-btn spui-btn-eliminar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                    data-spui-action="{{ path('spui_cms_pantallas_eliminar', {id: p.id}) }}"
                    data-spui-title="Eliminar pantalla"
                    data-spui-message="¿Eliminar «{{ p.nombre }}»? Esta acción no se puede deshacer."
                    data-spui-variant="eliminar"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Eliminar"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
            </button>
        </div>
    </article>
{% else %}
    {% set filtrado = filtros|filter(g => g.actual != '' and g.opciones[0].cuenta is not null)|length > 0 %}
    <div class="unraf-card p-4 text-center text-muted">
        {% if filtrado %}No hay pantallas con este filtro. <a href="{{ path(app.request.attributes.get('_route')) }}">Ver todos</a>
        {% else %}No hay pantallas registradas.{% endif %}
    </div>
{% endfor %}
</div>
{{ include('@SPUI/_partials/paginacion.html.twig', {pag: paginacion, que: 'pantallas'}) }}
</div>
{% endblock %}

{# Destraba/traba los botones cuando un reproductor vuelve o se cae, sin recargar. #}
{% block javascripts %}
    {{ include('@SPUI/_partials/conexion_vivo.html.twig') }}
{% endblock %}
