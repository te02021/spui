{% extends '@SPUI/base.html.twig' %}
{% block title %}Nueva pantalla — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Nueva pantalla</h1>
    <a href="{{ path('spui_cms_pantallas_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="row justify-content-center">
<div class="col-lg-8">
    <div class="unraf-card p-4">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.nombre) }}
            {{ form_widget(form.nombre) }}
            {% for error in form.nombre.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.ubicacion) }}
            {{ form_widget(form.ubicacion) }}
            {% for error in form.ubicacion.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.macAddress) }}
            {{ form_widget(form.macAddress) }}
            <small class="text-muted d-block mt-1">Opcional. Formato: aa:bb:cc:dd:ee:ff</small>
            {% for error in form.macAddress.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.ipAddress) }}
            {{ form_widget(form.ipAddress) }}
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                {{ form_label(form.resolucionAncho) }}
                {{ form_widget(form.resolucionAncho) }}
            </div>
            <div class="col-sm-6">
                {{ form_label(form.resolucionAlto) }}
                {{ form_widget(form.resolucionAlto) }}
            </div>
        </div>

        <div class="mb-3">
            {{ form_label(form.estado) }}
            {{ form_widget(form.estado) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.reproductor) }}
            {{ form_widget(form.reproductor) }}
            <small class="text-muted d-block mt-1">Raspberry Pi que controlará esta pantalla. Puede asignarse después.</small>
        </div>

        <div class="mb-4">
            {{ form_label(form.playlistFallback) }}
            {{ form_widget(form.playlistFallback) }}
            <small class="text-muted d-block mt-1">Playlist que se muestra cuando no hay programación activa.</small>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('spui_cms_pantallas_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
            <button type="submit" class="unraf-btn unraf-btn-institucion">Guardar pantalla</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
{% endblock %}
