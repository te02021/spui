{% import '@SPUI/_macros/texto.html.twig' as texto %}
{% import '@SPUI/_macros/graficos.html.twig' as g %}
{# Contenido dinámico del dashboard (rehecho el 29/10 y el 30/10/2026).
   Se renderiza dentro de #dashboard-zona y se reconcilia cada 20 s y además
   apenas un reproductor cambia de estado (aviso MQTT, conexion-vivo.js), así
   que TODO lo que cambie con el tiempo tiene que estar acá dentro.
   Los gráficos llevan data-spui-refresh-conservar (auto-refresh.js no los
   toca) y se redibujan con los datos del <script data-dash-datos>, que sí se
   actualiza (dashboard.js, evento spui:refrescado). #}

{% set total = reproductores|length %}
{% set con_problemas = reproductores|filter(r => r.tieneProblemas) %}
{% set caidos = reproductores|filter(r => r.estadoCalculado(spui_umbral_conexion).value == 'desconectado') %}
{% set avisos = caidos|length + sobrecalentados|length + con_problemas|length
              + (intentos_fallidos|length > 0 ? 1 : 0) + (scheduler_desactualizado ? 1 : 0) %}
{% set avisos_graves = caidos|length + sobrecalentados|length + (scheduler_desactualizado ? 1 : 0) %}
{% set COLORES_ESTADO = {conectado: '#4A9930', desconectado: '#FF223D', sin_registrar: '#adb5bd'} %}
{% set COLORES_TIPO = {texto: '#5B6B7F', imagen: '#3387EF', video: '#7A5AF8', qr: '#1CA1A7', cronograma: '#C77F0A'} %}

<div class="spui-dash p-3 p-md-4">
    <header class="spui-dash-cabecera mb-4">
        <div class="min-w-0">
            <h1 class="spui-dash-h1">Dashboard</h1>
            <p class="text-muted mb-0">Estado de la red de pantallas digitales, en tiempo real.</p>
        </div>
        <div class="spui-dash-acciones">
            {# Avisos (30/10/2026): un botón con el contador y un desplegable con
               la lista, en vez de recuadros sueltos en la página, que con muchos
               reproductores caídos ocupaban la pantalla entera. El desplegable
               se abre con aria-expanded, que auto-refresh.js no toca: sigue
               abierto mientras su contenido se actualiza solo. #}
            <div class="spui-dash-avisos">
                <button type="button" id="dash-avisos-btn"
                        class="spui-dash-avisos-btn{{ avisos ? (avisos_graves ? ' is-grave' : ' is-hay') : ' is-ok' }}"
                        aria-expanded="false" aria-controls="dash-avisos-panel" data-dash-avisos-btn data-spui-sync="aria-label"
                        aria-label="{{ avisos ? texto.plural(avisos, 'aviso que requiere atención', 'avisos que requieren atención') : 'Sin avisos: todo en orden' }}">
                    <img src="{{ asset('unraf-ui/icons/' ~ (avisos ? 'bell-ringing.svg' : 'bell.svg')) }}" alt="" data-spui-sync="src">
                    <span>Avisos</span>
                    <span class="spui-dash-avisos-cuenta">{{ avisos ?: '✓' }}</span>
                </button>
                <section id="dash-avisos-panel" class="spui-dash-avisos-panel" aria-labelledby="dash-avisos-titulo">
                    <div class="spui-dash-avisos-cab">
                        <h2 id="dash-avisos-titulo" class="spui-dash-h2">{{ avisos ? texto.plural(avisos, 'aviso', 'avisos') ~ ' que requieren atención' : 'Todo en orden' }}</h2>
                        <button type="button" class="spui-dash-globo-cerrar" data-dash-avisos-cerrar aria-label="Cerrar avisos">×</button>
                    </div>
                    {% if not avisos %}
                        <p class="spui-dash-avisos-ok">
                            <span class="spui-dash-enorden-icono" aria-hidden="true">✓</span>
                            Todos los reproductores dan señal, sin sobrecalentamiento, problemas informados, intentos de acceso inválidos ni tareas automáticas detenidas.
                        </p>
                    {% else %}
                        <ul class="spui-dash-avisos-lista">
                            {# Un reproductor sin señal: su pantalla puede seguir mostrando
                               lo último que tenía en caché, pero no recibe cambios. #}
                            {% for r in caidos %}
                                <li class="spui-dash-aviso is-grave">
                                    <span class="spui-dash-aviso-icono" aria-hidden="true">!</span>
                                    <div class="min-w-0">
                                        <div class="spui-dash-aviso-titulo"><strong>{{ r.hostname }}</strong> está desconectado</div>
                                        <div class="spui-dash-aviso-detalle">
                                            {%- if r.ultimoHeartbeat %}Sin señal desde las {{ r.ultimoHeartbeat|date('H:i') }} del {{ r.ultimoHeartbeat|date('d/m') }}{% else %}Nunca dio señal{% endif %}
                                            {%- if r.pantallas|length %} · {{ r.pantallas|map(p => p.nombre)|join(', ') }}{% endif -%}
                                        </div>
                                        <div class="spui-dash-aviso-ayuda">Revisá que esté encendido y con red: mientras tanto no recibe cambios.</div>
                                    </div>
                                </li>
                            {% endfor %}

                            {% for r in reproductores|filter(r => sobrecalentados[r.id] is defined) %}
                                <li class="spui-dash-aviso is-grave">
                                    <span class="spui-dash-aviso-icono" aria-hidden="true">!</span>
                                    <div class="min-w-0">
                                        <div class="spui-dash-aviso-titulo"><strong>{{ r.hostname }}</strong> a {{ sobrecalentados[r.id]|number_format(1, ',') }} °C</div>
                                        <div class="spui-dash-aviso-detalle">Por encima del umbral de {{ temp_umbral|number_format(0) }} °C: la Raspberry Pi se frena.</div>
                                        <div class="spui-dash-aviso-ayuda">Revisá ventilación y disipador.</div>
                                    </div>
                                </li>
                            {% endfor %}

                            {# Problemas que los propios reproductores informan en su
                               heartbeat: un equipo puede figurar conectado y no estar
                               mostrando nada. #}
                            {% for r in con_problemas %}
                                <li class="spui-dash-aviso">
                                    <span class="spui-dash-aviso-icono" aria-hidden="true">!</span>
                                    <div class="min-w-0">
                                        <div class="spui-dash-aviso-titulo"><strong>{{ r.hostname }}</strong> informa un problema</div>
                                        {% for problema in r.diagnostico %}<div class="spui-dash-aviso-detalle">{{ problema }}</div>{% endfor %}
                                    </div>
                                </li>
                            {% endfor %}

                            {# Intentos con API key inválida: si alguno es la clave ANTERIOR
                               de un reproductor (regenerada hace poco), se lo nombra. #}
                            {% if intentos_fallidos|length > 0 %}
                                <li class="spui-dash-aviso">
                                    <span class="spui-dash-aviso-icono" aria-hidden="true">!</span>
                                    <div class="min-w-0">
                                        <div class="spui-dash-aviso-titulo"><strong>{{ texto.plural(intentos_fallidos|length, 'intento', 'intentos') }}</strong> con API key inválida en la última hora</div>
                                        {% for hostname in hostnames_clave_vieja %}
                                            <div class="spui-dash-aviso-detalle"><strong>{{ hostname }}</strong> usa la clave anterior: copiá la nueva a su <code>spui.env</code> y reiniciá el servicio.</div>
                                        {% endfor %}
                                        <div class="spui-dash-aviso-ayuda">Últimos orígenes: {{ intentos_fallidos|slice(-5)|map(i => i.ip)|join(', ') }}</div>
                                    </div>
                                </li>
                            {% endif %}

                            {# Mantenimiento y rollup corren dentro de spui:mqtt:subscribe; si
                               se cae, nada más lo detecta (TelemetriaRollupService::estaDesactualizado). #}
                            {% if scheduler_desactualizado %}
                                <li class="spui-dash-aviso is-grave">
                                    <span class="spui-dash-aviso-icono" aria-hidden="true">!</span>
                                    <div class="min-w-0">
                                        <div class="spui-dash-aviso-titulo"><strong>Las tareas automáticas</strong> no están corriendo</div>
                                        <div class="spui-dash-aviso-detalle">Hace más de dos horas que el servidor no marca los reproductores caídos, ni vence alertas, ni resume la telemetría.</div>
                                        <div class="spui-dash-aviso-ayuda">Pedile a quien administra el servidor que reinicie el servicio <strong>spui-telemetria</strong>.</div>
                                    </div>
                                </li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </section>
            </div>
            {# data-spui-refresh-btn lo asocia auto-refresh.js: fuerza un refresco
               inmediato sin esperar el ciclo de 20 s. #}
            <button type="button" id="btnActualizarDashboard" data-spui-refresh-btn
                    class="unraf-btn unraf-btn-light d-flex align-items-center gap-1 spui-dash-actualizar"
                    title="Actualizar datos">
                <img src="{{ asset('unraf-ui/icons/arrows-clockwise.svg') }}" alt=""> Actualizar
            </button>
        </div>
    </header>

    {# ── Alertas activas: lo primero que hay que ver ── #}
    {% for alerta in alertas_activas %}
        <section class="spui-dash-alerta mb-3" role="alert" aria-label="Alerta de emergencia en curso">
            <div class="spui-dash-alerta-icono" aria-hidden="true">
                <img src="{{ asset('unraf-ui/icons/warning.svg') }}" alt="">
            </div>
            <div class="flex-grow-1 min-w-0">
                <div class="spui-dash-alerta-rotulo">Alerta de emergencia en curso</div>
                <div class="spui-dash-alerta-titulo">{{ alerta.titulo }}</div>
                <div class="spui-dash-alerta-mensaje">{{ alerta.mensaje|slice(0, 160) }}{% if alerta.mensaje|length > 160 %}…{% endif %}</div>
                <div class="spui-dash-alerta-meta">
                    <span>{{ alerta.esGlobal ? 'En todas las pantallas' : 'En ' ~ texto.plural(alerta.pantallas|length, 'pantalla', 'pantallas') }}</span>
                    {% if alerta.activadaEn %}<span>Desde las {{ alerta.activadaEn|date('H:i') }} del {{ alerta.activadaEn|date('d/m') }}</span>{% endif %}
                    <span>{{ alerta.expiraEn ? 'Vence el ' ~ alerta.expiraEn|date('d/m H:i') : 'Sin vencimiento' }}</span>
                </div>
            </div>
            <button type="button" class="unraf-btn spui-dash-alerta-btn flex-shrink-0"
                    data-spui-action="{{ path('spui_cms_alertas_desactivar', {id: alerta.id}) }}"
                    data-spui-title="Desactivar alerta"
                    data-spui-confirm-label="Desactivar"
                    data-spui-message="¿Desactivar la alerta «{{ alerta.titulo }}»? Se notificará a todas las pantallas."
                    data-spui-variant="desactivar"
                    data-spui-reload>
                Desactivar
            </button>
        </section>
    {% endfor %}

    {# ── Cuatro tarjetas idénticas: cifra principal, una barra que la pone en
       contexto y una línea de detalle. Cada una responde una pregunta. ── #}
    <section aria-labelledby="dash-resumen-titulo" class="mb-4">
        <h2 id="dash-resumen-titulo" class="visually-hidden">Resumen de la red</h2>
        <div class="spui-dash-kpis">
            {# Pantallas: ¿cuántas están mostrando ahora? #}
            {% set p_offline = resumen_red.pantallas_activas - resumen_red.pantallas_en_linea %}
            {% set p_inactivas = resumen_red.pantallas - resumen_red.pantallas_activas %}
            <a href="{{ path('spui_cms_pantallas_index') }}" class="unraf-card spui-dash-kpi" style="--kpi:#3387EF">
                <span class="spui-dash-kpi-cab"><span class="spui-dash-kpi-icono"><img src="{{ asset('unraf-ui/icons/monitor.svg') }}" alt=""></span>Pantallas</span>
                <span class="spui-dash-kpi-cifra"><strong>{{ resumen_red.pantallas_en_linea }}</strong> de {{ resumen_red.pantallas_activas }} en línea</span>
                <span class="spui-dash-kpi-barra" aria-hidden="true">
                    {% if resumen_red.pantallas %}
                        <span data-spui-sync="style" style="flex:{{ resumen_red.pantallas_en_linea }};background:#4A9930"></span>
                        <span data-spui-sync="style" style="flex:{{ p_offline }};background:#FF223D"></span>
                        <span data-spui-sync="style" style="flex:{{ p_inactivas }};background:#ced4da"></span>
                    {% endif %}
                </span>
                <span class="spui-dash-kpi-pie">
                    {%- if p_offline > 0 %}<span class="text-danger">{{ p_offline }} sin señal</span> · {% endif -%}
                    {%- if p_inactivas > 0 %}{{ p_inactivas }} {{ p_inactivas == 1 ? 'inactiva' : 'inactivas' }} · {% endif -%}
                    en {{ texto.plural(resumen_red.edificios, 'edificio', 'edificios') }}
                </span>
            </a>

            {# Contenidos: ¿qué hay para mostrar? #}
            <a href="{{ path('spui_cms_contenidos_index') }}" class="unraf-card spui-dash-kpi" style="--kpi:#7A5AF8">
                <span class="spui-dash-kpi-cab"><span class="spui-dash-kpi-icono"><img src="{{ asset('unraf-ui/icons/image.svg') }}" alt=""></span>Contenidos</span>
                <span class="spui-dash-kpi-cifra"><strong>{{ resumen_red.contenidos }}</strong> {{ resumen_red.contenidos == 1 ? 'disponible' : 'disponibles' }}</span>
                <span class="spui-dash-kpi-barra" aria-hidden="true">
                    {% for t in resumen_red.contenidos_tipo|filter(t => t.cantidad > 0) %}
                        <span data-spui-sync="style" style="flex:{{ t.cantidad }};background:{{ COLORES_TIPO[t.tipo]|default('#adb5bd') }}" title="{{ t.etiqueta }}: {{ t.cantidad }}"></span>
                    {% endfor %}
                </span>
                {% set tipos_txt = resumen_red.contenidos_tipo|filter(t => t.cantidad > 0)|map(t => t.etiqueta ~ ' ' ~ t.cantidad)|join(' · ') %}
                <span class="spui-dash-kpi-pie" title="{{ tipos_txt }}">
                    {%- for t in resumen_red.contenidos_tipo|filter(t => t.cantidad > 0) -%}
                        <span class="spui-dash-kpi-tipo"><span class="spui-dash-punto" style="background:{{ COLORES_TIPO[t.tipo]|default('#adb5bd') }}"></span>{{ t.etiqueta }} {{ t.cantidad }}</span>
                    {%- else -%}
                        Todavía no hay contenidos cargados
                    {%- endfor -%}
                </span>
            </a>

            {# Programación: ¿todas las pantallas tienen qué mostrar? #}
            <a href="{{ path('spui_cms_programacion_index') }}" class="unraf-card spui-dash-kpi" style="--kpi:#1CA1A7">
                <span class="spui-dash-kpi-cab"><span class="spui-dash-kpi-icono"><img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" alt=""></span>Programación</span>
                <span class="spui-dash-kpi-cifra"><strong>{{ resumen_red.reglas_activas }}</strong> de {{ resumen_red.reglas }} {{ resumen_red.reglas == 1 ? 'regla activa' : 'reglas activas' }}</span>
                <span class="spui-dash-kpi-barra" aria-hidden="true">
                    {% if resumen_red.reglas %}
                        <span data-spui-sync="style" style="flex:{{ resumen_red.reglas_activas }};background:#1CA1A7"></span>
                        <span data-spui-sync="style" style="flex:{{ resumen_red.reglas - resumen_red.reglas_activas }};background:#ced4da"></span>
                    {% endif %}
                </span>
                <span class="spui-dash-kpi-pie">
                    {{ texto.plural(resumen_red.playlists, 'playlist', 'playlists') }} ·
                    {% if resumen_red.sin_respaldo %}<span class="text-warning-emphasis">{{ resumen_red.sin_respaldo }} {{ resumen_red.sin_respaldo == 1 ? 'pantalla' : 'pantallas' }} sin playlist de respaldo</span>{% else %}todas con playlist de respaldo{% endif %}
                </span>
            </a>

            {# Alertas: ¿hay una emergencia en curso? #}
            {% set en_curso = alertas_activas|length %}
            <a href="{{ path('spui_cms_alertas_index') }}" class="unraf-card spui-dash-kpi{{ en_curso ? ' is-alerta' : '' }}" data-spui-sync="style" style="--kpi:{{ en_curso ? '#FF223D' : '#6c757d' }}">
                <span class="spui-dash-kpi-cab"><span class="spui-dash-kpi-icono"><img src="{{ asset('unraf-ui/icons/warning.svg') }}" alt=""></span>Alertas</span>
                <span class="spui-dash-kpi-cifra"><strong>{{ en_curso }}</strong> en curso · {{ resumen_red.alertas }} {{ resumen_red.alertas == 1 ? 'creada' : 'creadas' }}</span>
                <span class="spui-dash-kpi-barra" aria-hidden="true">
                    {% if resumen_red.alertas %}
                        <span data-spui-sync="style" style="flex:{{ en_curso }};background:#FF223D"></span>
                        <span data-spui-sync="style" style="flex:{{ resumen_red.alertas - en_curso }};background:#ced4da"></span>
                    {% endif %}
                </span>
                <span class="spui-dash-kpi-pie">
                    {%- if resumen_red.ultima_alerta -%}
                        Última activación: {{ resumen_red.ultima_alerta.activadaEn|date('d/m H:i') }} · {{ resumen_red.ultima_alerta.titulo }}
                    {%- else -%}
                        Nunca se activó una alerta
                    {%- endif -%}
                </span>
            </a>
        </div>
    </section>

    {# ── Estado de los reproductores + temperatura de la red ── #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-5 col-xl-4">
            <section class="unraf-card h-100 spui-dash-tarjeta" aria-labelledby="dash-estado-titulo">
                <div>
                    <h2 id="dash-estado-titulo" class="spui-dash-h2">Reproductores</h2>
                    <small class="text-muted">Tocá el gráfico o una fila para ver cuáles</small>
                </div>
                <div class="spui-dash-estado-cuerpo">
                    <div class="spui-dash-dona" data-dash-chart="estado" data-spui-refresh-conservar
                         role="img" aria-label="{{ conteo.conectado }} conectados, {{ conteo.desconectado }} desconectados, {{ conteo.sin_registrar }} sin registrar"></div>
                    <ul class="spui-dash-leyenda list-unstyled mb-0">
                        {% for clave, etiqueta in {conectado: 'Conectados', desconectado: 'Desconectados', sin_registrar: 'Sin registrar'} %}
                            <li>
                                <button type="button" class="spui-dash-leyenda-btn" data-dash-estado="{{ clave }}" data-spui-sync="disabled" {{ conteo[clave] ? '' : 'disabled' }}>
                                    <span class="spui-dash-punto" style="background:{{ COLORES_ESTADO[clave] }}"></span>
                                    <span class="flex-grow-1 text-start">{{ etiqueta }}</span>
                                    <strong>{{ conteo[clave] }}</strong>
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <p class="spui-dash-nota mb-0">Un reproductor figura desconectado tras {{ (spui_umbral_conexion / 60)|number_format(1, ',')|replace({',0': ''}) }} min sin dar señal.</p>
            </section>
        </div>
        <div class="col-12 col-lg-7 col-xl-8">
            <section class="unraf-card h-100" aria-labelledby="dash-temp-titulo">
                <div class="p-3 border-bottom spui-dash-graf-cab">
                    <div class="min-w-0">
                        <h2 id="dash-temp-titulo" class="spui-dash-h2">Temperatura del procesador (°C) · últimas 24 h</h2>
                        <small class="text-muted">Promedio por hora de cada reproductor</small>
                    </div>
                    {% if series_temp|length %}{{ g.herramientas('dashboard') }}{% endif %}
                </div>
                <div class="p-2 p-md-3">
                    {% if series_temp|length %}
                        <div class="spui-tel-lienzo" data-dash-chart="temperatura" data-spui-refresh-conservar
                             role="img" aria-label="Gráfico de temperatura de las últimas 24 horas"></div>
                    {% else %}
                        <p class="text-muted text-center py-5 mb-0">Todavía no hay telemetría de las últimas 24 h.</p>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>

    {# ── Reproductores ── #}
    <section aria-labelledby="dash-repro-titulo">
        <div class="d-flex justify-content-between align-items-baseline gap-2 mb-3">
            <h2 id="dash-repro-titulo" class="spui-dash-h2 spui-dash-h2-seccion">Detalle por reproductor</h2>
            <small class="text-muted text-nowrap">{{ texto.plural(total, 'registrado', 'registrados') }}</small>
        </div>
        <div class="row g-3">
            {% for r in reproductores %}
                {# default(null): un reproductor recién registrado todavía no reportó nada #}
                {% set tel = telemetria[r.id]|default(null) %}
                {# Estado CALCULADO, no la columna estado_conexion: así el panel dice la
                   verdad aunque spui:mantenimiento no haya corrido todavía. #}
                {% set est = r.estadoCalculado(spui_umbral_conexion) %}
                <div class="col-12 col-md-6 col-xxl-4">
                    <article class="unraf-card h-100 spui-dash-repro is-{{ est.value }}" id="repro-{{ r.id }}">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <h3 class="spui-dash-repro-nombre">{{ r.hostname }}</h3>
                                <div class="small text-muted text-truncate">
                                    {% for p in r.pantallas %}{{ p.nombre }} · {{ p.ubicacion.edificio.nombre }}{% if p.ubicacion.sector %} — {{ p.ubicacion.sector }}{% endif %}{% if not loop.last %}; {% endif %}{% else %}Sin pantallas{% endfor %}
                                </div>
                            </div>
                            <span class="spui-dash-estado is-{{ est.value }}"><span class="spui-dash-punto"></span>{{ est.etiqueta }}</span>
                        </div>

                        <div class="small text-muted mt-2">
                            {% if r.ultimoHeartbeat %}
                                {# El texto relativo lo mantiene al día tiempo-relativo.js; los
                                   umbrales replican los suyos para que no salte al primer tick. #}
                                {% set seg = "now"|date("U") - r.ultimoHeartbeat|date("U") %}
                                Última señal <span data-spui-desde="{{ r.ultimoHeartbeat|date('c') }}" class="{{ seg > spui_umbral_conexion ? 'is-stale' : '' }}">
                                    {%- if seg < 90 -%}hace instantes
                                    {%- elseif seg < 3600 -%}hace {{ (seg / 60)|round }} min
                                    {%- elseif seg < 86400 -%}hace {{ (seg / 3600)|round }} h
                                    {%- else -%}hace {{ (seg / 86400)|round }} días
                                    {%- endif -%}
                                </span>
                                · {{ r.ultimoHeartbeat|date('d/m H:i') }}
                            {% else %}
                                Nunca se conectó
                            {% endif %}
                            {% if r.versionFirmware %} · versión {{ r.versionFirmware|split(' ')|first }}{% endif %}
                        </div>

                        {% if tel %}
                            {% set temp = tel.temperaturaSocCelsius %}
                            {% set ram = tel.usoRamPorcentaje %}
                            {% set disco_uso = r.discoTotalMb ? (r.discoTotalMb - tel.espacioDiscoLibreMb) / r.discoTotalMb * 100 : null %}
                            <div class="spui-dash-metricas">
                                <div class="spui-dash-metrica">
                                    <span>Temperatura</span>
                                    <strong class="{{ temp >= temp_umbral ? 'text-danger' : (temp >= temp_umbral * 0.85 ? 'text-warning' : '') }}">{{ temp|number_format(1, ',') }} °C</strong>
                                    <div class="spui-dash-barra"><div data-spui-sync="style" style="width:{{ min(100, temp) }}%;background:{{ temp >= temp_umbral ? '#FF223D' : (temp >= temp_umbral * 0.85 ? '#C77F0A' : '#4A9930') }}"></div></div>
                                </div>
                                <div class="spui-dash-metrica">
                                    <span>RAM</span>
                                    <strong>{{ ram|number_format(1, ',') }} %</strong>
                                    <div class="spui-dash-barra"><div data-spui-sync="style" style="width:{{ min(100, ram) }}%;background:{{ ram >= 90 ? '#FF223D' : (ram >= 75 ? '#C77F0A' : '#3387EF') }}"></div></div>
                                </div>
                                <div class="spui-dash-metrica">
                                    {% if disco_uso is not null %}
                                        <span>Disco</span>
                                        <strong>{{ disco_uso|number_format(0) }} % <small class="text-muted fw-normal">en uso</small></strong>
                                        <div class="spui-dash-barra"><div data-spui-sync="style" style="width:{{ min(100, disco_uso) }}%;background:{{ disco_uso >= 90 ? '#FF223D' : (disco_uso >= 75 ? '#C77F0A' : '#7A5AF8') }}"></div></div>
                                    {% else %}
                                        <span>Disco libre</span>
                                        <strong>{{ (tel.espacioDiscoLibreMb / 1024)|number_format(1, ',') }} GB</strong>
                                        <div class="spui-dash-barra"></div>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <p class="small text-muted mt-3 mb-0">Todavía no envió telemetría.</p>
                        {% endif %}

                        <div class="spui-dash-repro-pie">
                            <a href="{{ path('spui_cms_reproductores_telemetria', {id: r.id}) }}" class="unraf-btn unraf-btn-sm spui-btn-telemetria">Ver telemetría →</a>
                        </div>
                    </article>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="unraf-card p-4 text-center text-muted">No hay reproductores registrados.</div>
                </div>
            {% endfor %}
        </div>
    </section>

    {# Datos de los gráficos y del globo de la dona. #}
    {% set lista = reproductores|map(r => {
        hostname: r.hostname,
        estado: r.estadoCalculado(spui_umbral_conexion).value,
        pantallas: r.pantallas|map(p => p.nombre ~ ' · ' ~ p.ubicacion.edificio.nombre)|join('; '),
        desde: r.ultimoHeartbeat ? r.ultimoHeartbeat|date('c') : null,
        url: path('spui_cms_reproductores_telemetria', {id: r.id})
    }) %}
    <script type="application/json" data-dash-datos>{{ {
        estado: {conectado: conteo.conectado, desconectado: conteo.desconectado, sin_registrar: conteo.sin_registrar, total: total},
        colores: COLORES_ESTADO,
        reproductores: lista,
        temperatura: series_temp,
        umbral: temp_umbral
    }|json_encode|raw }}</script>
</div>
