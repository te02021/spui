{% extends '@SPUI/base.html.twig' %}
{% block title %}Dashboard — SPUI{% endblock %}
{% block descripcion %}Estado en tiempo real de la red de pantallas digitales de la UNRaf: reproductores conectados, temperatura, contenidos, programación y alertas.{% endblock %}
{% block main_class %}{% endblock %}

{% block body %}

{# El contenido dinámico vive en _contenido.html.twig y se refresca solo cada
   20 s (auto-refresh.js). Antes el botón Actualizar reemplazaba únicamente
   #dashboard-stats y #dashboard-table, así que el banner de alerta activa, el
   aviso de sobrecalentamiento y el de reproductores con problemas quedaban
   congelados hasta recargar la página a mano — y son justo los que hay que ver
   en el momento.

   El controlador devuelve sólo este fragmento cuando la petición trae
   X-Requested-With, en vez de la página entera con sidebar, footer y modales. #}
<div id="dashboard-zona" data-spui-refresh>
{{ include('@SPUI/dashboard/_contenido.html.twig') }}
</div>

{% endblock %}

{% block javascripts %}
    {# ECharts copiado en assets (no CDN): el mismo que usa Telemetría. #}
    <script src="{{ asset('spui/vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('spui/js/core/graficos-tiempo.js') }}"></script>
    <script src="{{ asset('spui/js/dashboard/dashboard.js') }}"></script>
    {# Conectado/desconectado al instante: el CMS avisa por MQTT cada vez que un
       reproductor cambia de estado y la zona se vuelve a pedir en el acto, sin
       esperar el ciclo de 20 s. #}
    {{ include('@SPUI/_partials/conexion_vivo.html.twig') }}
{% endblock %}
