{% extends '@SPUI/base.html.twig' %}
{% block title %}Dashboard — SPUI{% endblock %}
{% block main_class %}{% endblock %}

{% block body %}

{# ── Alerta activa banner ── #}
{% if alertas_activas|length > 0 %}
    {% for alerta in alertas_activas %}
    <div class="spui-alerta-activa-banner">
        <img src="{{ asset('unraf-ui/icons/warning.svg') }}" style="width:1.1rem;filter:invert(1)" alt="">
        <span>ALERTA ACTIVA: <strong>{{ alerta.titulo }}</strong>{% if alerta.expiraEn %} — Expira: {{ alerta.expiraEn|date('d/m/Y H:i') }}{% endif %}</span>
        <button type="button" class="unraf-btn unraf-btn-light ms-auto"
                data-confirm-url="{{ path('spui_cms_alertas_desactivar', {id: alerta.id}) }}"
                data-confirm-title="Desactivar alerta"
                data-confirm-message="¿Desactivar la alerta «{{ alerta.titulo }}»? Se notificará a todas las pantallas."
                data-confirm-variant="success"
                style="font-size:.85rem;padding:.3rem .75rem">
            Desactivar
        </button>
    </div>
    {% endfor %}
{% endif %}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Dashboard</h1>
        <button type="button" id="btnActualizarDashboard"
                class="unraf-btn unraf-btn-light d-flex align-items-center gap-1"
                style="font-size:.8rem;padding:.3rem .6rem"
                title="Actualizar datos">
            <img src="{{ asset('unraf-ui/icons/arrows-clockwise.svg') }}" style="width:.85rem;height:.85rem;flex-shrink:0" alt=""> Actualizar
        </button>
    </div>
    <p class="text-muted mb-4">Resumen del estado de la red de pantallas digitales.</p>

    {# ── Stats ── #}
    <div id="dashboard-stats" class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="unraf-card text-center p-3">
                <div class="spui-stat-number" style="color:var(--unraf-azul)">{{ reproductores|length }}</div>
                <div class="spui-stat-label">Total reproductores</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card text-center p-3">
                <div class="spui-stat-number" style="color:var(--unraf-success,#4A9930)">{{ conteo.conectado }}</div>
                <div class="spui-stat-label">Conectados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card text-center p-3">
                <div class="spui-stat-number" style="color:var(--unraf-error,#FF223D)">{{ conteo.desconectado }}</div>
                <div class="spui-stat-label">Desconectados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="unraf-card text-center p-3">
                <div class="spui-stat-number" style="color:var(--unraf-amarillo,#FEAA20)">{{ sin_actividad }}</div>
                <div class="spui-stat-label">Sin actividad (5 min)</div>
            </div>
        </div>
    </div>

    {# ── Tabla de reproductores ── #}
    <div id="dashboard-table" class="unraf-card">
        <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
            <strong>Estado de reproductores</strong>
            <small class="text-muted">{{ reproductores|length }} reproductor(es) registrado(s)</small>
        </div>
        <div class="unraf-table-responsive">
            <table class="unraf-table unraf-table-striped w-100 text-nowrap">
                <thead>
                    <tr>
                        <th class="p-3">Hostname</th>
                        <th class="p-3">Pantallas</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3">Último heartbeat</th>
                        <th class="p-3">Temp.</th>
                        <th class="p-3">RAM</th>
                        <th class="p-3">Disco libre</th>
                    </tr>
                </thead>
                <tbody>
                {% for r in reproductores %}
                    {% set tel = telemetria[r.id] %}
                    <tr>
                        <td class="p-3">
                            <strong>{{ r.hostname }}</strong>
                            {% if r.versionFirmware %}<br><small class="text-muted">{{ r.versionFirmware }}</small>{% endif %}
                        </td>
                        <td class="p-3">
                            {% if r.pantallas|length > 0 %}
                                {% for p in r.pantallas %}
                                    <span class="spui-badge-borrador">{{ p.nombre }}</span>
                                    <small class="text-muted d-block" style="font-size:.7rem">
                                        {{ p.ubicacion.edificio.nombre }}{% if p.ubicacion.sector %} — {{ p.ubicacion.sector }}{% endif %}
                                    </small>
                                {% endfor %}
                            {% else %}
                                <span class="text-muted small">Sin pantallas</span>
                            {% endif %}
                        </td>
                        <td class="p-3">
                            <span class="spui-badge-{{ r.estadoConexion.value }}">{{ r.estadoConexion.value|replace({'_': ' '})|title }}</span>
                        </td>
                        <td class="p-3">
                            {% if r.ultimoHeartbeat %}
                                {{ r.ultimoHeartbeat|date('d/m H:i:s') }}
                                {% set diff = (date() - r.ultimoHeartbeat)|abs %}
                                {% if diff > 300 %}<br><small class="text-danger">Hace más de 5 min</small>{% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="p-3">
                            {% if tel %}
                                {% set temp = tel.temperaturaSocCelsius %}
                                <span class="{{ temp >= 70 ? 'text-danger fw-bold' : (temp >= 60 ? 'text-warning fw-semibold' : '') }}">{{ temp|number_format(1) }}°C</span>
                            {% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                        <td class="p-3">
                            {% if tel %}{{ tel.usoRamPorcentaje|number_format(1) }}%{% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                        <td class="p-3">
                            {% if tel %}{{ (tel.espacioDiscoLibreMb / 1024)|number_format(1) }} GB{% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="p-4 text-center text-muted">
                            No hay reproductores registrados.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
(function () {
    var btn = document.getElementById('btnActualizarDashboard');
    if (!btn) return;

    btn.addEventListener('click', function () {
        var icon    = btn.querySelector('img');
        var statsEl = document.getElementById('dashboard-stats');
        var tableEl = document.getElementById('dashboard-table');

        btn.disabled = true;
        if (icon)    icon.style.animation = 'spin .8s linear infinite';
        if (statsEl) statsEl.style.opacity = '.4';
        if (tableEl) tableEl.style.opacity = '.4';

        fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                ['dashboard-stats', 'dashboard-table'].forEach(function (id) {
                    var src  = doc.getElementById(id);
                    var dest = document.getElementById(id);
                    if (src && dest) dest.innerHTML = src.innerHTML;
                });
            })
            .catch(function () {})
            .finally(function () {
                btn.disabled = false;
                if (icon) icon.style.animation = '';
                var s = document.getElementById('dashboard-stats');
                var t = document.getElementById('dashboard-table');
                if (s) s.style.opacity = '';
                if (t) t.style.opacity = '';
            });
    });
}());
</script>
{% endblock %}
