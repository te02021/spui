{% extends '@SPUI/base.html.twig' %}
{% block title %}Editar nodo — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0" style="color:var(--unraf-azul);font-family:var(--unraf-font-principal)">Editar: {{ nodo.hostname }}</h1>
    <a href="{{ path('spui_cms_nodos_index') }}" class="unraf-btn spui-btn-back flex-shrink-0">← Volver</a>
</div>

<div class="row justify-content-center">
<div class="col-lg-8">

    <div class="unraf-card p-4 mb-4">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.pantalla) }}
            {{ form_widget(form.pantalla) }}
            {% for error in form.pantalla.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.hostname) }}
            {{ form_widget(form.hostname) }}
            {% for error in form.hostname.vars.errors %}
                <p class="text-danger small mt-1">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mb-4">
            {{ form_label(form.versionFirmware) }}
            {{ form_widget(form.versionFirmware) }}
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <button type="button" class="unraf-btn unraf-btn-danger"
                    data-confirm-url="{{ path('spui_cms_nodos_eliminar', {id: nodo.id}) }}"
                    data-confirm-title="Eliminar nodo"
                    data-confirm-message="¿Eliminar «{{ nodo.hostname }}»? El Pi dejará de poder comunicarse con el sistema."
                    data-confirm-variant="danger">Eliminar</button>
            <div class="d-flex gap-2">
                <a href="{{ path('spui_cms_nodos_index') }}" class="unraf-btn spui-btn-back">Cancelar</a>
                <button type="submit" class="unraf-btn unraf-btn-institucion">Guardar cambios</button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <div class="unraf-card p-4">
        <h5 class="mb-1" style="color:var(--unraf-azul)">Regenerar API key</h5>
        <p class="text-muted small mb-3">La clave actual quedará inválida inmediatamente. Actualizá el Pi después.</p>
        <button type="button" class="unraf-btn spui-btn-confirm-warning"
                data-confirm-url="{{ path('spui_cms_nodos_regenerar_clave', {id: nodo.id}) }}"
                data-confirm-title="Regenerar clave API"
                data-confirm-message="¿Regenerar la API key de «{{ nodo.hostname }}»? La clave anterior quedará inválida de inmediato."
                data-confirm-variant="warning">
            <img src="{{ asset('unraf-ui/icons/key.svg') }}" style="width:1rem;height:1rem" alt=""> Regenerar clave
        </button>
    </div>

</div>
</div>
{% endblock %}
