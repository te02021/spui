{% extends '@SPUI/base.html.twig' %}
{% block title %}Nodos — SPUI{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Nodos</h1>
        <p class="text-muted mb-0">Raspberry Pi registradas en el sistema. Cada nodo controla una pantalla.</p>
    </div>
    <a href="{{ path('spui_cms_nodos_nuevo') }}" class="unraf-btn unraf-btn-institucion flex-shrink-0">+ Nuevo nodo</a>
</div>

<div class="unraf-card">
    <div class="unraf-table-responsive">
        <table class="unraf-table unraf-table-striped w-100 text-nowrap">
            <thead>
                <tr>
                    <th class="p-3">Hostname</th>
                    <th class="p-3">Pantalla</th>
                    <th class="p-3">Ubicación</th>
                    <th class="p-3">Firmware</th>
                    <th class="p-3">Estado</th>
                    <th class="p-3">Último heartbeat</th>
                    <th class="p-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for nodo in nodos %}
                <tr>
                    <td class="p-3"><strong>{{ nodo.hostname }}</strong></td>
                    <td class="p-3">{{ nodo.pantalla.nombre }}</td>
                    <td class="p-3">
                        {{ nodo.pantalla.ubicacion.edificio }}
                        {% if nodo.pantalla.ubicacion.aula %}<br><small class="text-muted">{{ nodo.pantalla.ubicacion.aula }}</small>{% endif %}
                    </td>
                    <td class="p-3"><small class="text-muted">{{ nodo.versionFirmware ?? '—' }}</small></td>
                    <td class="p-3">
                        <span class="spui-badge-{{ nodo.estadoConexion.value }}">
                            {{ nodo.estadoConexion.value|replace({'_': ' '})|title }}
                        </span>
                    </td>
                    <td class="p-3">
                        {% if nodo.ultimoHeartbeat %}
                            {{ nodo.ultimoHeartbeat|date('d/m/Y H:i:s') }}
                            {% set diff = (date() - nodo.ultimoHeartbeat)|abs %}
                            {% if diff > 300 %}<br><small class="text-danger">Hace más de 5 min</small>{% endif %}
                        {% else %}
                            <span class="text-muted">Nunca</span>
                        {% endif %}
                    </td>
                    <td class="p-3">
                        <div class="d-flex gap-1">
                            <a href="{{ path('spui_cms_nodos_editar', {id: nodo.id}) }}"
                               class="unraf-btn unraf-btn-light unraf-btn-sm" title="Editar">
                                <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt="Editar">
                            </a>
                            <button type="button" class="unraf-btn unraf-btn-sm spui-btn-confirm-warning"
                                    data-confirm-url="{{ path('spui_cms_nodos_regenerar_clave', {id: nodo.id}) }}"
                                    data-confirm-title="Regenerar clave API"
                                    data-confirm-message="¿Regenerar la API key de «{{ nodo.hostname }}»? La clave anterior quedará inválida de inmediato."
                                    data-confirm-variant="warning"
                                    title="Regenerar API key">
                                <img src="{{ asset('unraf-ui/icons/key.svg') }}" class="spui-action-icon" alt=""> Clave
                            </button>
                            <button type="button" class="unraf-btn-icon btn-delete"
                                    data-confirm-url="{{ path('spui_cms_nodos_eliminar', {id: nodo.id}) }}"
                                    data-confirm-title="Eliminar nodo"
                                    data-confirm-message="¿Eliminar «{{ nodo.hostname }}»? El Pi dejará de poder comunicarse con el sistema."
                                    data-confirm-variant="danger" title="Eliminar">
                                <img src="{{ asset('unraf-ui/icons/trash.svg') }}" alt="Eliminar">
                            </button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="p-4 text-center text-muted">
                        No hay nodos registrados.
                        (necesitás tener al menos una <a href="{{ path('spui_cms_pantallas_nueva') }}">pantalla</a>).
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
