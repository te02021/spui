{% extends '@SPUI/base.html.twig' %}
{% import '@SPUI/_macros/bloqueo.html.twig' as bloqueo %}
{% block title %}Programación — SPUI{% endblock %}
{% block descripcion %}Reglas que asignan playlists a las pantallas digitales de la UNRaf por horario, días y destino.{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2 spui-header-actions">
    <div>
        <h1 style="color:var(--unraf-azul);font-family:var(--unraf-font-principal);margin:0">Programación</h1>
        <p class="text-muted mb-0">Asignación de playlists a pantallas, sectores, edificios o todo el campus — con horarios y días específicos.</p>
    </div>
    <button type="button" class="unraf-btn spui-btn-crear flex-shrink-0"
            data-spui-form="{{ path('spui_cms_programacion_nueva_form') }}"
            data-spui-title="Nueva regla de programación"
            data-spui-size="modal-lg">
        + Nueva regla
    </button>
</div>

{# Tarjetas (30/10/2026). Los días ya no son siete insignias en la fila (con
   todos marcados la estiraban a lo alto): un chip con el resumen ("Lun a
   vie", "Todos los días"…) que al tocarlo muestra la semana. La zona interna
   se vuelve a pedir cuando llega un aviso de conexión por MQTT
   (conexion-vivo.js): destraba o traba los botones si un reproductor vuelve
   o se cae. #}
{% set NOMBRES = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}
{% set CORTOS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'] %}
{% set MASCARAS = [1, 2, 4, 8, 16, 32, 64] %}
<div id="spui-table-body">
<div class="spui-lista mt-4" id="spui-tabla-conexion" data-spui-refresh="push">
{% for prog in programaciones %}
    {# Una regla puede apuntar a una pantalla, ubicación, edificio o ser
       global: el servicio resuelve los cuatro casos. #}
    {% set motivo = spui_alcance.motivoParaEntidad(prog, ids_offline|default({})) %}
    {% set activos = (0..6)|filter(i => (prog.diasSemana // MASCARAS[i]) is odd) %}
    {% set resumen = prog.diasSemana == 127 ? 'Todos los días'
                   : (prog.diasSemana == 31 ? 'Lun a vie'
                   : (prog.diasSemana == 96 ? 'Fin de semana'
                   : (activos|length == 0 ? 'Ningún día' : activos|map(i => CORTOS[i])|join(', ')))) %}
    {% set destino = prog.pantalla ? prog.pantalla.nombre
                   : (prog.ubicacion ? prog.ubicacion.edificio.nombre ~ (prog.ubicacion.sector ? ' — ' ~ prog.ubicacion.sector : '')
                   : (prog.edificio ? prog.edificio.nombre : 'Todas las pantallas')) %}
    <article class="unraf-card spui-item {{ prog.activo ? 'is-ok' : 'is-apagado' }}">
        <div class="spui-item-cuerpo">
            <div class="spui-item-cab">
                <span class="spui-etiqueta {{ prog.activo ? 'is-ok' : '' }}">{{ prog.activo ? 'Activa' : 'Inactiva' }}</span>
                <h2 class="spui-item-titulo">{{ prog.playlist.nombre }}</h2>
            </div>
            <div class="spui-chips">
                <span class="spui-chip" title="Destino"><img src="{{ asset('unraf-ui/icons/' ~ (prog.pantalla ? 'monitor.svg' : (prog.ubicacion ? 'map-pin.svg' : (prog.edificio ? 'buildings.svg' : 'globe.svg')))) }}" alt=""> {{ destino }}</span>
                <span class="spui-chip"><img src="{{ asset('unraf-ui/icons/clock.svg') }}" alt=""> {{ prog.horaInicio|date('H:i') }} – {{ prog.horaFin|date('H:i') }}</span>
                {% if prog.repetirSemanal %}
                    <span class="spui-desp">
                        <button type="button" class="spui-chip spui-chip-btn" data-spui-desp
                                aria-expanded="false" aria-controls="regla-{{ prog.id }}-dias"
                                aria-label="Días: {{ resumen }}. Ver la semana">
                            <img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" alt=""> {{ resumen }}
                        </button>
                        <div id="regla-{{ prog.id }}-dias" class="spui-desp-panel" role="region" aria-label="Días de la regla">
                            <p class="spui-desp-titulo">Se repite cada semana</p>
                            <ul class="spui-semana">
                                {% for i in 0..6 %}
                                    <li class="{{ i in activos ? 'is-si' : 'is-no' }}" title="{{ NOMBRES[i] }}: {{ i in activos ? 'sí' : 'no' }}">
                                        <span>{{ CORTOS[i] }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </span>
                {% else %}
                    <span class="spui-chip"><img src="{{ asset('unraf-ui/icons/calendar-dots.svg') }}" alt="">
                        Única vez{% if prog.fechaInicio %}: {{ prog.fechaInicio|date('d/m/Y') }}{% if prog.fechaFin and prog.fechaFin|date('Ymd') != prog.fechaInicio|date('Ymd') %} al {{ prog.fechaFin|date('d/m/Y') }}{% endif %}{% endif %}
                    </span>
                {% endif %}
                <span class="spui-chip" title="Entre reglas que coinciden, gana la de mayor prioridad"><img src="{{ asset('unraf-ui/icons/sort-descending.svg') }}" alt=""> Prioridad {{ prog.prioridad }}</span>
            </div>
        </div>
        <div class="spui-acciones spui-item-acciones">
            <button type="button" class="unraf-btn spui-btn-ver unraf-btn-sm"
                    data-spui-form="{{ path('spui_cms_programacion_ver', {id: prog.id}) }}"
                    data-spui-title="Regla de programación"
                    title="Ver detalle">
                <img src="{{ asset('unraf-ui/icons/eye.svg') }}" class="spui-action-icon" alt=""> Ver
            </button>
            <button type="button" class="unraf-btn spui-btn-editar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                    data-spui-form="{{ path('spui_cms_programacion_editar', {id: prog.id}) }}"
                    data-spui-title="Editar regla"
                    data-spui-size="modal-lg"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Editar"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/pencil.svg') }}" class="spui-action-icon" alt=""> Editar
            </button>
            <button type="button"
                    class="unraf-btn unraf-btn-sm {{ prog.activo ? 'spui-btn-desactivar' : 'spui-btn-activar' }} {{ bloqueo.clase(motivo) }}"
                    data-spui-action="{{ path('spui_cms_programacion_toggle', {id: prog.id}) }}"
                    data-spui-title="{{ prog.activo ? 'Desactivar regla' : 'Activar regla' }}"
                    data-spui-message="{{ prog.activo ? '¿Desactivar esta regla de programación?' : '¿Activar esta regla de programación?' }}"
                    data-spui-variant="{{ prog.activo ? 'desactivar' : 'activar' }}"
                    data-spui-confirm-label="{{ prog.activo ? 'Desactivar' : 'Activar' }}"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="{{ prog.activo ? 'Desactivar' : 'Activar' }}"{% endif %}>
                <img src="{{ asset(prog.activo ? 'unraf-ui/icons/pause.svg' : 'unraf-ui/icons/play.svg') }}"
                     class="spui-action-icon" alt="">
                {{ prog.activo ? 'Desactivar' : 'Activar' }}
            </button>
            <button type="button" class="unraf-btn spui-btn-eliminar unraf-btn-sm {{ bloqueo.clase(motivo) }}"
                    data-spui-action="{{ path('spui_cms_programacion_eliminar', {id: prog.id}) }}"
                    data-spui-title="Eliminar regla"
                    data-spui-message="¿Eliminar esta regla de programación? Esta acción no se puede deshacer."
                    data-spui-variant="eliminar"
                    {% if motivo %}{{ bloqueo.attrs(motivo) }}{% else %}title="Eliminar"{% endif %}>
                <img src="{{ asset('unraf-ui/icons/trash.svg') }}" class="spui-action-icon" alt=""> Eliminar
            </button>
        </div>
    </article>
{% else %}
    <div class="unraf-card p-4 text-center text-muted">No hay reglas de programación.</div>
{% endfor %}
</div>
{{ include('@SPUI/_partials/paginacion.html.twig', {pag: paginacion, que: 'reglas'}) }}
</div>
{% endblock %}

{# Destraba/traba los botones cuando un reproductor vuelve o se cae, sin recargar. #}
{% block javascripts %}
    {{ include('@SPUI/_partials/conexion_vivo.html.twig') }}
{% endblock %}
