{# Detalle de una regla de programación. El título del modal es su playlist. #}
{% set diasNombres      = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'] %}
{% set diasNombresLargo = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}
{% set diasMasks        = [1, 2, 4, 8, 16, 32, 64] %}
<div class="spui-ver">
    <section class="spui-ver-seccion" aria-labelledby="spui-ver-detalles">
        <h5 class="spui-ver-titulo" id="spui-ver-detalles">Detalles</h5>
        <dl class="spui-ver-datos spui-ver-bloque">
            <div><dt>Estado</dt><dd><span class="{{ prog.activo ? 'spui-badge-publicado' : 'spui-badge-archivado' }}">{{ prog.activo ? 'Activa' : 'Inactiva' }}</span></dd></div>
            <div><dt>Prioridad</dt><dd>{{ prog.prioridad }}</dd></div>
            <div class="spui-ver-dato-largo"><dt>Creada</dt><dd>{{ prog.creadoEn|date('d/m/Y H:i') }}</dd></div>
            <div class="spui-ver-dato-largo"><dt>Creada por</dt><dd>{{ creado_por_email|default('Usuario #' ~ prog.creadoPorId) }}</dd></div>
        </dl>
    </section>

    <section class="spui-ver-seccion" aria-labelledby="spui-ver-cuando">
        <h5 class="spui-ver-titulo" id="spui-ver-cuando">Dónde y cuándo</h5>
        <div class="spui-ver-bloque">
            <dl class="spui-ver-datos spui-ver-datos-solos">
                <div><dt>Horario</dt><dd>{{ prog.horaInicio ? prog.horaInicio|date('H:i') : '—' }} a {{ prog.horaFin ? prog.horaFin|date('H:i') : '—' }}</dd></div>
                <div><dt>Repetición</dt><dd>{{ prog.repetirSemanal ? 'Semanal' : 'Una sola vez' }}</dd></div>
                <div class="spui-ver-dato-largo">
                    <dt>Alcance</dt>
                    <dd>
                        {% if prog.pantalla %}
                            {{ prog.pantalla.nombre }}
                        {% elseif prog.ubicacion %}
                            {{ prog.ubicacion.edificio.nombre }}{% if prog.ubicacion.sector %} · {{ prog.ubicacion.sector }}{% endif %}
                        {% elseif prog.edificio %}
                            {{ prog.edificio.nombre }}
                        {% else %}
                            Todas las pantallas
                        {% endif %}
                    </dd>
                </div>
                <div class="spui-ver-dato-largo">
                    <dt>Vigencia</dt>
                    <dd>{{ prog.fechaInicio ? 'Desde el ' ~ prog.fechaInicio|date('d/m/Y') : 'Desde siempre' }}{{ prog.fechaFin ? ' hasta el ' ~ prog.fechaFin|date('d/m/Y') : ', sin vencimiento' }}</dd>
                </div>
            </dl>
            <ul class="spui-ver-dias" aria-label="Días de la semana">
                {% for i in 0..6 %}
                    {% set activo = (prog.diasSemana // diasMasks[i]) is odd %}
                    <li class="{{ activo ? 'is-activo' }}" title="{{ diasNombresLargo[i] }}{{ activo ? ': sí' : ': no' }}">{{ diasNombres[i] }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
</div>
