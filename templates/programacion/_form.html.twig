{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate'}}) }}

<div class="mb-3">
    {{ form_label(form.playlist) }}
    {{ form_widget(form.playlist) }}
    {% for e in form.playlist.vars.errors %}
        <p class="text-danger small mt-1">{{ e.message }}</p>
    {% endfor %}
</div>

<p class="unraf-form-label mb-1" style="font-weight:600">Destino <small class="text-muted fw-normal">(elegí uno o ninguno para global)</small></p>

<div class="mb-2">
    {{ form_label(form.pantalla) }}
    {{ form_widget(form.pantalla) }}
</div>

<div class="mb-2">
    {{ form_label(form.ubicacion) }}
    {{ form_widget(form.ubicacion) }}
</div>

<div class="mb-3">
    {{ form_label(form.edificio) }}
    {{ form_widget(form.edificio) }}
    <small class="text-muted d-block mt-1">Pantalla &gt; Ubicación &gt; Edificio &gt; Global (en orden de prioridad de destino).</small>
</div>

<div class="row g-2 mb-3">
    <div class="col-sm-6">
        {{ form_label(form.horaInicio) }}
        {{ form_widget(form.horaInicio) }}
    </div>
    <div class="col-sm-6">
        {{ form_label(form.horaFin) }}
        {{ form_widget(form.horaFin) }}
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-sm-6">
        {{ form_label(form.fechaInicio) }}
        {{ form_widget(form.fechaInicio) }}
    </div>
    <div class="col-sm-6">
        {{ form_label(form.fechaFin) }}
        {{ form_widget(form.fechaFin) }}
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.diasSemana) }}
    <div class="d-flex gap-3 flex-wrap mt-1">
        {% for child in form.diasSemana %}
            <div class="form-check form-check-inline m-0">
                {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(child, null, {'label_attr': {'class': 'form-check-label small'}}) }}
            </div>
        {% endfor %}
    </div>
</div>

<div class="mb-3 form-check">
    {{ form_widget(form.repetirSemanal, {'attr': {'class': 'form-check-input'}}) }}
    {{ form_label(form.repetirSemanal, null, {'label_attr': {'class': 'form-check-label'}}) }}
</div>

<div class="mb-3">
    {{ form_label(form.prioridad) }}
    {{ form_widget(form.prioridad) }}
    <small class="text-muted d-block mt-1">Mayor número = mayor prioridad.</small>
</div>

<div class="mb-4 form-check">
    {{ form_widget(form.activo, {'attr': {'class': 'form-check-input'}}) }}
    {{ form_label(form.activo, null, {'label_attr': {'class': 'form-check-label'}}) }}
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn unraf-btn-institucion">{{ submit_label ?? 'Crear regla' }}</button>
</div>

{{ form_end(form) }}
