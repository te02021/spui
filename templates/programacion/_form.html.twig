{# Alta y edición de una regla de programación (rediseñado el 05/11/2026): tres
   secciones con el mismo estilo que los modales Ver. Formulario de muestra del
   estilo .spui-form.

   Dónde: un solo selector de alcance y sólo la lista que corresponde
   (core/alcance-campo.js). ProgramacionType valida que esté elegida y limpia las
   otras dos al guardar: antes eran tres listas sueltas y se podían completar varias. #}
{{ form_start(form, {'attr': {'data-spui-ajax': '1', 'novalidate': 'novalidate', 'class': 'spui-form'}}) }}

{# Errores del form raíz (típicamente el CSRF vencido). Sin esto el modal se
   recargaba sin ningún mensaje y el guardado parecía no responder. #}
{% for e in form.vars.errors %}
    <div class="alert alert-danger mb-0">{{ e.message }}</div>
{% endfor %}

{% import '@SPUI/_macros/form.html.twig' as campos %}

<section class="spui-ver-seccion" aria-labelledby="spui-form-que">
    <h5 class="spui-ver-titulo" id="spui-form-que">¿Qué se muestra?</h5>
    <div class="spui-ver-bloque spui-form-fila spui-form-fila-principal">
        <div>
            {{ form_label(form.playlist) }}
            {{ form_widget(form.playlist) }}
            {% for e in form.playlist.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
        </div>
        <div>
            {{ form_label(form.prioridad) }}
            {{ form_widget(form.prioridad) }}
            {% for e in form.prioridad.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
            <small class="spui-form-ayuda">A mayor número, más prioridad.</small>
        </div>
        <div>{{ campos.estado(form.activo, 'Activa', 'Inactiva') }}</div>
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-donde">
    <h5 class="spui-ver-titulo" id="spui-form-donde">¿Dónde?</h5>
    <div class="spui-ver-bloque spui-form-alcance" data-spui-alcance>
        <div>
            <span class="unraf-form-label d-block" id="spui-form-alcance-lbl">Pantallas</span>
            <div class="spui-opciones" role="radiogroup" aria-labelledby="spui-form-alcance-lbl">
                {% for op in form.alcance %}
                    <input type="radio" class="spui-opcion-input" name="{{ op.vars.full_name }}" id="{{ op.vars.id }}"
                           value="{{ op.vars.value }}" {{ op.vars.checked ? 'checked' }}>
                    <label class="spui-opcion" for="{{ op.vars.id }}">{{ op.vars.label }}</label>
                {% endfor %}
                {% do form.alcance.setRendered() %}
            </div>
        </div>
        {# Del mismo alto que una lista: cambiar de opción no mueve lo de abajo. #}
        <div data-spui-si-alcance="todas" hidden>
            <span class="unraf-form-label d-block">Destino</span>
            <div class="unraf-form-control spui-form-fijo">Todas las pantallas activas</div>
        </div>
        {% for destino in [form.edificio, form.ubicacion, form.pantalla] %}
            <div data-spui-si-alcance="{{ destino.vars.name }}" hidden>
                {{ form_label(destino) }}
                {{ form_widget(destino, {'attr': {'required': 'required'}}) }}
                {% for e in destino.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
            </div>
        {% endfor %}
    </div>
</section>

<section class="spui-ver-seccion" aria-labelledby="spui-form-cuando">
    <h5 class="spui-ver-titulo" id="spui-form-cuando">¿Cuándo?</h5>
    <div class="spui-ver-bloque">
        <div class="spui-form-fila spui-form-fila-4">
            {% for campo in [form.horaInicio, form.horaFin, form.fechaInicio, form.fechaFin] %}
                <div class="spui-fecha-field">
                    {{ form_label(campo) }}
                    {{ form_widget(campo) }}
                    {% for e in campo.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="spui-form-separado" data-spui-campo>
            <span class="unraf-form-label d-block">{{ form.diasSemana.vars.label }}</span>
            {# Checkboxes reales, con la etiqueta como botón: los mismos colores que el modal Ver. #}
            <div class="spui-form-dias{{ form.diasSemana.vars.errors|length ? ' is-invalid' }}"
                 data-spui-requiere-alguno="{{ constant('SPUI\\Form\\ProgramacionType::MSG_DIAS_REQUERIDOS') }}">
                {% for dia in form.diasSemana %}
                    <div>
                        <input type="checkbox" class="spui-opcion-input" name="{{ dia.vars.full_name }}" id="{{ dia.vars.id }}"
                               value="{{ dia.vars.value }}" {{ dia.vars.checked ? 'checked' }}>
                        <label class="spui-form-dia" for="{{ dia.vars.id }}">{{ dia.vars.label }}</label>
                    </div>
                {% endfor %}
                {% do form.diasSemana.setRendered() %}
            </div>
            {% for e in form.diasSemana.vars.errors %}<p class="spui-campo-error">{{ e.message }}</p>{% endfor %}
        </div>
    </div>
</section>

<div class="spui-form-pie d-flex">
    <button type="button" class="unraf-btn spui-btn-back" data-spui-close>Cancelar</button>
    <button type="submit" class="unraf-btn {{ submit_label is defined ? 'spui-btn-editar' : 'spui-btn-crear' }}">Guardar</button>
</div>

{{ form_end(form) }}
