{# Un TV de 1920 × 1080 achicado al ancho disponible (noviembre 2026): cómo se
   va a ver un contenido en pantalla, con su plantilla y su tema.

   Lo arma PantallaTvService::vista() (tv) y lo achica y anima
   core/vista-tv.js: escala, ajuste del texto y el cambio de página del
   cronograma, deslizándose hacia la izquierda.

   Variables: tv; media_url (imagen, video o la imagen del QR, si ya hay una);
   leyenda (opcional, una línea debajo del TV). #}
{% set cr = tv.cronograma|default(null) %}
{% set paginas = cr ? cr.paginas|length : 0 %}

{% macro contenido(tv, media_url) %}
    {% set cr = tv.cronograma|default(null) %}
    {% if tv.tipo == 'texto' %}
        <div class="tv-texto" data-spui-tv-ajustar><p>{{ tv.texto ?: 'Escribí el texto a mostrar.' }}</p></div>

    {% elseif tv.tipo in ['imagen', 'video'] %}
        {% if media_url %}
            {% if tv.tipo == 'video' %}
                <video class="tv-media" src="{{ media_url }}" muted autoplay loop playsinline data-spui-tv-media></video>
            {% else %}
                <img class="tv-media" src="{{ media_url }}" alt="" data-spui-tv-media>
            {% endif %}
        {% else %}
            <div class="tv-sin-archivo" data-spui-tv-media-falta>{{ tv.tipo == 'video' ? 'Elegí el video' : 'Elegí la imagen' }}</div>
        {% endif %}

    {% elseif tv.tipo == 'qr' %}
        <div class="tv-qrbox">
            <div class="tv-qr-txt">
                <span class="tv-kicker">Escaneá con tu celular</span>
                <p data-spui-tv-ajustar>{{ tv.titulo ?: 'Título del contenido' }}</p>
            </div>
            <div class="tv-qr-marco">
                {% if media_url %}
                    <img src="{{ media_url }}" alt="">
                {% else %}
                    <div class="tv-qr-pendiente">El código se genera al guardar</div>
                {% endif %}
            </div>
        </div>

    {% elseif cr %}
        <div class="tv-crono-tit">
            <div><small>Cronograma de hoy</small><h1>{{ cr.edificio ?: tv.titulo }}</h1></div>
            {% if cr.total %}
                <div class="tv-crono-ref">
                    <span class="tv-ref tv-ref-curso">En curso</span>
                    <span class="tv-ref tv-ref-evento">Evento especial</span>
                    <span class="tv-crono-cuenta">{{ cr.total }} {{ cr.total == 1 ? 'actividad' : 'actividades' }} por delante</span>
                </div>
            {% endif %}
        </div>
        {% if cr.total %}
            <div class="tv-fila tv-tcab"><span>Horario</span><span>Materia · Docente</span><span>Carrera · Año</span><span>Aula</span></div>
            <div class="tv-vista">
                {% for pagina in cr.paginas %}
                    <div class="tv-pagina" data-spui-tv-pagina {{ not loop.first ? 'hidden' }}>
                        {% for f in pagina %}
                            <div class="tv-fila{{ f.curso ? ' is-curso' }}{{ f.evento ? ' is-evento' }}">
                                <div class="tv-c-hora">{{ f.inicio }}<i>–</i>{{ f.fin }}</div>
                                <div class="tv-c-mat">
                                    <div class="tv-mat">{{ f.nombre }}{% if f.evento %}<span class="tv-et">Evento especial</span>{% endif %}</div>
                                    {% if f.docente %}<div class="tv-doc">{{ f.docente }}</div>{% endif %}
                                </div>
                                <div class="tv-c-car">{{ f.meta }}</div>
                                <div class="tv-c-aula">{{ f.aula }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="tv-crono-vacio">{{ cr.vacio }}</div>
        {% endif %}
    {% endif %}
{% endmacro %}

<div class="spui-tv-escala" data-spui-tv {% if paginas > 1 %}data-spui-tv-segundos="{{ cr.segundos }}"{% endif %}>
    <div class="spui-tv spui-tv--{{ tv.tema }} spui-tv--{{ tv.plantilla }} spui-tv--{{ tv.tipo }}">
        {% if tv.plantilla == 'institucional' %}
            <header class="tv-cab">
                <img class="tv-logo" src="{{ asset('spui/img/tv/unraf.png') }}" alt="UNRaf">
                <span class="tv-dia">{{ tv.fecha }}</span>
            </header>
            <div class="tv-franja"><i></i><i></i><i></i></div>
            <div class="tv-cuerpo">{{ _self.contenido(tv, media_url|default(null)) }}</div>
            <footer class="tv-pie">
                <span><b>SPUI</b> · Sistema de Pantallas UNRaf</span>
                {% if paginas > 1 %}
                    <span class="tv-avance" aria-hidden="true">
                        {% for i in 1..paginas %}<i class="{{ loop.first ? 'on' }}"></i>{% endfor %}
                        <em data-spui-tv-numero>1 / {{ paginas }}</em>
                    </span>
                {% endif %}
                <span>{{ tv.lugar ?: 'Lugar de la pantalla' }}</span>
            </footer>
        {% else %}
            <div class="tv-completa">{{ _self.contenido(tv, media_url|default(null)) }}</div>
            {% if tv.marca_agua %}<img class="tv-agua" src="{{ asset('spui/img/tv/unraf-molino.png') }}" alt="">{% endif %}
        {% endif %}
    </div>
</div>
